<script defer>
const DEBUG = true;

// DÃ©fini ICI, localement, plutÃ´t que dans functions.js : cette page charge
// functions.js de faÃ§on dynamique/asynchrone, donc rien ne garantissait que
// functions.js ait fini de s'exÃ©cuter avant que ce script n'en ait besoin
// (d'oÃ¹ les erreurs "API_BASE_URL is not defined" malgrÃ© le correctif dans
// functions.js). En le dÃ©finissant directement ici, comme le fait dÃ©jÃ 
// bible.html, on Ã©limine complÃ¨tement ce problÃ¨me d'ordre de chargement.
const API_BASE_URL = 'https://apokalypsy.com';
const DAILY_POLL_API_URL = `${API_BASE_URL}/api/poll/today`;
const BIBLE_QUIZ_API_URL = `${API_BASE_URL}/api/quiz/today`;



let currentUsername = null;
let loyaltyData = null;
let bonusTimer = null;

// RÃ©cupÃ©ration de l'utilisateur aprÃ¨s connexion Google
const urlParams = new URLSearchParams(window.location.search);
const googleUsername = urlParams.get('user');

if (googleUsername) {
    currentUsername = googleUsername;
    localStorage.setItem('user_name', googleUsername);
}

// DÃ©claration unique des variables globales des notifications
if (typeof notificationCount === 'undefined') {
    var notificationCount = 0;
}
if (typeof loadedNotificationsArray === 'undefined') {
    var loadedNotificationsArray = [];
}

// ==========================================
// Persistance des notifications (faÃ§on Facebook)
// ==========================================
// Le flux temps rÃ©el (SSE, plus bas) ne dÃ©livre les Ã©vÃ©nements qu'aux
// utilisateurs connectÃ©s AU MOMENT PRÃ‰CIS oÃ¹ ils se produisent â€” il ne
// peut donc jamais, Ã  lui seul, montrer une notification Ã  quelqu'un qui
// Ã©tait hors ligne quand elle a Ã©tÃ© crÃ©Ã©e. La vraie source de vÃ©ritÃ© est
// donc le serveur : au chargement de la page, on RÃ‰CUPÃˆRE les
// notifications non lues via une requÃªte (fetchNotificationsFromServer),
// puis le flux SSE prend le relais pour le temps rÃ©el pendant que la page
// reste ouverte. Le localStorage sert uniquement de cache d'appoint si le
// rÃ©seau est momentanÃ©ment indisponible.
const NOTIF_STORAGE_MAX = 50;

function getNotifStorageKey() {
    return currentUsername ? `notif_history_${currentUsername}` : null;
}

function loadNotificationsFromStorage() {
    const key = getNotifStorageKey();
    if (!key) return;
    try {
        const stored = localStorage.getItem(key);
        if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed)) {
                loadedNotificationsArray = parsed;
                notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
            }
        }
    } catch (e) {
        console.warn("Impossible de lire l'historique des notifications sauvegardÃ© :", e);
    }
}

function saveNotificationsToStorage() {
    const key = getNotifStorageKey();
    if (!key) return;
    try {
        localStorage.setItem(key, JSON.stringify(loadedNotificationsArray.slice(0, NOTIF_STORAGE_MAX)));
    } catch (e) {
        console.warn("Impossible de sauvegarder l'historique des notifications :", e);
    }
}

/**
 * RÃ©cupÃ¨re depuis le serveur les notifications rÃ©elles de l'utilisateur
 * (lues + non lues, les plus rÃ©centes), avec leur vÃ©ritable Ã©tat "lu"
 * mÃ©morisÃ© cÃ´tÃ© serveur â€” donc valable mÃªme s'il Ã©tait dÃ©connectÃ© quand
 * elles ont Ã©tÃ© crÃ©Ã©es. NÃ©cessite un endpoint backend GET /api/notifications/list
 * (voir le code PHP fourni sÃ©parÃ©ment). Tant qu'il n'existe pas encore
 * cÃ´tÃ© serveur (404) ou est injoignable, on se rabat silencieusement sur
 * le cache local pour que l'interface reste utilisable.
 */
async function fetchNotificationsFromServer() {
    if (!currentUsername) return;
			try {
				const response = await fetch(
			`${API_BASE_URL}/api/notifications/list?username=${encodeURIComponent(currentUsername)}`,
			{
				headers: {
					'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
				}
			}
		);
        if (!response.ok) throw new Error(`Statut HTTP ${response.status}`);
        const data = await response.json();
        if (!Array.isArray(data.notifications)) throw new Error("Format de rÃ©ponse invalide (champ 'notifications' manquant)");

        loadedNotificationsArray = data.notifications.map(n => ({
            id: n.id,
            realId: n.id,
            type: n.type || 'article',
            title: n.title || '',
            message: n.message || '',
            link: n.link || null,
            unread: !n.read,
            date: n.createdAt || new Date().toISOString()
        }));
        notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
        saveNotificationsToStorage(); // On garde aussi une copie locale en secours
    } catch (e) {
        console.warn("Notifications : endpoint serveur indisponible, utilisation du cache local en attendant.", e);
        loadNotificationsFromStorage();
    }
    renderNotificationBadge();
    renderVerticalDropdownMenu();
}

/**
 * PrÃ©vient le serveur qu'une notification a Ã©tÃ© lue, pour que l'Ã©tat "lu"
 * soit valable sur tous les appareils/sessions de ce compte â€” pas juste
 * dans ce navigateur. NÃ©cessite POST /api/notifications/{id}/read cÃ´tÃ©
 * backend. Si l'appel Ã©choue, l'Ã©tat reste marquÃ© localement quand mÃªme
 * (l'utilisateur ne revoit pas la notif dans CETTE session), mais sans
 * garantie de synchronisation tant que le backend n'est pas en place.
 */
async function markNotificationReadOnServer(realId) {
    if (!currentUsername || !realId) return;

    try {
        const response = await fetch(
            `${API_BASE_URL}/api/notifications/${realId}/read?username=${encodeURIComponent(currentUsername)}`,
            {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
                }
            }
        );

        if (!response.ok) {
            console.warn(
                `Erreur serveur lors du marquage de la notification ${realId} : HTTP ${response.status}`
            );
            return;
        }

        const data = await response.json();
        console.log('Notification marquÃ©e comme lue :', data);

    } catch (e) {
        console.warn(
            `Impossible de synchroniser la lecture de la notification ${realId} avec le serveur :`,
            e
        );
    }
}

async function markAllNotificationsReadOnServer() {
    if (!currentUsername) return;
    try {
        await fetch(
			`${API_BASE_URL}/api/notifications/read-all?username=${encodeURIComponent(currentUsername)}`,
			{
				method: 'POST',
				headers: {
					'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
				}
			}
		);
    } catch (e) {
        console.warn("Impossible de synchroniser le marquage global comme lu avec le serveur :", e);
    }
}

