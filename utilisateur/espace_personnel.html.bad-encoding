    const name = currentUsername || 'InvitÃ©';
    setText('profileModalName', name);
    setText('profileModalPoints', `${userPoints.total.toFixed(2)} points de fidÃ©litÃ©`);
    setText('profileModalChapters', `${userPoints.bibleChapters} chapitres lus`);

    const level = calculateLevel(userPoints.total);
    setText('profileModalLevel', currentUsername ? `Niveau ${level}` : 'Connectez-vous pour voir votre progression');

    const avatarEl = document.getElementById('profileModalAvatar');
    const headerAvatar = document.getElementById('profile-avatar-initials');
    if (avatarEl && headerAvatar) avatarEl.innerText = headerAvatar.innerText;

    modal.classList.add('show');
}

function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.classList.remove('show');

    if (id === 'videoModal') {
        clearInterval(ytPollInterval);
        if (ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
            try { ytPlayer.pauseVideo(); } catch (e) { /* lecteur pas encore prÃªt */ }
        }
    } else if (id === 'aiChatModal') {
        // Optionnel : RÃ©initialiser le chat ou dÃ©charger des ressources
    }
}

function closeModalOnOverlay(event, id) {
    if (event.target && event.target.id === id) closeModal(id);
}

document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
        closeModal('searchModal');
        closeModal('profileModal');
        closeModal('logoutConfirmModal');
        closeModal('aiChatModal'); // Ferme la modale du chat IA
        const dropdown = document.getElementById('notifDropdown');
        if (dropdown) {
            dropdown.classList.remove('show');
            const trigger = document.getElementById('notif-btn');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
    }
});

/**
 * GÃ©nÃ¨re et affiche les initiales de l'utilisateur dans l'avatar du header.
 * Si l'utilisateur n'est pas connectÃ©, affiche des points d'interrogation.
 */
function renderProfileAvatar(username) {
    const avatarElement = document.getElementById('profile-avatar-initials');
    if (!avatarElement) return;

    if (username && username !== 'InvitÃ©') {
        const parts = username.trim().split(" ");
        let initials = "??";
        if (parts.length > 1) {
            initials = (parts[0][0] + parts[1][0]).toUpperCase();
        } else if (username.length >= 2) {
            initials = username.substring(0, 2).toUpperCase();
        } else if (username.length === 1) {
            initials = username.toUpperCase();
        }
        avatarElement.innerText = initials;
    } else {
        avatarElement.innerText = "??"; // Mode invitÃ©
    }
}


