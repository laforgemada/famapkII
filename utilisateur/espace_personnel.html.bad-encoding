/**
 * Ajoute un message au conteneur du chat.
 * @param {string} sender 'user' ou 'ai'
 * @param {string} message Le contenu du message.
 */
function displayMessage(sender, message) {
    const chatMessages = document.getElementById('chatMessages');
    if (!chatMessages) return;

    const messageElement = document.createElement('div');
    if (sender === 'user') {
        messageElement.className = 'user-message';
        messageElement.innerText = message;
    } else {
        messageElement.className = 'ai-message';
        messageElement.innerHTML = `
            <div class="ai-message-icon"><i data-feather="feather"></i></div>
            <div class="ai-message-content">${message}</div>
        `;
    }
    chatMessages.appendChild(messageElement);
    feather.replace(); // Pour les nouvelles icÃ´nes dans les messages IA
    scrollToBottom('chatMessages');
}

/**
 * Fait dÃ©filer le conteneur du chat jusqu'en bas.
 * @param {string} containerId L'ID du conteneur Ã  faire dÃ©filer.
 */
function scrollToBottom(containerId) {
    const container = document.getElementById(containerId);
    if (container) {
        container.scrollTop = container.scrollHeight;
    }
}

/**
 * Envoie un message Ã  l'IA et affiche sa rÃ©ponse via l'API Symfony.
 */
async function sendMessageToAI() {
    const input = document.getElementById('aiChatInput');
    const userText = input.value.trim();

    if (userText === '') return;

    displayMessage('user', userText);
    input.value = '';

    // Indicateur de "l'IA Ã©crit..."
    const loadingMessageId = 'ai-typing-indicator';
    const loadingMessageElement = document.createElement('div');

    loadingMessageElement.id = loadingMessageId;
    loadingMessageElement.className = 'ai-message';

    loadingMessageElement.innerHTML = `
        <div class="ai-message-icon">
            <i data-feather="feather"></i>
        </div>
        <div class="ai-message-content">
            L'IA analyse votre parcours...
        </div>
    `;

    document.getElementById('chatMessages').appendChild(loadingMessageElement);

    feather.replace();
    scrollToBottom('chatMessages');

    try {

        const response = await fetch(`${API_BASE_URL}/api/coach/advice`, {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + localStorage.getItem('token'),
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                message: userText
            })
        });

        /*
         * IMPORTANT :
         * On lit le body UNE SEULE FOIS.
         */
        const rawText = await response.text();

        let data = null;

        try {
            data = JSON.parse(rawText);
        } catch (jsonError) {

            console.error(
                "RÃ©ponse brute du serveur :",
                rawText
            );

            throw new Error(
                "Le serveur n'a pas renvoyÃ© de JSON valide."
            );
        }

        // Supprime l'indicateur de chargement
        const chatMessages = document.getElementById('chatMessages');
        const existingLoading =
            chatMessages.querySelector(`#${loadingMessageId}`);

        if (existingLoading) {
            existingLoading.remove();
        }

        let aiResponse =
            "Je n'ai pas pu rÃ©cupÃ©rer votre conseil pour le moment.";

        if (response.ok && data.success) {

            aiResponse =
                data.advice ||
                "Aucun conseil n'a Ã©tÃ© gÃ©nÃ©rÃ©.";

        } else if (data.error) {

            aiResponse = data.error;

        } else if (!response.ok) {

            aiResponse =
                `Erreur du serveur (${response.status}).`;
        }

        displayMessage('ai', aiResponse);
        scrollToBottom('chatMessages');

    } catch (error) {

        console.error(
            "Erreur de connexion avec l'API du coach :",
            error
        );

        // Nettoyage de l'indicateur
        const chatMessages =
            document.getElementById('chatMessages');

        const existingLoading =
            chatMessages.querySelector(`#${loadingMessageId}`);

        if (existingLoading) {
            existingLoading.remove();
        }

        let displayError;

        if (error.message.includes("JSON valide")) {
            displayError = error.message;
        } else {
            displayError =
                "Erreur de connexion avec le serveur. Veuillez rÃ©essayer plus tard.";
        }

        displayMessage('ai', displayError);
        scrollToBottom('chatMessages');
    }
}

/**
 * Fonction pour obtenir la prochaine classe de couleur d'icÃ´ne d'activitÃ©
 */
function getNextActivityIconColorClass() {
    const colorClass = activityIconColors[activityColorIndex];
    activityColorIndex = (activityColorIndex + 1) % activityIconColors.length;
    return colorClass;
}

/**
 * Observe les Ã©lÃ©ments d'activitÃ© pour appliquer une animation quand ils entrent dans la vue.
 */
function observeActivityElements() {
    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // Cesse d'observer une fois l'animation appliquÃ©e
            }
        });
    }, { threshold: 0.1 }); // Se dÃ©clenche quand 10% de l'Ã©lÃ©ment est visible

    document.querySelectorAll('#activity-display-area .activity-item').forEach(item => {
        observer.observe(item);
    });
}

/**
 * Formatte une date pour l'affichage et le regroupement, ex: "aujourd'hui", "hier", ou "15 juillet 2024"
 * @param {string | Date} dateInput
 * @returns {string} Date formatÃ©e
 */
function formatDateForDisplay(dateInput) {
    const date = new Date(dateInput);
    date.setHours(0, 0, 0, 0); // Normaliser Ã  minuit pour comparaison

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const yesterday = new Date(today);
    yesterday.setDate(today.getDate() - 1);

    const diff = today.getTime() - date.getTime();
    const oneDay = 24 * 60 * 60 * 1000;

    if (diff < oneDay && date.getTime() === today.getTime()) {
        return "Aujourd'hui";
    } else if (diff < (2 * oneDay) && date.getTime() === yesterday.getTime()) {
        return "Hier";
    } else {
        return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    }
}

/**
 * Met Ã  jour le petit indicateur de connexion temps rÃ©el affichÃ© sur la cloche
 * de notifications (vert = connectÃ©, orange pulsant = reconnexion en cours).
 */
function updateSseStatus(state) {
    const dot = document.getElementById('sseStatus');
    if (!dot) return;
    dot.classList.remove('connected', 'reconnecting');
    if (state === 'connected') {
        dot.classList.add('connected');
        dot.title = 'ConnectÃ© en direct';
    } else {
        dot.classList.add('reconnecting');
        dot.title = 'Reconnexion en cours...';
    }
}

/**
 * ==========================================
 * NOTIFICATIONS EN TEMPS RÃ‰EL (SSE)
 * ==========================================
 */
function initRealtimeNotifications() {
    console.log("DÃ©marrage du flux SSE sur :", `${API_BASE_URL}/api/notifications/stream`);
    
    const eventSource = new EventSource(`${API_BASE_URL}/api/notifications/stream?username=${encodeURIComponent(currentUsername)}`);
    let wasConnected = false;

    eventSource.onopen = function() {
        updateSseStatus('connected');
        if (!wasConnected) {
            wasConnected = true;
        } else {
            showToast("Connexion en direct rÃ©tablie.", "success", 2500);
        }
    };

    eventSource.onmessage = function(event) {
        if (!event.data || event.data.trim() === "" || event.data.includes("ping")) {
            return; 
        }

        try {
            const data = JSON.parse(event.data);
            console.log("Flux SSE reÃ§u avec succÃ¨s :", data);

            if (!data || !data.message) return;

            if (typeof loadedNotificationsArray !== 'undefined') {
                const dejavu = loadedNotificationsArray.some(n => n.realId === data.id);
                if (dejavu) return; 
            }

            let iconType = 'article'; 
            let iconName = 'book-open';
            let directLink = '/famapkII/index.html';

            if (
                data.type === 'app_update' ||
                data.message.toLowerCase().includes('application') ||
                data.message.toLowerCase().includes('apk')
            ) {
                // Nouvelle version de l'application : ouvrira une popup (tÃ©lÃ©chargement + QR code)
                // au clic, au lieu de naviguer vers un lien classique.
                iconType = 'app_update';
                iconName = 'smartphone';
                directLink = '#';
                if (data.url) currentAppUpdateUrl = data.url;
            } else if (data.type === 'new_badge' || data.message.includes('badge') || data.message.includes('TrophÃ©e')) {
                iconType = 'badge';
                iconName = 'award';
                directLink = '#';
            } else if (data.type === 'chat' || data.message.includes('Chat') || data.message.includes('message')) {
                iconType = 'chat';
                iconName = 'message-square';
                directLink = '../../chat.html';
            }

            loadedNotificationsArray.unshift({
                id: Date.now(), 
                realId: data.id, 
                type: iconType,
                icon: iconName,
                message: data.message,
                time: 'Ã€ l\'instant',
                unread: true,
                link: directLink,
                apkUrl: iconType === 'app_update' ? (data.url || currentAppUpdateUrl || null) : null
            });

            notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
            saveNotificationsToStorage();
            renderNotificationBadge();
            renderVerticalDropdownMenu();

            const activityList = document.getElementById('activity-display-area');
            if (activityList) {
                const newItem = document.createElement('div');
                newItem.className = `activity-item is-visible`; // Ajoute is-visible pour l'animation
                newItem.style.border = '2px solid var(--secondary)';
                newItem.innerHTML = `
                    <div class="activity-icon ${getNextActivityIconColorClass()}">
                        <i data-feather="${iconName}"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title" style="color:var(--secondary);">Nouveau !</div>
                        <div class="activity-text">${data.message}</div>
                    </div>
                `;
                activityList.insertBefore(newItem, activityList.firstChild);
                feather.replace();
            }

            if (window.Notification && Notification.permission === "granted") {
                new Notification("Apokalypsy", { body: data.message });
            }

        } catch (error) {
            console.error("Erreur lors de l'analyse JSON du flux SSE :", error);
        }
    };

    eventSource.onerror = function(err) {
        console.log("Le tuyau SSE s'est dÃ©connectÃ© ou cherche Ã  joindre le serveur. En attente...");
        updateSseStatus('reconnecting');
    };

    // Ã‰tat initial : en cours de connexion
    updateSseStatus('reconnecting');

    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('notifDropdown');
        const trigger = document.getElementById('notif-btn');
        if (dropdown && !dropdown.contains(event.target) && !trigger.contains(event.target)) {
            dropdown.classList.remove('show');
        }
    });
}

function toggleNotifMenu(event) {
    event.stopPropagation();
    const dropdown = document.getElementById('notifDropdown');
    const trigger = document.getElementById('notif-btn');
    if (dropdown) {
        const isOpen = dropdown.classList.toggle('show');
        if (trigger) trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
}

function renderNotificationBadge() {
    const badge = document.getElementById('notif-badge');
    if (!badge) return;

    if (notificationCount > 0) {
        badge.innerText = notificationCount;
        badge.style.display = 'flex';
        badge.classList.add('pulse-animation');
        setTimeout(() => badge.classList.remove('pulse-animation'), 500);
    } else {
        badge.innerText = '0';
        badge.style.display = 'none';
    }
}

function renderVerticalDropdownMenu() {
    const container = document.getElementById('notifVerticalList');
    if (!container) return;

    if (loadedNotificationsArray.length === 0) {
        container.innerHTML = `
            <div style="padding: 24px 20px; text-align: center; color: var(--muted); font-size: 0.82rem;">
                <div class="notif-empty-icon"><i data-feather="bell-off"></i></div>
                Aucune nouvelle notification reÃ§ue.
            </div>
        `;
        feather.replace();
        return;
    }

    container.innerHTML = loadedNotificationsArray.map(notif => {
        const isAppUpdate = notif.type === 'app_update';
        // Pour une mise Ã  jour d'app : pas de navigation, on ouvre la popup
        // (tÃ©lÃ©chargement + QR code) avec le lien embarquÃ© dans la notif.
        const href = isAppUpdate ? 'javascript:void(0)' : notif.link;
        const safeUrl = isAppUpdate && notif.apkUrl ? `'${notif.apkUrl.replace(/'/g, "\\'")}'` : 'null';
        const clickHandler = isAppUpdate
            ? `markOneAsRead(${notif.id}); openAppUpdateModal(${safeUrl})`
            : `markOneAsRead(${notif.id})`;

        return `
        <a href="${href}" class="notif-item ${notif.unread ? 'unread' : ''}" onclick="${clickHandler}">
            <div class="notif-item-icon ${notif.type}">
                <i data-feather="${notif.icon}"></i>
            </div>
            <div class="notif-details">
                <span class="notif-message">${notif.message}</span>
                <span class="notif-time">${notif.time}</span>
            </div>
        </a>
    `;
    }).join('');

    feather.replace();
}

function markOneAsRead(id) {
    const notif = loadedNotificationsArray.find(n => n.id === id);
    if (notif && notif.unread) {
        notif.unread = false;
        if (notificationCount > 0) notificationCount--;
        saveNotificationsToStorage();
        renderNotificationBadge();
        renderVerticalDropdownMenu();
        markNotificationReadOnServer(notif.realId || notif.id);
    }
}

function markAllAsRead(event) {
    event.stopPropagation();
    loadedNotificationsArray.forEach(n => n.unread = false);
    notificationCount = 0;
    saveNotificationsToStorage();
    renderNotificationBadge();
    renderVerticalDropdownMenu();
    markAllNotificationsReadOnServer();
}

if (window.Notification && Notification.permission !== "denied" && Notification.permission !== "granted") {
    Notification.requestPermission();
}

function requestEspaceLogout(){
    // Nom volontairement unique (pas "logout") : functions.js, chargÃ© sur
    // cette mÃªme page, dÃ©clare AUSSI une fonction globale "logout()" (pour
    // la page d'accueil, avec sa propre logique liÃ©e au sÃ©lecteur de
    // langue). En JavaScript, deux fonctions globales du mÃªme nom se
    // Ã©crasent l'une l'autre â€” celle chargÃ©e en dernier gagne. C'est ce qui
    // provoquait le crash "Cannot read properties of null (reading 'value')" :
    // la fonction logout() de functions.js s'exÃ©cutait Ã  la place de la
    // nÃ´tre. On utilise donc un nom garanti unique sur cette page.
    const modal = document.getElementById('logoutConfirmModal');
    if (modal) {
        modal.classList.add('show');
    } else {
        // Filet de sÃ©curitÃ© si jamais la modale n'existe pas sur une page.
        performEspaceLogout();
    }
}

function performEspaceLogout(){
    localStorage.removeItem('user_name');
    localStorage.removeItem('user_role');
    localStorage.removeItem('token');

    // DÃ©tection automatique du chemin de base pour GitHub Pages ou Localhost
    const isGitHubPages = window.location.hostname.includes("github.io");
    const basePath = isGitHubPages ? "/famapkII" : "";

    window.location.href = basePath + "/index.html";
}

/* =========================
   GAINS DE POINTS SUPPLÃ‰MENTAIRES (Cointiply-like)
========================= */

async function awardPoints(points, reason) {
    if (!currentUsername) {
        showToast("Veuillez vous connecter pour gagner des points.", "error");
        return false;
    }
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${API_BASE_URL}/api/points/add`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
                username: currentUsername,
                points: points,
                reason: reason
            })
        });

        const result = await response.json();
        if (result.success) {
            userPoints.total = parseFloat(userPoints.total) + points; // Mise Ã  jour locale immÃ©diate
            renderUserStats();
            showToast(`ðŸŽ‰ Vous avez gagnÃ© ${points} points !`, "success");
            return true;
        } else {
            showToast(`Erreur : ${result.message}`, "error");
            return false;
        }
    } catch (error) {
        console.error("Erreur lors de l'attribution des points :", error);
        showToast("Impossible de se connecter au serveur de points.", "error");
        return false;
    }
}

/**
 * ==========================================
 * SYSTÃˆME D'ACTIVITÃ‰S QUOTIDIENNES Ã€ POINTS
 * (Sondage, Quiz biblique, VidÃ©o bonus, Partage)
 * ==========================================
 */
const VIDEO_WATCH_TARGET_SECONDS = 60; // DurÃ©e de visionnage requise pour gagner le bonus
const VIDEO_BONUS_POINTS = 3;          // Points accordÃ©s une fois la vidÃ©o regardÃ©e ~1 minute

function getDateKey(d = new Date()) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

function getDayOfYear(d = new Date()) {
    const start = new Date(d.getFullYear(), 0, 0);
    return Math.floor((d - start) / 86400000);
}

function earnKey(action) {
    return `earn_${action}_${currentUsername || 'guest'}_${getDateKey()}`;
}

function isActionDoneToday(action) {
    return getCache(earnKey(action)) === true;
}

function markActionDoneToday(action) {
    setCache(earnKey(action), true);
}

// Questions par dÃ©faut en cas d'Ã©chec de l'API
const defaultPolls = [
    { question: "Quel moment de la journÃ©e prÃ©fÃ¨res-tu pour lire la Bible ?", options: ["Le matin", "Le midi", "Le soir", "La nuit"] },
    { question: "Qu'est-ce qui nourrit le plus ta foi au quotidien ?", options: ["La priÃ¨re", "La lecture biblique", "La communautÃ©", "La mÃ©ditation"] },
    { question: "Quel fruit de l'Esprit aimerais-tu voir grandir en toi cette semaine ?", options: ["La patience", "La paix", "La joie", "L'amour"] }
];

const defaultQuizzes = [
    { question: "Combien JÃ©sus avait-il de disciples proches ?", options: ["7", "12", "10", "3"], correct: 1 },
    { question: "Qui a construit l'arche pour survivre au dÃ©luge ?", options: ["Abraham", "MoÃ¯se", "NoÃ©", "David"], correct: 2 },
    { question: "Dans quel livre trouve-t-on les Dix Commandements ?", options: ["GenÃ¨se", "Exode", "LÃ©vitique", "Nombres"], correct: 1 }
];

/* ---------- SONDAGE QUOTIDIEN DYNAMIQUE ---------- */
let currentPoll = null; // Stocke le sondage actuel

async function startDailyPoll() {
    if (!currentUsername) { showToast("Veuillez vous connecter pour participer.", "error"); return; }
    if (isActionDoneToday('poll')) { showToast("Vous avez dÃ©jÃ  rÃ©pondu au sondage aujourd'hui. Revenez demain !", "info"); return; }

    try {
        const response = await fetch(DAILY_POLL_API_URL); // Utilisation de l'API
        const data = await response.json();
        if (data.success && data.poll) {
            currentPoll = data.poll;
        } else {
            console.warn("API de sondage non disponible, utilisation des questions par dÃ©faut.");
            currentPoll = defaultPolls[Math.floor(Math.random() * defaultPolls.length)]; // Question alÃ©atoire par dÃ©faut
        }
    } catch (error) {
        console.error("Erreur lors de la rÃ©cupÃ©ration du sondage quotidien :", error);
        currentPoll = defaultPolls[Math.floor(Math.random() * defaultPolls.length)]; // Question alÃ©atoire par dÃ©faut en cas d'erreur rÃ©seau
    }

    if (!currentPoll) {
        showToast("Impossible de charger le sondage pour le moment.", "error");
        return;
    }

    setText('pollQuestionText', currentPoll.question);

    const list = document.getElementById('pollOptionsList');
    list.innerHTML = currentPoll.options.map((opt, i) => `
        <button class="poll-option-btn" onclick="submitPollAnswer(${i})">${opt}</button>
    `).join('');

    document.getElementById('pollModal').classList.add('show');
}

async function submitPollAnswer(index) {
    const buttons = document.querySelectorAll('#pollOptionsList .poll-option-btn');
    buttons.forEach((btn, i) => {
        btn.disabled = true;
        if (i === index) btn.classList.add('selected');
    });

    const ok = await awardPoints(5, "Sondage quotidien");
    if (ok) {
        markActionDoneToday('poll');
        updateEarnCardsState();
    }
    setTimeout(() => closeModal('pollModal'), 700);
}

/* ---------- QUIZ BIBLIQUE DYNAMIQUE ---------- */
let quizState = { questions: [], step: 0, correctCount: 0 };

async function startBibleQuiz() {
    if (!currentUsername) { showToast("Veuillez vous connecter pour participer.", "error"); return; }
    if (isActionDoneToday('quiz')) { showToast("Vous avez dÃ©jÃ  fait le quiz aujourd'hui. Revenez demain !", "info"); return; }

    try {
        const response = await fetch(BIBLE_QUIZ_API_URL); // Utilisation de l'API
        const data = await response.json();
        if (data.success && Array.isArray(data.quiz) && data.quiz.length > 0) {
            quizState = { questions: data.quiz, step: 0, correctCount: 0 };
        } else {
            console.warn("API de quiz non disponible ou vide, utilisation des questions par dÃ©faut.");
            // SÃ©lectionne 3 questions alÃ©atoires parmi les questions par dÃ©faut
            const pickedDefaults = [];
            const availableIndices = Array.from({ length: defaultQuizzes.length }, (_, i) => i);
            for (let i = 0; i < 3 && availableIndices.length > 0; i++) {
                const randomIndex = Math.floor(Math.random() * availableIndices.length);
                pickedDefaults.push(defaultQuizzes[availableIndices.splice(randomIndex, 1)[0]]);
            }
            quizState = { questions: pickedDefaults, step: 0, correctCount: 0 };
        }
    } catch (error) {
        console.error("Erreur lors de la rÃ©cupÃ©ration du quiz biblique :", error);
        // SÃ©lectionne 3 questions alÃ©atoires parmi les questions par dÃ©faut en cas d'erreur rÃ©seau
        const pickedDefaults = [];
        const availableIndices = Array.from({ length: defaultQuizzes.length }, (_, i) => i);
        for (let i = 0; i < 3 && availableIndices.length > 0; i++) {
            const randomIndex = Math.floor(Math.random() * availableIndices.length);
            pickedDefaults.push(defaultQuizzes[availableIndices.splice(randomIndex, 1)[0]]);
        }
        quizState = { questions: pickedDefaults, step: 0, correctCount: 0 };
    }

    if (quizState.questions.length === 0) {
        showToast("Impossible de charger le quiz pour le moment.", "error");
        return;
    }

    document.getElementById('quizResultBox').style.display = 'none';
    document.getElementById('quizQuestionText').style.display = '';
    document.getElementById('quizOptionsList').style.display = '';
    document.getElementById('quizStepLabel').style.display = '';

    renderQuizStep();
    document.getElementById('quizModal').classList.add('show');
}

function renderQuizStep() {
    const { questions, step } = quizState;
    const q = questions[step];

    setText('quizStepLabel', `Question ${step + 1}/${questions.length}`);
    setText('quizQuestionText', q.question); // 'question' au lieu de 'q'

    const progressFill = document.getElementById('quizProgressFill');
    if (progressFill) progressFill.style.width = `${((step + 1) / questions.length) * 100}%`; // Barre de progression incluant l'Ã©tape actuelle

    const list = document.getElementById('quizOptionsList');
    list.innerHTML = q.options.map((opt, i) => `
        <button class="poll-option-btn" onclick="answerQuizStep(${i})">${opt}</button>
    `).join('');
}

function answerQuizStep(index) {
    const { questions, step } = quizState;
    const q = questions[step];
    const buttons = document.querySelectorAll('#quizOptionsList .poll-option-btn');

    buttons.forEach((btn, i) => {
        btn.disabled = true;
        if (i === q.correct) btn.classList.add('correct');
        else if (i === index) btn.classList.add('wrong');
    });

    if (index === q.correct) quizState.correctCount++;

    setTimeout(() => {
        if (step + 1 < questions.length) {
            quizState.step++;
            renderQuizStep();
        } else {
            finishQuiz();
        }
    }, 800);
}

async function finishQuiz() {
    const { questions, correctCount } = quizState;
    const progressFill = document.getElementById('quizProgressFill');
    if (progressFill) progressFill.style.width = '100%';

    const earned = Math.round((correctCount / questions.length) * 10);

    document.getElementById('quizStepLabel').style.display = 'none';
    document.getElementById('quizQuestionText').style.display = 'none';
    document.getElementById('quizOptionsList').style.display = 'none';

    const resultBox = document.getElementById('quizResultBox');
    resultBox.style.display = 'block';
    resultBox.innerHTML = `
        <span class="quiz-result-emoji">${correctCount === questions.length ? 'ðŸ†' : correctCount > 0 ? 'âœ¨' : 'ðŸ“–'}</span>
        <div class="quiz-result-title">${correctCount}/${questions.length} bonnes rÃ©ponses</div>
        <div class="quiz-result-desc">Tu as gagnÃ© ${earned} points aujourd'hui. Reviens demain pour un nouveau quiz !</div>
        <button class="loyalty-action-btn" style="width:100%;" onclick="closeModal('quizModal')">Fermer</button>
    `;

    if (earned > 0) {
        await awardPoints(earned, "Quiz biblique quotidien");
    } else {
        showToast("Quiz terminÃ©. Retente ta chance demain !", "info");
    }
    markActionDoneToday('quiz');
    updateEarnCardsState();
}

/* ---------- VIDÃ‰O BONUS (vraie vidÃ©o YouTube dÃ©finie par l'admin) ---------- */
let ytPlayer = null;              // Instance du lecteur YouTube IFrame API
let ytPollInterval = null;        // Intervalle qui comptabilise les secondes rÃ©ellement regardÃ©es
let watchedSeconds = 0;           // Secondes de lecture rÃ©elle accumulÃ©es pour la vidÃ©o en cours
let videoRewarded = false;        // EmpÃªche de recevoir 2x les points sur la mÃªme vidÃ©o/jour
let currentVideoId = null;        // ID YouTube de la vidÃ©o actuellement chargÃ©e
let currentVideoUrl = null;       // URL brute renvoyÃ©e par le serveur (cache)

/**
 * Extrait l'identifiant YouTube (11 caractÃ¨res) depuis n'importe quel
 * format d'URL courant : watch?v=, youtu.be/, embed/, shorts/.
 */
function extractYouTubeId(url) {
    if (!url) return null;
    const match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return match ? match[1] : null;
}

/**
 * Charge dynamiquement le script officiel de l'API YouTube IFrame
 * (une seule fois) et rÃ©sout la promesse quand il est prÃªt Ã  l'emploi.
 */
function loadYouTubeAPI() {
    return new Promise((resolve) => {
        if (window.YT && window.YT.Player) { resolve(); return; }
        const existingCallback = window.onYouTubeIframeAPIReady;
        window.onYouTubeIframeAPIReady = () => {
            if (typeof existingCallback === 'function') existingCallback();
            resolve();
        };
        if (!document.getElementById('youtube-iframe-api-script')) {
            const tag = document.createElement('script');
            tag.id = 'youtube-iframe-api-script';
            tag.src = 'https://www.youtube.com/iframe_api';
            document.head.appendChild(tag);
        }
    });
}

/**
 * RÃ©cupÃ¨re l'URL de la vidÃ©o bonus configurÃ©e par l'admin.
 * Essaie d'abord le serveur (source de vÃ©ritÃ©, partagÃ©e entre tous les
 * utilisateurs), puis retombe sur le cache local si le serveur ne rÃ©pond pas.
 */
async function fetchVideoBonusSettings() {
    try {
        const response = await fetch(`${API_BASE_URL}/api/settings/video-bonus`);
        if (response.ok) {
            const data = await response.json();
            if (data && data.url) {
                currentVideoUrl = data.url;
                setCache('video_bonus_url_cache', data.url);
                return currentVideoUrl;
            }
        }
    } catch (e) {
        console.warn("VidÃ©o bonus : serveur injoignable, utilisation du cache local.", e);
    }
    currentVideoUrl = getCache('video_bonus_url_cache');
    return currentVideoUrl;
}

/**
 * MISE Ã€ JOUR DE L'APPLICATION (APK)
 * ==========================================
 * RÃ©cupÃ¨re le lien de tÃ©lÃ©chargement actuellement publiÃ© par l'admin.
 * Sert de repli si une notification SSE arrive sans URL embarquÃ©e.
 */
let currentAppUpdateUrl = null;

async function fetchAppUpdateSettings() {
    try {
        const response = await fetch(`${API_BASE_URL}/api/settings/app-update`);
        if (response.ok) {
            const data = await response.json();
            if (data && data.url) {
                currentAppUpdateUrl = data.url;
                setCache('app_update_url_cache', data.url);
                return currentAppUpdateUrl;
            }
        }
    } catch (e) {
        console.warn("Mise Ã  jour APK : serveur injoignable, utilisation du cache local.", e);
    }
    currentAppUpdateUrl = getCache('app_update_url_cache');
    return currentAppUpdateUrl;
}

/**
 * Ouvre la popup de mise Ã  jour : branche le bouton de tÃ©lÃ©chargement et le
 * QR code sur le lien fourni (celui de la notification, ou Ã  dÃ©faut le
 * dernier lien connu rÃ©cupÃ©rÃ© depuis le serveur).
 */
function openAppUpdateModal(url) {
    const targetUrl = url || currentAppUpdateUrl;
    if (!targetUrl) {
        showToast("Le lien de la nouvelle version n'est pas disponible pour le moment.", "error");
        return;
    }

    const downloadBtn = document.getElementById('appUpdateDownloadBtn');
    const qrImg = document.getElementById('appUpdateQrImg');
    if (downloadBtn) downloadBtn.href = targetUrl;
    if (qrImg) qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(targetUrl)}`;

    const modal = document.getElementById('appUpdateModal');
    if (modal) modal.classList.add('show');
    feather.replace();
}

async function watchVideoAd() {
    if (!currentUsername) { showToast("Veuillez vous connecter pour participer.", "error"); return; }

    const url = currentVideoUrl || await fetchVideoBonusSettings();
    const videoId = extractYouTubeId(url);

    document.getElementById('videoModal').classList.add('show');
    document.getElementById('videoProgressFill').style.width = '0%';

    const unavailableMsg = document.getElementById('videoUnavailableMsg');
    const playerEl = document.getElementById('youtubePlayer');

    if (!videoId) {
        unavailableMsg.style.display = 'flex';
        playerEl.style.display = 'none';
        setText('videoStatusText', "Aucune vidÃ©o bonus n'est disponible pour le moment.");
        return;
    }
    unavailableMsg.style.display = 'none';
    playerEl.style.display = 'block';

    currentVideoId = videoId;
    watchedSeconds = 0;
    videoRewarded = isActionDoneToday('video_' + videoId);

    setText('videoStatusText', videoRewarded
        ? "Vous avez dÃ©jÃ  reÃ§u vos points pour cette vidÃ©o aujourd'hui. Vous pouvez la regarder Ã  nouveau, sans bonus."
        : `Regardez au moins ${VIDEO_WATCH_TARGET_SECONDS} secondes pour gagner ${VIDEO_BONUS_POINTS} points.`);

    await loadYouTubeAPI();

    if (ytPlayer && typeof ytPlayer.loadVideoById === 'function') {
        ytPlayer.loadVideoById(videoId);
    } else {
        ytPlayer = new YT.Player('youtubePlayer', {
            videoId: videoId,
            playerVars: { rel: 0, modestbranding: 1 },
            events: { onStateChange: onYtStateChange }
        });
    }
}

function onYtStateChange(event) {
    clearInterval(ytPollInterval);
    if (event.data === YT.PlayerState.PLAYING) {
        // On ne compte que le temps de lecture rÃ©el : une pause ou un
        // buffering arrÃªte le dÃ©compte, une reprise le relance.
        ytPollInterval = setInterval(trackWatchProgress, 1000);
    }
}

function trackWatchProgress() {
    if (videoRewarded) { clearInterval(ytPollInterval); return; }

    watchedSeconds += 1;
    const pct = Math.min(100, (watchedSeconds / VIDEO_WATCH_TARGET_SECONDS) * 100);
    document.getElementById('videoProgressFill').style.width = `${pct}%`;

    if (watchedSeconds >= VIDEO_WATCH_TARGET_SECONDS) {
        clearInterval(ytPollInterval);
        completeVideoPlayback();
    } else {
        setText('videoStatusText', `${VIDEO_WATCH_TARGET_SECONDS - watchedSeconds}s de lecture restantes pour gagner vos points...`);
    }
}

async function completeVideoPlayback() {
    videoRewarded = true; // Verrouillage optimiste pour Ã©viter un double-clic/double-appel
    const ok = await awardPoints(VIDEO_BONUS_POINTS, "Visionnage vidÃ©o bonus (1 min)");

    if (ok) {
        markActionDoneToday('video_' + currentVideoId);
        setText('videoStatusText', `ðŸŽ‰ Bravo ! Vous avez gagnÃ© ${VIDEO_BONUS_POINTS} points de fidÃ©litÃ©.`);
        updateEarnCardsState();
    } else {
        videoRewarded = false; // L'appel serveur a Ã©chouÃ© : on autorise un nouvel essai
    }
}

/* ---------- PARTAGE ---------- */
function shareApp() {
    if (!currentUsername) { showToast("Veuillez vous connecter pour participer.", "error"); return; }
    if (isActionDoneToday('share')) { showToast("Vous avez dÃ©jÃ  gagnÃ© des points de partage aujourd'hui. Revenez demain !", "info"); return; }

    if (navigator.share) {
        navigator.share({
            title: 'Apokalypsy',
            text: 'DÃ©couvrez Apokalypsy, votre guide spirituel interactif !',
            url: window.location.origin,
        }).then(async () => {
            const ok = await awardPoints(15, "Partage de l'application");
            if (ok) {
                markActionDoneToday('share');
                updateEarnCardsState();
            }
        }).catch((error) => {
            console.error('Erreur de partage:', error);
            showToast("Le partage a Ã©tÃ© annulÃ© ou a Ã©chouÃ©.", "error");
        });
    } else {
        // Fallback pour les navigateurs ne supportant pas Web Share API
        navigator.clipboard?.writeText(window.location.origin).catch(() => {});
        showToast("Partage non supportÃ© : le lien a Ã©tÃ© copiÃ© dans le presse-papiers.", "info");
    }
}

/**
 * Met Ã  jour l'apparence des 4 cartes "Gagner plus de points" (verrouillÃ©e/disponible)
 * et l'objectif quotidien affichÃ© dans le hÃ©ro.
 */
function updateEarnCardsState() {
    if (!currentUsername) return;

    const configs = [
        { action: 'poll', cardId: 'earn-card-poll', bonusId: 'earn-bonus-poll', doneLabel: 'âœ“ Fait', done: isActionDoneToday('poll') },
        { action: 'quiz', cardId: 'earn-card-quiz', bonusId: 'earn-bonus-quiz', doneLabel: 'âœ“ Fait', done: isActionDoneToday('quiz') },
        { action: 'share', cardId: 'earn-card-share', bonusId: 'earn-bonus-share', doneLabel: 'âœ“ Fait', done: isActionDoneToday('share') }
    ];

    let doneCount = 0;
    configs.forEach(cfg => {
        const card = document.getElementById(cfg.cardId);
        const bonus = document.getElementById(cfg.bonusId);
        if (!card || !bonus) return;
        if (cfg.done) {
            card.classList.add('done');
            bonus.innerText = cfg.doneLabel;
            doneCount++;
        } else {
            card.classList.remove('done');
        }
    });

    // Carte vidÃ©o : une vidÃ©o unique dÃ©finie par l'admin, +3 pts aprÃ¨s 1 min regardÃ©e
    const videoCard = document.getElementById('earn-card-video');
    const videoBonus = document.getElementById('earn-bonus-video');
    const videoNote = document.getElementById('earn-note-video');
    if (videoCard && videoBonus && videoNote) {
        const videoId = extractYouTubeId(currentVideoUrl || getCache('video_bonus_url_cache'));
        const videoDoneToday = videoId ? isActionDoneToday('video_' + videoId) : false;

        if (!videoId) {
            videoNote.innerText = "Aucune vidÃ©o disponible pour le moment";
            videoCard.classList.remove('done');
            videoBonus.innerText = '+3 pts';
        } else if (videoDoneToday) {
            videoCard.classList.add('done');
            videoBonus.innerText = 'âœ“ Fait';
            videoNote.innerText = "Revenez demain pour un nouveau bonus";
            doneCount++;
        } else {
            videoCard.classList.remove('done');
            videoBonus.innerText = '+3 pts';
            videoNote.innerText = "Regardez 1 min pour gagner des points";
        }
    }

    // Objectif quotidien affichÃ© dans le hÃ©ro
    const wrap = document.getElementById('dailyGoalWrap');
    const label = document.getElementById('dailyGoalLabel');
    const fill = document.getElementById('dailyGoalFill');
    const totalActions = 4;
    if (wrap && label && fill) {
        wrap.style.display = 'flex';
        label.innerText = `${doneCount}/${totalActions} activitÃ©s aujourd'hui`;
        fill.style.width = `${(doneCount / totalActions) * 100}%`;
        if (doneCount >= totalActions) {
            label.innerText = `ðŸŽ‰ Objectif du jour atteint !`;
        }
    }
}

async function updateLoginStreak() {

    if (!currentUsername) {
        console.warn("âš ï¸ Aucun utilisateur pour calculer le streak.");
        return;
    }

    const token = localStorage.getItem('token');

    try {

        const response = await fetch(
            `${API_BASE_URL}/api/reward/daily-login`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token
                        ? {
                            'Authorization': `Bearer ${token}`
                        }
                        : {})
                },
                body: JSON.stringify({
                    username: currentUsername
                })
            }
        );

        const data = await response.json();

        console.log("ðŸ”¥ Login streak :", data);

        /*
         * MÃªme si l'utilisateur s'est dÃ©jÃ  connectÃ© aujourd'hui,
         * le serveur renvoie quand mÃªme son streak actuel.
         */
        if (
            data.success ||
            data.alreadyLoggedToday
        ) {

            const streak = Number(data.streak || 0);

            /*
             * Badge principal :
             * ðŸ”¥ 1 jour de suite
             * ðŸ”¥ 2 jours de suite
             * ðŸ”¥ 3 jours de suite...
             */
            const streakText =
                document.getElementById('streakText');

            if (streakText) {

                streakText.innerText =
                    streak <= 1
                        ? `${streak} jour de suite`
                        : `${streak} jours de suite`;
            }

            

            /*
             * Affichage du badge
             */
            const streakBadge =
                document.getElementById('streakBadge');

            if (streakBadge) {
                streakBadge.style.display = 'flex';
            }

        } else {

            console.warn(
                "âš ï¸ Impossible de rÃ©cupÃ©rer le streak :",
                data.message
            );
        }

    } catch (error) {

        console.error(
            "âŒ Erreur lors de la mise Ã  jour du streak :",
            error
        );
    }
}

/**
 * ==========================================
 * GESTION DE LA FIDÃ‰LITÃ‰ (MISE Ã€ JOUR)
 * ==========================================
 */
async function loadLoyaltyData() {
    if (!currentUsername) return;

    const cacheKey = `cache_loyalty_${currentUsername}`;
    const cached = getCache(cacheKey);
    
    if (cached) {
        userPoints.total = cached.total || 0;
        renderLoyaltyActionButton(cached.history || []);
        renderUserStats();
    }

    // VÃ©rification de la prÃ©sence du token avant mÃªme de tenter la requÃªte
    const token = localStorage.getItem('token');
    if (!token) {
        console.warn("Utilisateur non authentifiÃ© : aucun token trouvÃ©.");
        return; 
    }

    const urlHistory = `${API_BASE_URL}/api/points/history?username=${encodeURIComponent(currentUsername)}`;

    try {
        const response = await fetch(urlHistory, {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            }
        });

        // Gestion de l'erreur 401 (Token expirÃ© ou invalide)
        if (response.status === 401) {
            console.error("Erreur 401 : Token invalide ou expirÃ©.");
            // Optionnel : dÃ©connecter l'utilisateur si nÃ©cessaire
            // localStorage.removeItem('token'); 
            return;
        }

        if (response.status === 404) {
            console.warn(`Aucun historique trouvÃ© pour ${currentUsername}.`);
            userPoints.total = 0;
            renderLoyaltyActionButton([]);
            renderUserStats();
            return;
        }

        if (!response.ok) throw new Error(`Erreur HTTP: ${response.status}`);

        const data = await response.json();
        
        if (data && data.success) {
            userPoints.total = parseFloat(data.total_points) || 0;
            renderLoyaltyActionButton(data.history || []);
            setCache(cacheKey, { total: userPoints.total, history: data.history || [] });
        } else {
            userPoints.total = 0;
            renderLoyaltyActionButton([]);
        }
        renderUserStats();

    } catch (error) {
        console.error("Erreur lors du chargement de la fidÃ©litÃ© :", error);
        // On ne remet pas forcÃ©ment Ã  0 si on a dÃ©jÃ  un cache, 
        // cela Ã©vite de faire clignoter l'interface lors d'un problÃ¨me rÃ©seau mineur
        if (!cached) {
            userPoints.total = 0;
            renderLoyaltyActionButton([]);
            renderUserStats();
        }
    }
}

function renderLoyaltyActionButton(history) {
    const container = document.getElementById('loyalty-action-container');
    if (!container) return;

    // Nettoyer l'ancien intervalle s'il existe pour Ã©viter les fuites de mÃ©moire
    if (window.loyaltyCountdownInterval) {
        clearInterval(window.loyaltyCountdownInterval);
        window.loyaltyCountdownInterval = null; // S'assurer qu'il est rÃ©initialisÃ©
    }

    const now = new Date();
    let dernierBonusDate = null;

    // Trouver la derniÃ¨re action de bonus quotidienne
    const dailyBonuses = Array.isArray(history) 
        ? history.filter(item => item.actionType === 'DAILY_VERSE')
        : [];

    if (dailyBonuses.length > 0) {
        // Trier par date pour trouver le plus rÃ©cent
        dailyBonuses.sort((a, b) => {
            const [datePartA, timePartA] = a.date.split(' ');
            const [dayA, monthA, yearA] = datePartA.split('/');
            const [hoursA, minutesA] = timePartA.split(':');
            const dateA = new Date(yearA, monthA - 1, dayA, hoursA, minutesA);

            const [datePartB, timePartB] = b.date.split(' ');
            const [dayB, monthB, yearB] = datePartB.split('/');
            const [hoursB, minutesB] = timePartB.split(':');
            const dateB = new Date(yearB, monthB - 1, dayB, hoursB, minutesB);

            return dateB.getTime() - dateA.getTime(); // Du plus rÃ©cent au plus ancien
        });
        
        // Le plus rÃ©cent est le premier
        const mostRecentBonus = dailyBonuses[0];
        const [datePart, timePart] = mostRecentBonus.date.split(' ');
        const [day, month, year] = datePart.split('/');
        const [hours, minutes] = timePart.split(':');
        dernierBonusDate = new Date(year, month - 1, day, hours, minutes);
    }

    const dateProchainBonus = dernierBonusDate ? new Date(dernierBonusDate.getTime() + (24 * 60 * 60 * 1000)) : null;

    if (dateProchainBonus && now < dateProchainBonus) {
        // CrÃ©ation du conteneur pour le rebours
        container.innerHTML = `
            <button class="loyalty-action-btn" style="background: #e2e8f0; color: #94a3b8; cursor: not-allowed; display: flex; flex-direction: column; gap: 4px; padding: 10px 16px;" disabled>
                <span><i data-feather="check-circle"></i> Bonus quotidien rÃ©clamÃ©</span>
                <small id="loyalty-countdown-timer" style="font-size: 0.75rem; color: #64748b; font-weight: bold;"></small>
            </button>
        `;
        feather.replace();

        // Fonction de mise Ã  jour du chrono
        function updateTimer() {
            const maintenant = new Date();
            const reste = dateProchainBonus - maintenant;

            const timerEl = document.getElementById('loyalty-countdown-timer');
            if (!timerEl) return;

            if (reste <= 0) {
                timerEl.innerText = "Bonus disponible ! Recharger la page.";
                clearInterval(window.loyaltyCountdownInterval);
                window.loyaltyCountdownInterval = null;
                // Recharger les donnÃ©es pour afficher le bouton de rÃ©clamation
                loadLoyaltyData(); 
                return;
            }

            const h = Math.floor(reste / (1000 * 60 * 60));
            const m = Math.floor((reste % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((reste % (1000 * 60)) / 1000);

            const format = (num) => num < 10 ? '0' + num : num;
            timerEl.innerText = `Disponible dans : ${format(h)}h ${format(m)}m ${format(s)}s`;
        }

        // Lancer le compteur immÃ©diatement et toutes les secondes
        window.loyaltyUpdateTimerFn = updateTimer;
        updateTimer();
        window.loyaltyCountdownInterval = setInterval(updateTimer, 1000);

    } else {
        // Pas de bonus Ã  venir ou dÃ©jÃ  disponible : Bouton actif
        window.loyaltyUpdateTimerFn = null;
        container.innerHTML = `
            <button class="loyalty-action-btn" onclick="claimDailyLoginReward()">
                <i data-feather="gift"></i> RÃ©clamer mon bonus (+0.50)
            </button>
        `;
        feather.replace();
    }
}

async function claimDailyLoginReward() {
    const container = document.getElementById('loyalty-action-container');
    if (!container) return;
    
    const token = localStorage.getItem('token');
    
    // SÃ©curitÃ© Frontend si le token n'existe pas dans le localStorage
    

    container.innerHTML = `
        <button class="loyalty-action-btn" disabled>
            <i data-feather="loader" class="animate-spin"></i> Traitement...
        </button>
    `;
    feather.replace();

    try {
        const response = await fetch(`${API_BASE_URL}/api/reward/daily-login`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ username: currentUsername })
        });

        if (response.status === 401) {
            showToast("Session non autorisÃ©e. Veuillez vous reconnecter.", "error");
            loadLoyaltyData(); // Recharge les donnÃ©es qui incluront un appel Ã  renderUserStats
            return;
        }

        const data = await response.json();
        showToast(data.message || (data.success ? "OpÃ©ration rÃ©ussie !" : "Une erreur est survenue."), data.success ? "success" : "error");
        
        loadLoyaltyData(); // Recharge les donnÃ©es qui incluront un appel Ã  renderUserStats

    } catch (error) {
        console.error("Erreur lors de la rÃ©clamation du bonus :", error);
        showToast("Impossible de joindre le serveur de fidÃ©litÃ©.", "error");
        loadLoyaltyData(); // Recharge les donnÃ©es qui incluront un appel Ã  renderUserStats
    }
}

/**
 * Construit le rendu de la liste d'activitÃ©s Ã  partir des donnÃ©es brutes
 * (utilisÃ© Ã  la fois pour l'affichage depuis le cache et depuis le rÃ©seau).
 */
/**
 * Construit le rendu de la liste d'activitÃ©s Ã  partir des donnÃ©es brutes,
 * en les groupant par jour et en gÃ©rant le chargement progressif.
 * @param {Array} allData Toutes les activitÃ©s brutes de l'API.
 */
function renderActivities(allData) {

    const activityDisplayArea =
        document.getElementById('activity-display-area');

    const activityListSkeleton =
        document.getElementById('activity-list-skeleton');

    const paginationBar =
        document.getElementById('activity-pagination');

    if (!activityDisplayArea || !activityListSkeleton) {
        return;
    }

    activityListSkeleton.style.display = 'none';

    if (!allData || allData.length === 0) {

        activityDisplayArea.innerHTML = `
            <div class="activity-empty-state">
                <div class="activity-empty-icon">
                    <i data-feather="book-open"></i>
                </div>

                <p>Aucune activitÃ© rÃ©cente pour le moment.</p>

                <span>
                    Commencez Ã  lire la Bible pour voir votre progression ici !
                </span>
            </div>
        `;

        if (paginationBar) {
            paginationBar.style.display = 'none';
            paginationBar.innerHTML = '';
        }

        feather.replace();
        return;
    }

    const groupedActivities = allData.reduce((acc, item) => {

        const dateKey =
            formatDateForDisplay(item.created_at);

        if (!acc[dateKey]) {
            acc[dateKey] = [];
        }

        acc[dateKey].push(item);

        return acc;

    }, {});

    const sortedDateKeys =
        Object.keys(groupedActivities).sort((a, b) => {

            const dateA =
                new Date(groupedActivities[a][0].created_at);

            const dateB =
                new Date(groupedActivities[b][0].created_at);

            return dateB.getTime() - dateA.getTime();
        });

    let htmlContent = '';

    activityColorIndex = 0;

    sortedDateKeys.forEach((dateKey, dayIndex) => {

        const dayActivities =
            groupedActivities[dateKey];

        const groupedBooks =
            dayActivities.reduce((acc, item) => {

                const book =
                    item.book || 'Bible';

                if (!acc[book]) {
                    acc[book] = [];
                }

                acc[book].push(item);

                return acc;

            }, {});

        const bookNames =
            Object.keys(groupedBooks);

        const totalChapters =
            dayActivities.length;

        const totalVerses =
            dayActivities.reduce((total, item) => {

                return total +
                    (
                        Array.isArray(item.verses)
                            ? item.verses.length
                            : 0
                    );

            }, 0);

        const groupId =
            `activity-details-${dayIndex}-${Date.now()}`;

        htmlContent += `
            <div class="activity-day-group compact">

                <div class="activity-date-header">

                    <span>
                        ${dateKey}
                    </span>

                    <span class="activity-day-count">
                        ${totalChapters}
                        ${totalChapters > 1
                            ? 'activitÃ©s'
                            : 'activitÃ©'}
                    </span>

                </div>

                <div class="activity-summary-card">

                    <div class="activity-summary-icon">
                        <i data-feather="book-open"></i>
                    </div>

                    <div class="activity-summary-content">

                        <div class="activity-summary-title">
                            Lecture biblique
                        </div>

                        <div class="activity-summary-text">

                            <strong>
                                ${totalChapters}
                                ${totalChapters > 1
                                    ? 'chapitres lus'
                                    : 'chapitre lu'}
                            </strong>

                            <span>
                                dans ${bookNames.length}
                                ${bookNames.length > 1
                                    ? 'livres'
                                    : 'livre'}
                            </span>

                            ${
                                totalVerses > 0
                                    ? `
                                        <span>
                                            â€¢ ${totalVerses} versets
                                        </span>
                                      `
                                    : ''
                            }

                        </div>

                    </div>

                    <button
                        type="button"
                        class="activity-details-btn"
                        onclick="toggleActivityDetails('${groupId}', this)"
                        aria-expanded="false"
                    >
                        <span>DÃ©tails</span>
                        <i data-feather="chevron-down"></i>
                    </button>

                </div>

                <div
                    class="activity-details"
                    id="${groupId}"
                    style="display:none;"
                >
        `;

        bookNames.forEach(bookName => {

            const bookActivities =
                groupedBooks[bookName];

            htmlContent += `
                <div class="activity-book-group">

                    <div class="activity-book-header">

                        <div class="activity-book-icon">
                            <i data-feather="book"></i>
                        </div>

                        <div>
                            <strong>${bookName}</strong>

                            <span>
                                ${bookActivities.length}
                                ${
                                    bookActivities.length > 1
                                        ? 'chapitres'
                                        : 'chapitre'
                                }
                            </span>
                        </div>

                    </div>

                    <div class="activity-chapter-list">
            `;

            bookActivities.forEach(item => {

                const chapter =
                    item.chapter || '?';

                const verses =
                    Array.isArray(item.verses)
                        ? item.verses.join(', ')
                        : '';

                htmlContent += `
                    <div class="activity-chapter-item">

                        <div class="activity-chapter-icon">
                            <i data-feather="check"></i>
                        </div>

                        <div class="activity-chapter-content">

                            <div class="activity-title">
                                Chapitre ${chapter}
                            </div>

                            ${
                                verses
                                    ? `
                                        <div class="activity-text">
                                            Versets : ${verses}
                                        </div>
                                      `
                                    : ''
                            }

                        </div>

                    </div>
                `;
            });

            htmlContent += `
                    </div>
                </div>
            `;
        });

        htmlContent += `
                </div>
            </div>
        `;
    });

    activityDisplayArea.innerHTML = htmlContent;

    if (paginationBar) {
        paginationBar.style.display = 'none';
        paginationBar.innerHTML = '';
    }

    feather.replace();

    if (typeof observeActivityElements === 'function') {
        observeActivityElements();
    }
}

function toggleActivityDetails(id, button) {

    const details =
        document.getElementById(id);

    if (!details) {
        return;
    }

    const isHidden =
        details.style.display === 'none' ||
        details.style.display === '';

    if (isHidden) {

        details.style.display = 'block';

        button.setAttribute(
            'aria-expanded',
            'true'
        );

        const span =
            button.querySelector('span');

        if (span) {
            span.textContent = 'Masquer';
        }

        const icon =
            button.querySelector('i');

        if (icon) {
            icon.setAttribute(
                'data-feather',
                'chevron-up'
            );
        }

    } else {

        details.style.display = 'none';

        button.setAttribute(
            'aria-expanded',
            'false'
        );

        const span =
            button.querySelector('span');

        if (span) {
            span.textContent = 'DÃ©tails';
        }

        const icon =
            button.querySelector('i');

        if (icon) {
            icon.setAttribute(
                'data-feather',
                'chevron-down'
            );
        }
    }

    feather.replace();
}
function renderActivityPagination(totalPages, totalDays) {

    const paginationBar =
        document.getElementById('activity-pagination');

    if (!paginationBar) {
        return;
    }

    /*
     * Une seule page :
     * inutile d'afficher la pagination.
     */
    if (totalPages <= 1) {

        paginationBar.style.display = 'none';
        paginationBar.innerHTML = '';

        return;
    }

    paginationBar.style.display = 'flex';

    const pages = [];

    /*
     * Affichage simple si peu de pages.
     */
    if (totalPages <= 6) {

        for (let p = 1; p <= totalPages; p++) {
            pages.push(p);
        }

    } else {

        pages.push(1);

        if (currentActivityPage > 3) {
            pages.push('...');
        }

        const start =
            Math.max(2, currentActivityPage - 1);

        const end =
            Math.min(totalPages - 1, currentActivityPage + 1);

        for (let p = start; p <= end; p++) {
            pages.push(p);
        }

        if (currentActivityPage < totalPages - 2) {
            pages.push('...');
        }

        pages.push(totalPages);
    }

    const numbersHtml =
        pages.map(function(p) {

            if (p === '...') {

                return `
                    <span class="activity-page-ellipsis">
                        ...
                    </span>
                `;
            }

            const active =
                p === currentActivityPage;

            return `
                <button
                    type="button"
                    class="activity-page-btn${active ? ' active' : ''}"
                    ${active ? 'aria-current="page"' : ''}
                    onclick="goToActivityPage(${p})"
                >
                    ${p}
                </button>
            `;

        }).join('');

    paginationBar.innerHTML = `

        <button
            type="button"
            class="activity-page-nav"
            onclick="goToActivityPage(currentActivityPage - 1)"
            aria-label="Page prÃ©cÃ©dente"
            ${currentActivityPage === 1 ? 'disabled' : ''}
        >
            <i data-feather="chevron-left"></i>
        </button>

        <div class="activity-page-numbers">
            ${numbersHtml}
        </div>

        <button
            type="button"
            class="activity-page-nav"
            onclick="goToActivityPage(currentActivityPage + 1)"
            aria-label="Page suivante"
            ${currentActivityPage === totalPages ? 'disabled' : ''}
        >
            <i data-feather="chevron-right"></i>
        </button>

        <span class="activity-page-meta">
            ${totalDays}
            ${totalDays > 1 ? 'jours' : 'jour'}
        </span>
    `;

    if (typeof feather !== 'undefined') {
        feather.replace();
    }
}


/*
 * Navigation entre les pages d'activitÃ©s.
 */
function goToActivityPage(page) {

    if (
        page < 1 ||
        page > Math.max(
            1,
            Math.ceil(
                Object.keys(
                    allRawActivities.reduce(function(acc, item) {

                        const key =
                            formatDateForDisplay(item.created_at);

                        if (!acc[key]) {
                            acc[key] = [];
                        }

                        acc[key].push(item);

                        return acc;

                    }, {})
                ).length / ACTIVITIES_DAYS_PER_PAGE
            )
        )
    ) {
        return;
    }

    if (page === currentActivityPage) {
        return;
    }

    currentActivityPage = page;

    renderActivities(allRawActivities);

    const section =
        document.getElementById('recent-activities-card');

    if (section) {

        section.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
        });
    }
}

async function loadActivities() {
    const username = localStorage.getItem('user_name');
    const activityDisplayArea = document.getElementById('activity-display-area');
    const activityListSkeleton = document.getElementById('activity-list-skeleton');
    const paginationBar = document.getElementById('activity-pagination');

    if (!username) {
        activityDisplayArea.innerHTML = `
            <div style="padding: 20px; text-align: center; color: var(--muted); font-size: 0.9rem;">
                Connectez-vous pour voir vos activitÃ©s rÃ©centes.
            </div>
        `;
        if (activityListSkeleton) activityListSkeleton.style.display = 'none';
        if (paginationBar) paginationBar.style.display = 'none';
        // RÃ©initialisation des stats en mode invitÃ©
        userPoints.bibleVerses = 0;
        userPoints.bibleChapters = 0;
        renderUserStats();
        feather.replace();
        return;
    }

    // Affiche le squelette pendant le chargement, rÃ©initialise la pagination
    activityListSkeleton.style.display = 'flex';
    activityDisplayArea.innerHTML = ''; // Nettoyer le contenu prÃ©cÃ©dent
    currentActivityPage = 1;

    const cacheKey = `cache_activities_${username}`;
    const cached = getCache(cacheKey);
    if (cached) {
        allRawActivities = cached;
        renderActivities(allRawActivities);
        activityListSkeleton.style.display = 'none';
    }

    try {
        const response = await fetch(`${API_BASE_URL}/api/bible/history?username=${username}`);
        if (!response.ok) {
            throw new Error(`Erreur HTTP: ${response.status}`);
        }
        const data = await response.json();

        allRawActivities = data;
        setCache(cacheKey, data);

        renderActivities(allRawActivities);
        updateUserStatsFromActivities(data); // Met Ã  jour les stats aprÃ¨s le chargement des activitÃ©s

    } catch (error) {
        console.error("Erreur lors du chargement des activitÃ©s bibliques :", error);
        if (!cached) { // Si pas de cache, affiche un message d'erreur
            activityDisplayArea.innerHTML = `
                <div style="padding: 20px; text-align: center; color: var(--danger); font-size: 0.9rem;">
                    Erreur lors du chargement des activitÃ©s. Veuillez rÃ©essayer plus tard.
                </div>
            `;
            // RÃ©initialise les compteurs en cas d'erreur
            userPoints.bibleVerses = 0;
            userPoints.bibleChapters = 0;
            renderUserStats();
        } else {
            showToast("Impossible de rafraÃ®chir vos activitÃ©s rÃ©centes.", "error");
        }
    } finally {
        activityListSkeleton.style.display = 'none';
        feather.replace();
    }
}

/**
 * Met Ã  jour les statistiques de l'utilisateur (versets, chapitres) Ã  partir des activitÃ©s.
 * @param {Array} activities La liste complÃ¨te des activitÃ©s.
 */
function updateUserStatsFromActivities(activities) {
    let totalVersesRead = 0;
    const uniqueChapters = new Set();

    if (Array.isArray(activities)) {
        activities.forEach(item => {
            if (item.verses) {
                totalVersesRead += item.verses.length;
            }
            if (item.book && item.chapter) {
                uniqueChapters.add(`${item.book}-${item.chapter}`);
            }
        });
    }

    userPoints.bibleVerses = totalVersesRead;
    userPoints.bibleChapters = uniqueChapters.size;

    
    renderUserStats();
}

// Fonctions utilitaires, conservÃ©es pour Ãªtre appelÃ©es par renderUserStats
function calculateLevel(points) {
    return Math.floor(points / 100) + 1;
}

function calculateProgress(points) {
    return Math.floor(points % 100);
}

// Nouvelle fonction de rendu unifiÃ©e pour toutes les statistiques utilisateur
function renderUserStats() {
    const { total, bibleVerses, bibleChapters, prayerMinutes } = userPoints;

    // Mise Ã  jour du solde de fidÃ©litÃ©
    setText('display-points', `${total.toFixed(2)} Points`);

    // Calcul et mise Ã  jour de la progression (Niveau et Cercle)
    const level = calculateLevel(total);
    const progress = calculateProgress(total);

    const levelBtn = document.querySelector('.progress-btn');
    if (levelBtn) levelBtn.innerText = `Niveau ${level}`;

    const circleText = document.querySelector('.circle-text');
    if (circleText) circleText.innerText = `${Math.floor(total % 100)} pts`; // Points absolus dans le cycle

    const progressCircle = document.querySelector('.progress-circle');
    if (progressCircle) {
        progressCircle.style.background =
            `conic-gradient(rgb(209 107 116) 0%, rgb(255 11 11) 34%, rgb(226, 232, 240) 34%, rgb(226, 232, 240) 100%)`;
    }

    // Mise Ã  jour des statistiques d'activitÃ© spÃ©cifiques avec les donnÃ©es rÃ©elles
    setText('stats-versets', bibleVerses);
    setText('stats-lecons', bibleChapters);
    setText('stats-priere', `${total * 2}m`); // Garde la dÃ©rivation actuelle pour la priÃ¨re

    // GÃ©nÃ©ration des trophÃ©es
    generateTrophies(total);

    // feather.replace() est appelÃ© par generateTrophies() si nÃ©cessaire et n'est pas nÃ©cessaire ici.
}

