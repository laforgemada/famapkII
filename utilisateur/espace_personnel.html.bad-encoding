    // 18. Lion de Juda â€” tÃªte de lion stylisÃ©e
    `<g fill="#f59e0b" stroke="rgba(0,0,0,0.18)" stroke-width="0.6">
       <polygon points="24,4 28,14 20,14"/><polygon points="24,44 28,34 20,34"/>
       <polygon points="4,24 14,28 14,20"/><polygon points="44,24 34,28 34,20"/>
       <polygon points="9,9 17,17 12,19"/><polygon points="39,9 31,17 36,19"/>
       <polygon points="9,39 17,31 12,29"/><polygon points="39,39 31,31 36,29"/>
     </g>
     <circle cx="24" cy="24" r="10" fill="#fde68a"/>
     <circle cx="20" cy="22" r="1.4" fill="#0f172a" stroke="none"/>
     <circle cx="28" cy="22" r="1.4" fill="#0f172a" stroke="none"/>
     <path d="M22 27 Q24 29 26 27" fill="none" stroke="#0f172a" stroke-width="1.2"/>`,
    // 19. Sage â€” balance
    `<line x1="24" y1="6" x2="24" y2="38" stroke-width="2.5"/>
     <line x1="10" y1="14" x2="38" y2="14" stroke-width="2.5"/>
     <rect x="19" y="38" width="10" height="3" rx="1"/>
     <path d="M6 15 L14 15 L10 24 Z"/>
     <path d="M34 15 L42 15 L38 24 Z"/>`,
    // 20. Porteur de Croix â€” croix
    `<rect x="20.5" y="6" width="7" height="36" rx="1.5"/>
     <rect x="9" y="17" width="30" height="7" rx="1.5"/>`,
    // 21. Vigne Fructueuse â€” grappe de raisin
    `<path d="M22 8 C22 12 26 12 26 8" fill="none" stroke="#16a34a" stroke-width="2"/>
     <g fill="#a78bfa" stroke="rgba(0,0,0,0.16)" stroke-width="0.5">
       <circle cx="24" cy="14" r="4.4"/>
       <circle cx="18" cy="19" r="4.4"/><circle cx="30" cy="19" r="4.4"/>
       <circle cx="24" cy="24" r="4.4"/>
       <circle cx="18" cy="29" r="4.4"/><circle cx="30" cy="29" r="4.4"/>
       <circle cx="24" cy="34" r="4.4"/>
     </g>`,
    // 22. Pain de Vie â€” pain
    `<path d="M8 26 C8 16 16 12 24 12 C32 12 40 16 40 26 C40 33 32 37 24 37 C16 37 8 33 8 26 Z" fill="#d97706"/>
     <path d="M17 18 C18 24 18 30 16 34" fill="none" stroke="rgba(0,0,0,0.22)" stroke-width="1.3"/>
     <path d="M24 16 C25 23 25 29 23 35" fill="none" stroke="rgba(0,0,0,0.22)" stroke-width="1.3"/>
     <path d="M31 18 C32 24 32 30 30 34" fill="none" stroke="rgba(0,0,0,0.22)" stroke-width="1.3"/>`,
    // 23. Ã‰toile du Matin â€” Ã©toile
    `<polygon points="24,4 29,18 44,18 32,27 36,42 24,33 12,42 16,27 4,18 19,18" fill="#fde047"/>`,
    // 24. Alliance Ã‰ternelle â€” arc-en-ciel
    `<path d="M6 34 A18 18 0 0 1 42 34" fill="none" stroke="#ef4444" stroke-width="4"/>
     <path d="M10 34 A14 14 0 0 1 38 34" fill="none" stroke="#fbbf24" stroke-width="4"/>
     <path d="M14 34 A10 10 0 0 1 34 34" fill="none" stroke="#38bdf8" stroke-width="4"/>
     <rect x="2" y="34" width="44" height="6" fill="#e0f2fe" stroke="none"/>`,
    // 25. PÃªcheur d'Hommes â€” poisson (ichthus)
    `<path d="M6 24 C14 12 34 12 42 24 C34 36 14 36 6 24 Z"/>
     <path d="M42 24 L48 18 V30 Z" stroke="none"/>
     <circle cx="14" cy="22" r="1.6" fill="#0f172a" stroke="none"/>`,
    // 26. Gardien des ClÃ©s â€” clÃ©
    `<circle cx="15" cy="15" r="8" fill="none" stroke-width="3"/>
     <rect x="14" y="21" width="4" height="20" rx="1"/>
     <rect x="18" y="30" width="6" height="4"/>
     <rect x="18" y="36" width="6" height="4"/>`,
    // 27. Arbre de Vie â€” arbre
    `<rect x="21" y="27" width="6" height="14" rx="1" fill="#92400e" stroke="rgba(0,0,0,0.2)"/>
     <circle cx="24" cy="16" r="13" fill="#22c55e"/>
     <circle cx="15" cy="22" r="8" fill="#16a34a"/>
     <circle cx="33" cy="22" r="8" fill="#16a34a"/>`,
    // 28. Aigle RenouvelÃ© â€” aigle ailes dÃ©ployÃ©es
    `<path d="M24 14 C24 10 26 8 30 8 C24 18 24 24 24 30 C24 24 24 18 18 8 C22 8 24 10 24 14 Z"/>
     <path d="M22 16 C14 14 4 16 2 22 C10 22 16 24 22 28 Z"/>
     <path d="M26 16 C34 14 44 16 46 22 C38 22 32 24 26 28 Z"/>
     <path d="M20 30 H28 L26 40 H22 Z"/>`,
    // 29. Sommet de Sion â€” montagne
    `<polygon points="6,38 18,16 24,26 30,14 42,38"/>
     <polygon points="18,16 22,22 14,22" fill="#e2e8f0" stroke="rgba(0,0,0,0.14)"/>
     <polygon points="30,14 34,20 26,20" fill="#e2e8f0" stroke="rgba(0,0,0,0.14)"/>`,
    // 30. CouronnÃ© â€” couronne
    `<polygon points="9,34 9,18 17,26 24,12 31,26 39,18 39,34"/>
     <rect x="8" y="34" width="32" height="6" rx="1.5"/>
     <circle cx="24" cy="18" r="2.2" fill="#ef4444" stroke="none"/>
     <circle cx="14" cy="24" r="1.8" fill="#38bdf8" stroke="none"/>
     <circle cx="34" cy="24" r="1.8" fill="#38bdf8" stroke="none"/>`
];

function renderTrophyIcon(index) {
    const shape = TROPHY_ICON_SHAPES[index % TROPHY_ICON_SHAPES.length];
    return `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
        <defs>
            <linearGradient id="iconBody${index}" x1="15%" y1="0%" x2="85%" y2="100%">
                <stop offset="0" stop-color="#fff7d6"/>
                <stop offset="18%" stop-color="#fde68a"/>
                <stop offset="42%" stop-color="#f2b73a"/>
                <stop offset="68%" stop-color="#c8791a"/>
                <stop offset="100%" stop-color="#7c4a12"/>
            </linearGradient>
            <linearGradient id="iconShine${index}" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0" stop-color="#ffffff" stop-opacity="0"/>
                <stop offset="45%" stop-color="#ffffff" stop-opacity="0"/>
                <stop offset="52%" stop-color="#ffffff" stop-opacity="0.85"/>
                <stop offset="58%" stop-color="#ffffff" stop-opacity="0"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
            </linearGradient>
            <filter id="iconGlow${index}" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="1.3" result="blur"/>
                <feMerge>
                    <feMergeNode in="blur"/>
                    <feMergeNode in="SourceGraphic"/>
                </feMerge>
            </filter>
        </defs>
        <ellipse cx="24" cy="27" rx="17" ry="16" fill="#000000" opacity="0.12"/>
        <g filter="url(#iconGlow${index})" fill="url(#iconBody${index})" stroke="rgba(87,46,7,0.55)" stroke-width="0.8" stroke-linejoin="round" stroke-linecap="round">
            ${shape}
        </g>
        <g fill="url(#iconShine${index})" stroke="none">
            ${shape}
        </g>
        <ellipse cx="16" cy="11" rx="9" ry="4.5" fill="#ffffff" opacity="0.55"/>
    </svg>`;
}

    trophyGrid.innerHTML = trophies.map((t, i) => {
        const isLocked = points < t.req; // Le pionnier a req 0, donc jamais locked
        const isMax = t.req === 0;
        const current = isMax ? 1 : Math.min(points, t.req);
        const total = isMax ? 1 : t.req;
        const ratio = isMax ? 1 : Math.min(points / t.req, 1);
        const filledStars = Math.max(0, Math.min(5, Math.round(ratio * 5)));
        const starsHTML = Array.from({ length: 5 }, (_, s) =>
            `<span class="star ${s < filledStars ? 'filled' : ''}">â˜…</span>`
        ).join('');
        return `
            <div class="trophy-card ${isLocked ? 'locked' : ''}" data-trophy="${t.name}" title="${t.desc}">
                <div class="trophy-top">
                    <div class="trophy-icon-wrap trophy-color-${(i % 8) + 1}">
                        ${!isLocked ? `<span class="trophy-flame" aria-hidden="true">
                            <svg viewBox="0 0 48 60" xmlns="http://www.w3.org/2000/svg">
                                <g class="flame-layer flame-outer">
                                    <path d="M24 2 C31 12 36 20 33 28 C36 26 38.5 30 37 35 C40 39 38 46 32 50 C36 46 34 40 30 38 C31 44 27 49 20 50 C24 47 24 42 21 39 C17 44 10 44 8 38 C12 39 14 36 12 32 C8 33 6 28 9 24 C13 26 15 22 13 18 C18 20 19 14 17 9 C21 12 22 8 24 2 Z" fill="url(#flameOuter${i})"/>
                                </g>
                                <g class="flame-layer flame-mid">
                                    <path d="M24 12 C29 19 32 25 29 31 C32 33 33 38 29 42 C31 38 28 34 25 33 C26 38 22 42 17 42 C20 39 19 35 16 33 C13 35 10 32 12 28 C15 29 17 26 15 23 C19 24 20 20 18 16 C21 18 22 15 24 12 Z" fill="url(#flameMid${i})"/>
                                </g>
                                <g class="flame-layer flame-core">
                                    <path d="M24 22 C27 27 28.5 31 26 35 C28 37 27 41 24 43 C21 41 20 37 22 35 C19.5 31 21 27 24 22 Z" fill="url(#flameCore${i})"/>
                                </g>
                                <circle class="flame-spark" cx="14" cy="20" r="1" fill="#fff" opacity="0.8"/>
                                <circle class="flame-spark" cx="33" cy="16" r="0.8" fill="#fff" opacity="0.7"/>
                                <circle class="flame-spark" cx="30" cy="30" r="0.9" fill="#fff" opacity="0.6"/>
                                <circle class="flame-spark" cx="17" cy="33" r="0.7" fill="#fff" opacity="0.7"/>
                                <defs>
                                    <linearGradient id="flameOuter${i}" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0" stop-color="#5fb3e0"/>
                                        <stop offset="1" stop-color="#1a3a75"/>
                                    </linearGradient>
                                    <linearGradient id="flameMid${i}" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0" stop-color="#aee4fb"/>
                                        <stop offset="1" stop-color="#1f6fc4"/>
                                    </linearGradient>
                                    <linearGradient id="flameCore${i}" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0" stop-color="#ffffff"/>
                                        <stop offset="1" stop-color="#bfeaff"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                        </span>` : ''}
                        <span class="trophy-icon-emoji">${renderTrophyIcon(i)}</span>
                        ${isLocked ? '<span class="trophy-lock-badge">ðŸ”’</span>' : ''}
                    </div>
                </div>
                <div class="trophy-name">${t.name}</div>
                <div class="trophy-ribbon">
                    <span class="trophy-ribbon-icon">${t.icon}</span>
                    <span class="trophy-ribbon-text">${isMax ? 'MAX' : `${current}/${total}`}</span>
                </div>
                <div class="trophy-stars" aria-hidden="true">${starsHTML}</div>
            </div>
        `;
    }).join('');

    // DÃ©tecte les trophÃ©es nouvellement dÃ©bloquÃ©s depuis la derniÃ¨re visite
    // pour dÃ©clencher une petite cÃ©lÃ©bration (confettis + toast), sans
    // fÃªter tous les trophÃ©es dÃ¨s la toute premiÃ¨re visite.
    const unlockedNames = trophies.filter(t => points >= t.req).map(t => t.name);
    const storageKey = `unlocked_trophies_${currentUsername || 'guest'}`;
    const previouslyUnlocked = getCache(storageKey);

    if (previouslyUnlocked === null) {
        setCache(storageKey, unlockedNames);
    } else {
        const newlyUnlocked = unlockedNames.filter(name => !previouslyUnlocked.includes(name));
        if (newlyUnlocked.length > 0) {
            setCache(storageKey, unlockedNames);
            newlyUnlocked.forEach((name, i) => {
                const trophy = trophies.find(t => t.name === name);
                setTimeout(() => celebrateTrophy(name, trophy ? trophy.icon : 'ðŸ†'), i * 500);
            });
        }
    }
}

/**
 * CÃ©lÃ¨bre le dÃ©blocage d'un nouveau trophÃ©e : petite animation sur la carte,
 * confettis Ã  l'Ã©cran et notification toast.
 */
function celebrateTrophy(name, icon) {
    const card = document.querySelector(`.trophy-card[data-trophy="${CSS.escape(name)}"]`);
    if (card) {
        card.classList.add('just-unlocked');
        setTimeout(() => card.classList.remove('just-unlocked'), 700);
    }
    spawnConfetti();
    showToast(`${icon} Nouveau trophÃ©e dÃ©bloquÃ© : ${name} !`, 'success', 5000);
}

function spawnConfetti() {
    const overlay = document.createElement('div');
    overlay.className = 'confetti-overlay';
    document.body.appendChild(overlay);

    const colors = ['#f59e0b', '#7c3aed', '#ec4899', '#22c55e', '#3b82f6'];
    for (let i = 0; i < 28; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';
        const startX = Math.random() * 100;
        const tx = (Math.random() - 0.5) * 220;
        const ty = 300 + Math.random() * 300;
        const rot = (Math.random() - 0.5) * 720;
        const duration = 1.2 + Math.random() * 0.8;
        const delay = Math.random() * 0.3;

        piece.style.left = `${startX}vw`;
        piece.style.background = colors[i % colors.length];
        piece.style.setProperty('--tx', `${tx}px`);
        piece.style.setProperty('--ty', `${ty}px`);
        piece.style.setProperty('--rot', `${rot}deg`);
        piece.style.animationDuration = `${duration}s`;
        piece.style.animationDelay = `${delay}s`;

        overlay.appendChild(piece);
    }

    setTimeout(() => overlay.remove(), 2400);
}


</script>




</body>
</html>


