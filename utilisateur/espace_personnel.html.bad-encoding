function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.innerText = value;
}

/**
 * ==========================================
 * CACHE LOCAL (stale-while-revalidate)
 * Affiche instantanÃ©ment la derniÃ¨re donnÃ©e connue
 * pendant que la version fraÃ®che est rÃ©cupÃ©rÃ©e en fond.
 * ==========================================
 */
function getCache(key) {
    try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : null;
    } catch (e) {
        return null;
    }
}

function setCache(key, value) {
    try {
        localStorage.setItem(key, JSON.stringify(value));
    } catch (e) {
        // Quota dÃ©passÃ© ou stockage indisponible : on ignore silencieusement
    }
}

/**
 * ==========================================
 * MODE SOMBRE
 * ==========================================
 */
function toggleTheme() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}

    // Le cercle de progression utilise une couleur inline gÃ©nÃ©rÃ©e en JS : on le rafraÃ®chit
    renderUserStats();
}

/**
 * ==========================================
 * NAVIGATION - onglet actif de la barre du bas
 * Compare le chemin rÃ©el de chaque lien Ã  l'URL courante
 * plutÃ´t que de coder l'Ã©tat "actif" en dur.
 * ==========================================
 */
function setActiveBottomNav() {
    const items = document.querySelectorAll('.bottom-item');
    const currentPath = window.location.pathname;
    let matched = false;

    items.forEach(item => {
        item.classList.remove('active');
        item.removeAttribute('aria-current');

        const href = item.getAttribute('href');
        if (!href) return;
        try {
            const linkPath = new URL(href, window.location.href).pathname;
            if (linkPath === currentPath) {
                item.classList.add('active');
                item.setAttribute('aria-current', 'page');
                matched = true;
            }
        } catch (e) {}
    });

    // Cette page est l'espace personnel : si aucun lien ne correspond
    // (cas normal, car "Profil" ouvre une modale et n'a pas de href),
    // on met en avant l'onglet Profil pour reflÃ©ter la page courante.
    if (!matched) {
        const profileItem = document.querySelector('.bottom-item[data-page="profile"]');
        if (profileItem) {
            profileItem.classList.add('active');
            profileItem.setAttribute('aria-current', 'page');
        }
    }
}

/**
 * ==========================================
 * STREAK DE LECTURE (jours consÃ©cutifs)
 * ==========================================
 */
function computeReadingStreak(historyItems) {
    if (!Array.isArray(historyItems) || historyItems.length === 0) return 0;

    const dayKeys = new Set(
        historyItems
            .filter(item => item.created_at)
            .map(item => {
                const d = new Date(item.created_at);
                return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
            })
    );

    const oneDay = 24 * 60 * 60 * 1000;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // La sÃ©rie doit inclure aujourd'hui ou hier pour Ãªtre considÃ©rÃ©e "active"
    const todayKey = `${today.getFullYear()}-${today.getMonth()}-${today.getDate()}`;
    const yesterday = new Date(today.getTime() - oneDay);
    const yesterdayKey = `${yesterday.getFullYear()}-${yesterday.getMonth()}-${yesterday.getDate()}`;

    let cursor;
    if (dayKeys.has(todayKey)) {
        cursor = new Date(today);
    } else if (dayKeys.has(yesterdayKey)) {
        cursor = new Date(yesterday);
    } else {
        return 0;
    }

    let streak = 0;
    while (dayKeys.has(`${cursor.getFullYear()}-${cursor.getMonth()}-${cursor.getDate()}`)) {
        streak++;
        cursor = new Date(cursor.getTime() - oneDay);
    }
    return streak;
}

function renderStreak(count) {
    const badge = document.getElementById('streakBadge');
    const text = document.getElementById('streakText');
    if (!badge || !text) return;

    if (count > 0) {
        text.innerText = `${count} jour${count > 1 ? 's' : ''} de suite`;
        badge.classList.add('show');
    } else {
        badge.classList.remove('show');
    }
}

/**
 * ==========================================
 * SYSTÃˆME DE NOTIFICATIONS TOAST
 * (remplace les alert() natifs pour une UX plus douce)
 * ==========================================
 */
function showToast(message, type = 'info', duration = 4000) {
    const container = document.getElementById('toastContainer');
    if (!container) { console.log(message); return; }

    const icons = { success: 'check-circle', error: 'alert-circle', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.setAttribute('role', 'status');
    toast.innerHTML = `
        <div class="toast-icon"><i data-feather="${icons[type] || 'info'}"></i></div>
        <span>${message}</span>
        <button class="toast-close" aria-label="Fermer la notification">
            <i data-feather="x"></i>
        </button>
    `;
    container.appendChild(toast);
    feather.replace();

    const remove = () => {
        toast.classList.add('hide');
        setTimeout(() => toast.remove(), 250);
    };

    toast.querySelector('.toast-close').addEventListener('click', remove);
    setTimeout(remove, duration);
}

