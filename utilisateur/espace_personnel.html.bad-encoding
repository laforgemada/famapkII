    fetchVideoBonusSettings().then(() => updateEarnCardsState());
    // RÃ©cupÃ¨re le dernier lien de mise Ã  jour publiÃ© (repli si une notif SSE arrive sans URL)
    fetchAppUpdateSettings();

    if (currentUsername) {
        // Affiche d'abord instantanÃ©ment ce qu'on a en cache local (pas
        // d'Ã©cran vide le temps du chargement), PUIS rÃ©cupÃ¨re la vraie
        // liste cÃ´tÃ© serveur (avec son Ã©tat "lu" fiable, peu importe si
        // l'utilisateur Ã©tait dÃ©connectÃ© quand les notifs sont arrivÃ©es).
        loadNotificationsFromStorage();
        renderNotificationBadge();
        renderVerticalDropdownMenu();
        fetchNotificationsFromServer();

        loadLoyaltyData();
        loadActivities(); // Charger la premiÃ¨re page d'activitÃ©s
        initRealtimeNotifications();
        updateEarnCardsState(); // Affiche l'Ã©tat des activitÃ©s du jour (fait/verrouillÃ©) et l'objectif quotidien
       
    } else {
        console.warn("Mode invitÃ© : Certaines fonctionnalitÃ©s sont dÃ©sactivÃ©es.");
        // Explicitly set guest states
        setText('display-points', '0.00 Points');
        document.getElementById('loyalty-action-container').innerHTML = `
            <button class="loyalty-action-btn" disabled>
                <i data-feather="lock"></i> Connectez-vous pour le bonus
            </button>
        `;
