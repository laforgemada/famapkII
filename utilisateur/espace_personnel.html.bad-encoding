        if (activityDisplayArea) {
            activityDisplayArea.innerHTML = `
                <div style="padding: 20px; text-align: center; color: var(--muted); font-size: 0.9rem;">
                    Connectez-vous pour voir vos activitÃ©s rÃ©centes.
                </div>
            `;
        }
        renderUserStats(); // Cela affichera les stats (priÃ¨re, leÃ§ons, versets) avec les valeurs par dÃ©faut (0 ou '...')
        feather.replace(); // Assurez-vous que les nouvelles icÃ´nes sont rendues
    }
    debugState("DÃ‰MARRAGE");

    // Ã‰couteur pour le bouton flottant du chat IA
    const openAIChatFab = document.getElementById('openAIChatFab');
    if (openAIChatFab) {
        openAIChatFab.addEventListener('click', openAIChatModal);
    }

    // Met en pause le compte Ã  rebours du bonus quand l'onglet est masquÃ©
    // (Ã©conomie CPU/batterie sur mobile), et le reprend au retour.
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            if (window.loyaltyCountdownInterval) {
                clearInterval(window.loyaltyCountdownInterval);
                window.loyaltyCountdownInterval = null;
            }
        } else if (window.loyaltyUpdateTimerFn && !window.loyaltyCountdownInterval) {
            window.loyaltyUpdateTimerFn();
            window.loyaltyCountdownInterval = setInterval(window.loyaltyUpdateTimerFn, 1000);
        }
    });
});

