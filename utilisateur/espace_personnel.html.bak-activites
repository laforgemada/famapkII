}
.video-play-icon { width: 44px; height: 44px; margin-bottom: 10px; opacity: .9; }
.video-fake-player p { position: relative; font-size: 0.9rem; opacity: .9; margin: 0; }
.video-status-text { font-size: 0.8rem; color: var(--muted, #64748b); text-align: center; margin: 4px 0 14px; }

/* Icône de notification pour la mise à jour de l'application (APK) */
.notif-item-icon.app_update { background: rgba(124,58,237,0.12); color: #7c3aed; }

.daily-goal-wrap {
    display: flex; align-items: center; gap: 10px; margin-top: 12px;
    background: rgba(255,255,255,0.12); border-radius: 14px; padding: 10px 14px;
}
.daily-goal-track { flex: 1; height: 8px; border-radius: 99px; background: rgba(255,255,255,0.25); overflow: hidden; }
.daily-goal-fill { height: 100%; border-radius: 99px; background: #fff; transition: width .4s ease; }
.daily-goal-label { font-size: 0.72rem; font-weight: 700; white-space: nowrap; }

@keyframes spin { to { transform: rotate(360deg); } }
.animate-spin { animation: spin 1s linear infinite; }

/* ==========================================
   EXTENSION : Icônes de trophées (badges attrayants)
   ========================================== */
.trophy-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 26px auto 12px;
    position: relative;
    background: var(--trophy-grad, linear-gradient(135deg, #f59e0b, #d97706));
    box-shadow: 0 8px 18px rgba(0,0,0,0.18), inset 0 2px 4px rgba(255,255,255,0.35);
    transition: transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease, margin-top .35s ease;
}
.trophy-card.locked .trophy-icon-wrap{
    margin-top: 0; /* Pas de flamme sur les trophées verrouillés : pas besoin de la place au-dessus */
}

.trophy-icon-emoji {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,0.2));
    transform: translateY(-1px);
    position: relative;
    z-index: 2;
}
.trophy-icon-emoji svg{
    width: 100%;
    height: 100%;
    display: block;
}

/* Flamme animée façon "langue de feu" au-dessus de l'icône, uniquement sur les trophées débloqués */
.trophy-flame{
    position: absolute;
    top: -30px;
    left: 50%;
    width: 28px;
    height: 35px;
    margin-left: -14px;
    z-index: 1;
    pointer-events: none;
    filter: drop-shadow(0 3px 6px rgba(29,78,216,0.5));
}
.trophy-flame svg{
    width: 100%;
    height: 100%;
    display: block;
    transform-origin: 50% 100%;
    animation: trophyFlameSway 1.6s ease-in-out infinite alternate;
}
.flame-layer{
    transform-origin: 50% 100%;
}
.flame-outer{ animation: trophyFlameFlicker 1.1s ease-in-out infinite alternate; }
.flame-mid{ animation: trophyFlameFlicker 0.9s ease-in-out infinite alternate; animation-delay: 0.12s; }
.flame-core{ animation: trophyFlameFlicker 0.7s ease-in-out infinite alternate; animation-delay: 0.22s; }
.flame-spark{
    animation: trophyFlameSparkle 1.4s ease-in-out infinite;
}
.flame-spark:nth-child(5){ animation-delay: 0.3s; }
.flame-spark:nth-child(6){ animation-delay: 0.6s; }
.flame-spark:nth-child(7){ animation-delay: 0.9s; }

@keyframes trophyFlameSway{
    0%   { transform: rotate(-3deg) scale(1); }
    50%  { transform: rotate(2deg) scale(1.03); }
    100% { transform: rotate(-2deg) scale(0.98); }
}
@keyframes trophyFlameFlicker{
    0%   { transform: scale(1, 1) skewX(0deg); }
    50%  { transform: scale(0.94, 1.06) skewX(2deg); }
    100% { transform: scale(1.05, 0.95) skewX(-2deg); }
}
@keyframes trophyFlameSparkle{
    0%, 100% { opacity: 0.2; transform: translateY(0); }
    50%      { opacity: 1; transform: translateY(-3px); }
}

/* Anneau de pulsation autour des trophées débloqués, pour attirer l'œil */
.trophy-icon-wrap::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid var(--trophy-ring, #d97706);
    opacity: 0;
}

.trophy-card:not(.locked) .trophy-icon-wrap::after {
    animation: trophyPulse 2.6s ease-out infinite;
}

@keyframes trophyPulse {
    0%   { opacity: .55; transform: scale(.86); }
    75%  { opacity: 0;   transform: scale(1.3); }
    100% { opacity: 0;   transform: scale(1.3); }
}

/* Survol : léger rebond + rotation pour un effet vivant */
.trophy-card:not(.locked):hover .trophy-icon-wrap {
    transform: scale(1.14) rotate(-6deg);
    box-shadow: 0 14px 26px rgba(0,0,0,0.24), inset 0 2px 4px rgba(255,255,255,0.4);
}

.trophy-card:not(.locked):hover .trophy-icon-emoji {
    transform: translateY(-1px) scale(1.05);
}

/* Reflet qui balaie l'icône au survol */
.trophy-icon-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(115deg, transparent 20%, rgba(255,255,255,0.45) 42%, transparent 60%);
    background-size: 220% 220%;
    background-position: -120% -120%;
    opacity: 0;
    transition: opacity .2s ease;
    pointer-events: none;
}

.trophy-card:not(.locked):hover .trophy-icon-wrap::before {
    opacity: 1;
    animation: trophyShine .9s ease forwards;
}

@keyframes trophyShine {
    from { background-position: -120% -120%; }
    to   { background-position: 120% 120%; }
}

/* Palette de dégradés distincte par trophée */
.trophy-color-1 { --trophy-grad: linear-gradient(135deg, #4ade80, #16a34a); --trophy-ring: #16a34a; }
.trophy-color-2 { --trophy-grad: linear-gradient(135deg, #38bdf8, #0284c7); --trophy-ring: #0284c7; }
.trophy-color-3 { --trophy-grad: linear-gradient(135deg, #a78bfa, #7c3aed); --trophy-ring: #7c3aed; }
.trophy-color-4 { --trophy-grad: linear-gradient(135deg, #fbbf24, #d97706); --trophy-ring: #d97706; }
.trophy-color-5 { --trophy-grad: linear-gradient(135deg, #f472b6, #db2777); --trophy-ring: #db2777; }
.trophy-color-6 { --trophy-grad: linear-gradient(135deg, #fb923c, #ea580c); --trophy-ring: #ea580c; }
.trophy-color-7 { --trophy-grad: linear-gradient(135deg, #f87171, #dc2626); --trophy-ring: #dc2626; }
.trophy-color-8 {
    --trophy-grad: linear-gradient(135deg, #fde047, #eab308);
    --trophy-ring: #eab308;
    box-shadow: 0 8px 22px rgba(234,179,8,0.4), inset 0 2px 4px rgba(255,255,255,0.5);
}

/* État verrouillé : icône en niveaux de gris + petit cadenas */
.trophy-card.locked .trophy-icon-wrap {
    background: linear-gradient(135deg, #cbd5e1, #94a3b8);
    box-shadow: inset 0 2px 4px rgba(255,255,255,0.25);
}

.trophy-card.locked .trophy-icon-emoji {
    filter: grayscale(1) opacity(0.65);
}

.trophy-card.locked .trophy-icon-wrap::after,
.trophy-card.locked .trophy-icon-wrap::before {
    display: none;
}

.trophy-lock-badge {
    position: absolute;
    bottom: -2px;
    right: calc(50% - 34px);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--card-bg, #fff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.18);
    border: 1px solid rgba(148,163,184,0.35);
}

/* Petit coup de pouce sur la carte au survol pour inviter au clic/regard */
.trophy-card { transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease; }
.trophy-card:not(.locked):hover { transform: translateY(-4px); box-shadow: 0 12px 22px rgba(0,0,0,0.08); }

/* Animation de déblocage (célébration) */
.trophy-card.just-unlocked .trophy-icon-wrap {
    animation: trophyPop .6s cubic-bezier(.34,1.56,.64,1);
}
@keyframes trophyPop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.35) rotate(8deg); }
    70%  { transform: scale(0.92) rotate(-4deg); }
    100% { transform: scale(1) rotate(0); }
}
</style>
<style>
/* ==========================================
   EXTENSION : Opportunités de Points (Refonte UI Pro)
   ========================================== */
.earn-points-section {
