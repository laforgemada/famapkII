<script>
    // Définir basePath de manière globale pour les chargements de ressources.
    const isGitHubPages = window.location.hostname.includes("github.io");
    const basePath = isGitHubPages ? "/famapkII" : "";

    // Appliqué immédiatement (avant le CSS/rendu) pour éviter le flash de thème clair
    (function() {
        try {
            const saved = localStorage.getItem('theme');
            const theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
    })();

    // Charger le CSS de la page en utilisant basePath (dynamiquement via JS)
    const linkCss = document.createElement('link');
    linkCss.rel = 'stylesheet';
    linkCss.href = basePath + '/css/espace_personnel.css';
    document.head.appendChild(linkCss);

    // Charger les fonctions globales (functions.js) dynamiquement AVANT le script inline principal
    const scriptFunctions = document.createElement('script');
    scriptFunctions.src = basePath + '/js/functions.js';
    // ⚠️ "defer" n'a AUCUN EFFET sur un <script> créé dynamiquement en JS
    // (defer ne fonctionne que pour les scripts déjà présents dans le HTML
    // au moment du parsing). Un script injecté ainsi s'exécute par défaut en
    // mode "async", donc sans garantie d'ordre ni d'avoir fini AVANT que
    // DOMContentLoaded ne se déclenche et n'utilise ses fonctions/constantes.
    // "async = false" est la technique standard pour forcer un script injecté
    // dynamiquement à s'exécuter dans l'ordre et à bloquer DOMContentLoaded
    // jusqu'à ce qu'il soit chargé, exactement comme "defer" l'aurait fait.
    scriptFunctions.async = false;
    document.head.appendChild(scriptFunctions);
</script>



<style>
/* ==========================================
   EXTENSION : Sondage / Quiz / Vidéo bonus
   (styles complémentaires à espace_personnel.css)
   ========================================== */
.earn-card { position: relative; transition: transform .15s ease, opacity .15s ease, box-shadow .15s ease; }
