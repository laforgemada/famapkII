// ==========================================
// Persistance des notifications (façon Facebook)
// ==========================================
// Le flux temps réel (SSE, plus bas) ne délivre les événements qu'aux
// utilisateurs connectés AU MOMENT PRÉCIS où ils se produisent — il ne
// peut donc jamais, à lui seul, montrer une notification à quelqu'un qui
// était hors ligne quand elle a été créée. La vraie source de vérité est
// donc le serveur : au chargement de la page, on RÉCUPÈRE les
// notifications non lues via une requête (fetchNotificationsFromServer),
// puis le flux SSE prend le relais pour le temps réel pendant que la page
// reste ouverte. Le localStorage sert uniquement de cache d'appoint si le
// réseau est momentanément indisponible.
const NOTIF_STORAGE_MAX = 50;

function getNotifStorageKey() {
    return currentUsername ? `notif_history_${currentUsername}` : null;
}

function loadNotificationsFromStorage() {
    const key = getNotifStorageKey();
    if (!key) return;
    try {
        const stored = localStorage.getItem(key);
        if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed)) {
                loadedNotificationsArray = parsed;
                notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
            }
        }
    } catch (e) {
        console.warn("Impossible de lire l'historique des notifications sauvegardé :", e);
    }
}

function saveNotificationsToStorage() {
    const key = getNotifStorageKey();
    if (!key) return;
    try {
        localStorage.setItem(key, JSON.stringify(loadedNotificationsArray.slice(0, NOTIF_STORAGE_MAX)));
    } catch (e) {
        console.warn("Impossible de sauvegarder l'historique des notifications :", e);
    }
}

/**
 * Récupère depuis le serveur les notifications réelles de l'utilisateur
 * (lues + non lues, les plus récentes), avec leur véritable état "lu"
 * mémorisé côté serveur — donc valable même s'il était déconnecté quand
 * elles ont été créées. Nécessite un endpoint backend GET /api/notifications/list
 * (voir le code PHP fourni séparément). Tant qu'il n'existe pas encore
 * côté serveur (404) ou est injoignable, on se rabat silencieusement sur
 * le cache local pour que l'interface reste utilisable.
 */
async function fetchNotificationsFromServer() {
    if (!currentUsername) return;
			try {
				const response = await fetch(
			`${API_BASE_URL}/api/notifications/list?username=${encodeURIComponent(currentUsername)}`,
			{
				headers: {
					'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
				}
			}
		);
        if (!response.ok) throw new Error(`Statut HTTP ${response.status}`);
        const data = await response.json();
        if (!Array.isArray(data.notifications)) throw new Error("Format de réponse invalide (champ 'notifications' manquant)");

        loadedNotificationsArray = data.notifications.map(n => ({
            id: n.id,
            realId: n.id,
            type: n.type || 'article',
            title: n.title || '',
            message: n.message || '',
            link: n.link || null,
            unread: !n.read,
            date: n.createdAt || new Date().toISOString()
        }));
        notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
        saveNotificationsToStorage(); // On garde aussi une copie locale en secours
    } catch (e) {
        console.warn("Notifications : endpoint serveur indisponible, utilisation du cache local en attendant.", e);
        loadNotificationsFromStorage();
    }
    renderNotificationBadge();
    renderVerticalDropdownMenu();
}

/**
 * Prévient le serveur qu'une notification a été lue, pour que l'état "lu"
 * soit valable sur tous les appareils/sessions de ce compte — pas juste
 * dans ce navigateur. Nécessite POST /api/notifications/{id}/read côté
 * backend. Si l'appel échoue, l'état reste marqué localement quand même
 * (l'utilisateur ne revoit pas la notif dans CETTE session), mais sans
 * garantie de synchronisation tant que le backend n'est pas en place.
 */
async function markNotificationReadOnServer(realId) {
    if (!currentUsername || !realId) return;

    try {
        const response = await fetch(
            `${API_BASE_URL}/api/notifications/${realId}/read?username=${encodeURIComponent(currentUsername)}`,
            {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
                }
            }
        );

        if (!response.ok) {
            console.warn(
                `Erreur serveur lors du marquage de la notification ${realId} : HTTP ${response.status}`
            );
            return;
        }

        const data = await response.json();
        console.log('Notification marquée comme lue :', data);

    } catch (e) {
        console.warn(
            `Impossible de synchroniser la lecture de la notification ${realId} avec le serveur :`,
            e
        );
    }
}

async function markAllNotificationsReadOnServer() {
    if (!currentUsername) return;
