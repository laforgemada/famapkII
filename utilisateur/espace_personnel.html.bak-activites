}

/**
 * ==========================================
 * NOTIFICATIONS EN TEMPS RÉEL (SSE)
 * ==========================================
 */
function initRealtimeNotifications() {
    console.log("Démarrage du flux SSE sur :", `${API_BASE_URL}/api/notifications/stream`);
    
    const eventSource = new EventSource(`${API_BASE_URL}/api/notifications/stream?username=${encodeURIComponent(currentUsername)}`);
    let wasConnected = false;

    eventSource.onopen = function() {
        updateSseStatus('connected');
        if (!wasConnected) {
            wasConnected = true;
        } else {
            showToast("Connexion en direct rétablie.", "success", 2500);
        }
    };

    eventSource.onmessage = function(event) {
        if (!event.data || event.data.trim() === "" || event.data.includes("ping")) {
            return; 
        }

        try {
            const data = JSON.parse(event.data);
            console.log("Flux SSE reçu avec succès :", data);

            if (!data || !data.message) return;

            if (typeof loadedNotificationsArray !== 'undefined') {
                const dejavu = loadedNotificationsArray.some(n => n.realId === data.id);
                if (dejavu) return; 
            }

            let iconType = 'article'; 
            let iconName = 'book-open';
            let directLink = '/famapkII/index.html';

            if (
                data.type === 'app_update' ||
                data.message.toLowerCase().includes('application') ||
                data.message.toLowerCase().includes('apk')
            ) {
                // Nouvelle version de l'application : ouvrira une popup (téléchargement + QR code)
                // au clic, au lieu de naviguer vers un lien classique.
                iconType = 'app_update';
                iconName = 'smartphone';
                directLink = '#';
                if (data.url) currentAppUpdateUrl = data.url;
            } else if (data.type === 'new_badge' || data.message.includes('badge') || data.message.includes('Trophée')) {
                iconType = 'badge';
                iconName = 'award';
                directLink = '#';
            } else if (data.type === 'chat' || data.message.includes('Chat') || data.message.includes('message')) {
                iconType = 'chat';
                iconName = 'message-square';
                directLink = '../../chat.html';
            }

            loadedNotificationsArray.unshift({
                id: Date.now(), 
                realId: data.id, 
                type: iconType,
                icon: iconName,
                message: data.message,
                time: 'À l\'instant',
                unread: true,
                link: directLink,
                apkUrl: iconType === 'app_update' ? (data.url || currentAppUpdateUrl || null) : null
            });

            notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
            saveNotificationsToStorage();
            renderNotificationBadge();
            renderVerticalDropdownMenu();

            const activityList = document.getElementById('activity-display-area');
            if (activityList) {
                const newItem = document.createElement('div');
                newItem.className = `activity-item is-visible`; // Ajoute is-visible pour l'animation
                newItem.style.border = '2px solid var(--secondary)';
                newItem.innerHTML = `
                    <div class="activity-icon ${getNextActivityIconColorClass()}">
                        <i data-feather="${iconName}"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title" style="color:var(--secondary);">Nouveau !</div>
                        <div class="activity-text">${data.message}</div>
                    </div>
                `;
                activityList.insertBefore(newItem, activityList.firstChild);
                feather.replace();
            }

            if (window.Notification && Notification.permission === "granted") {
                new Notification("Apokalypsy", { body: data.message });
            }

        } catch (error) {
            console.error("Erreur lors de l'analyse JSON du flux SSE :", error);
        }
    };

    eventSource.onerror = function(err) {
        console.log("Le tuyau SSE s'est déconnecté ou cherche à joindre le serveur. En attente...");
        updateSseStatus('reconnecting');
    };

    // État initial : en cours de connexion
    updateSseStatus('reconnecting');

    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('notifDropdown');
        const trigger = document.getElementById('notif-btn');
        if (dropdown && !dropdown.contains(event.target) && !trigger.contains(event.target)) {
            dropdown.classList.remove('show');
        }
    });
}

function toggleNotifMenu(event) {
    event.stopPropagation();
    const dropdown = document.getElementById('notifDropdown');
    const trigger = document.getElementById('notif-btn');
    if (dropdown) {
