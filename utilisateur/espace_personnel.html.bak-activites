    // cette même page, déclare AUSSI une fonction globale "logout()" (pour
    // la page d'accueil, avec sa propre logique liée au sélecteur de
    // langue). En JavaScript, deux fonctions globales du même nom se
    // écrasent l'une l'autre — celle chargée en dernier gagne. C'est ce qui
    // provoquait le crash "Cannot read properties of null (reading 'value')" :
    // la fonction logout() de functions.js s'exécutait à la place de la
    // nôtre. On utilise donc un nom garanti unique sur cette page.
    const modal = document.getElementById('logoutConfirmModal');
    if (modal) {
        modal.classList.add('show');
    } else {
        // Filet de sécurité si jamais la modale n'existe pas sur une page.
        performEspaceLogout();
    }
}

