function answerQuizStep(index) {
    const { questions, step } = quizState;
    const q = questions[step];
    const buttons = document.querySelectorAll('#quizOptionsList .poll-option-btn');

    buttons.forEach((btn, i) => {
        btn.disabled = true;
        if (i === q.correct) btn.classList.add('correct');
        else if (i === index) btn.classList.add('wrong');
    });

    if (index === q.correct) quizState.correctCount++;

    setTimeout(() => {
        if (step + 1 < questions.length) {
            quizState.step++;
            renderQuizStep();
        } else {
            finishQuiz();
        }
    }, 800);
}

