/**
 * Génère et affiche les initiales de l'utilisateur dans l'avatar du header.
 * Si l'utilisateur n'est pas connecté, affiche des points d'interrogation.
 */
function renderProfileAvatar(username) {
    const avatarElement = document.getElementById('profile-avatar-initials');
    if (!avatarElement) return;

    if (username && username !== 'Invité') {
        const parts = username.trim().split(" ");
        let initials = "??";
        if (parts.length > 1) {
            initials = (parts[0][0] + parts[1][0]).toUpperCase();
        } else if (username.length >= 2) {
            initials = username.substring(0, 2).toUpperCase();
        } else if (username.length === 1) {
            initials = username.toUpperCase();
        }
        avatarElement.innerText = initials;
    } else {
        avatarElement.innerText = "??"; // Mode invité
    }
}


