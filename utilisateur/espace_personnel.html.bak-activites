 * CACHE LOCAL (stale-while-revalidate)
 * Affiche instantanément la dernière donnée connue
 * pendant que la version fraîche est récupérée en fond.
 * ==========================================
 */
function getCache(key) {
    try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : null;
    } catch (e) {
        return null;
    }
}

