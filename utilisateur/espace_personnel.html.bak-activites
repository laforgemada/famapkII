    background: rgba(124,58,237,0.12); overflow: hidden; margin-bottom: 10px;
}
.quiz-progress-fill, .video-progress-fill {
    height: 100%; width: 0%; border-radius: 99px;
    background: linear-gradient(90deg, #7c3aed, #a855f7);
    transition: width .35s ease;
}
.quiz-step-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #7c3aed; margin-bottom: 4px; }
.quiz-result-box { text-align: center; padding: 18px 8px 4px; }
.quiz-result-emoji { font-size: 2.6rem; display: block; margin-bottom: 8px; }
