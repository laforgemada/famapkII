        <!-- =========================
             ACTIONS NAVIGATION
        ========================== -->
        <div class="nav-right">

            <!-- THÈME -->
            <button
                class="nav-btn theme-toggle"
                aria-label="Changer de thème (clair/sombre)"
                title="Changer de thème"
                onclick="toggleTheme()"
            >
                <i data-feather="moon" class="feather-moon"></i>
                <i data-feather="sun" class="feather-sun"></i>
            </button>


            <!-- RECHERCHE -->
            <button
                class="nav-btn"
                aria-label="Ouvrir la recherche"
                title="Rechercher"
                onclick="openSearchModal()"
            >
                <i data-feather="search"></i>
            </button>


            <!-- NOTIFICATIONS -->
            <div class="notif-wrapper">

                <button
                    class="nav-btn notification-btn"
                    id="notif-btn"
                    aria-label="Ouvrir les notifications"
                    aria-haspopup="true"
                    aria-expanded="false"
                    title="Notifications"
                    onclick="toggleNotifMenu(event)"
                >

                    <i data-feather="bell"></i>

                    <span
                        class="notif-badge"
                        id="notif-badge"
                    >0</span>

                    <!-- Connexion SSE -->
