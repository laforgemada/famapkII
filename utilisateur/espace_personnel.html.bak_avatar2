<script type="module">
    import { fullBibleContent } from '../data/bible_content.js';

    window.fullBibleContent = fullBibleContent;

    console.log(
        '📖 Bible chargée pour le quiz :',
        Object.keys(window.fullBibleContent)
    );
</script>
<script defer>
const DEBUG = true;

// Défini ICI, localement, plutôt que dans functions.js : cette page charge
// functions.js de façon dynamique/asynchrone, donc rien ne garantissait que
// functions.js ait fini de s'exécuter avant que ce script n'en ait besoin
// (d'où les erreurs "API_BASE_URL is not defined" malgré le correctif dans
// functions.js). En le définissant directement ici, comme le fait déjà
// bible.html, on élimine complètement ce problème d'ordre de chargement.
const API_BASE_URL = 'https://apokalypsy.com';
const DAILY_POLL_API_URL = `${API_BASE_URL}/api/poll/today`;
const BIBLE_QUIZ_API_URL = `${API_BASE_URL}/api/quiz/today`;



let currentUsername = null;
let loyaltyData = null;
let bonusTimer = null;

// Récupération de l'utilisateur après connexion Google
const urlParams = new URLSearchParams(window.location.search);
const googleUsername = urlParams.get('user');

if (googleUsername) {
    currentUsername = googleUsername;
    localStorage.setItem('user_name', googleUsername);
}

// Déclaration unique des variables globales des notifications
if (typeof notificationCount === 'undefined') {
    var notificationCount = 0;
}
if (typeof loadedNotificationsArray === 'undefined') {
    var loadedNotificationsArray = [];
}

// ==========================================
// Persistance des notifications (façon Facebook)
// ==========================================
// Le flux temps réel (SSE, plus bas) ne délivre les événements qu'aux
// utilisateurs connectés AU MOMENT PRÉCIS où ils se produisent — il ne
// peut donc jamais, à lui seul, montrer une notification à quelqu'un qui
// était hors ligne quand elle a été créée. La vraie source de vérité est
// donc le serveur : au chargement de la page, on RÉCUPÈRE les
// notifications non lues via une requête (fetchNotificationsFromServer),
// puis le flux SSE prend le relais pour le temps réel pendant que la page
// reste ouverte. Le localStorage sert uniquement de cache d'appoint si le
// réseau est momentanément indisponible.
const NOTIF_STORAGE_MAX = 50;

function getNotifStorageKey() {
    return currentUsername ? `notif_history_${currentUsername}` : null;
}

function loadNotificationsFromStorage() {
    const key = getNotifStorageKey();
    if (!key) return;
    try {
        const stored = localStorage.getItem(key);
        if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed)) {
                loadedNotificationsArray = parsed;
                notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
            }
        }
    } catch (e) {
        console.warn("Impossible de lire l'historique des notifications sauvegardé :", e);
    }
}

function saveNotificationsToStorage() {
    const key = getNotifStorageKey();
    if (!key) return;
    try {
        localStorage.setItem(key, JSON.stringify(loadedNotificationsArray.slice(0, NOTIF_STORAGE_MAX)));
    } catch (e) {
        console.warn("Impossible de sauvegarder l'historique des notifications :", e);
    }
}

function updateTrophyProgress(points) {
    const currentPointsEl = document.getElementById('trophyCurrentPoints');
    const nextPointsEl = document.getElementById('trophyNextPoints');
    const progressFillEl = document.getElementById('trophyProgressFill');
    const progressPercentEl = document.getElementById('trophyProgressPercent');
    const remainingEl = document.getElementById('trophyRemainingText');
    const nextTextEl = document.getElementById('trophyNextText');

    if (!currentPointsEl || !nextPointsEl || !progressFillEl) return;

    const trophies = [
        { name: "Pionnier", req: 0 },
        { name: "Chercheur", req: 50 },
        { name: "Explorateur", req: 120 },
        { name: "Disciple", req: 220 },
        { name: "Semeur", req: 350 },
        { name: "Serviteur", req: 500 },
        { name: "Intercesseur", req: 700 },
        { name: "Berger", req: 950 },
        { name: "Baptisé dans la Parole", req: 1250 },
        { name: "Veilleur", req: 1600 },
        { name: "Bâtisseur", req: 2000 },
        { name: "Porteur de Lumière", req: 2500 },
        { name: "Messager", req: 3100 },
        { name: "Héraut", req: 3800 },
        { name: "Cœur Ardent", req: 4600 },
        { name: "Guerrier de la Foi", req: 5500 },
        { name: "Ancre d'Espérance", req: 6500 },
        { name: "Lion de Juda", req: 7600 },
        { name: "Sage", req: 8800 },
        { name: "Porteur de Croix", req: 10200 },
        { name: "Vigne Fructueuse", req: 11800 },
        { name: "Pain de Vie", req: 13600 },
        { name: "Étoile du Matin", req: 15600 },
        { name: "Alliance Éternelle", req: 17800 },
        { name: "Pêcheur d'Hommes", req: 20200 },
        { name: "Gardien des Clés", req: 23000 },
        { name: "Arbre de Vie", req: 26000 },
        { name: "Aigle Renouvelé", req: 29500 },
        { name: "Sommet de Sion", req: 33500 },
        { name: "Couronné", req: 38000 }
    ];

    points = Number(points) || 0;

    // Trouver le prochain trophée
    const nextTrophy = trophies.find(t => points < t.req);

    // Si tous les trophées sont débloqués
    if (!nextTrophy) {
        currentPointsEl.textContent = Math.floor(points).toLocaleString('fr-FR');
        nextPointsEl.textContent = 'MAX';

        progressFillEl.style.width = '100%';

        if (progressPercentEl) {
            progressPercentEl.textContent = '100%';
        }

        if (remainingEl) {
            remainingEl.textContent = 'Tous les trophées débloqués 🎉';
        }

        if (nextTextEl) {
            nextTextEl.textContent = 'Niveau maximum';
        }

        return;
    }

    // Trouver le trophée précédent
    const previousTrophy = [...trophies]
        .reverse()
        .find(t => t.req <= points);

    const previousPoints = previousTrophy ? previousTrophy.req : 0;

    // Progression entre le trophée précédent et le prochain
    const range = nextTrophy.req - previousPoints;

    const progress = Math.min(
        Math.max(
            ((points - previousPoints) / range) * 100,
            0
        ),
        100
    );

    const remaining = Math.max(
        nextTrophy.req - points,
        0
    );

    // Mise à jour des textes
    currentPointsEl.textContent =
        Math.floor(points).toLocaleString('fr-FR');

    nextPointsEl.textContent =
        nextTrophy.req.toLocaleString('fr-FR');

    if (nextTextEl) {
        nextTextEl.textContent =
            `Prochain trophée : ${nextTrophy.name}`;
    }

    if (progressPercentEl) {
        progressPercentEl.textContent =
            `${Math.round(progress)}%`;
    }

    if (remainingEl) {
        remainingEl.textContent =
            `Encore ${remaining.toLocaleString('fr-FR')} pts`;
    }

    // Animation fluide de la barre
    requestAnimationFrame(() => {
        progressFillEl.style.width = `${progress}%`;
    });
}

/**
 * Récupère depuis le serveur les notifications réelles de l'utilisateur
 * (lues + non lues, les plus récentes), avec leur véritable état "lu"
 * mémorisé côté serveur — donc valable même s'il était déconnecté quand
 * elles ont été créées. Nécessite un endpoint backend GET /api/notifications/list
 * (voir le code PHP fourni séparément). Tant qu'il n'existe pas encore
 * côté serveur (404) ou est injoignable, on se rabat silencieusement sur
 * le cache local pour que l'interface reste utilisable.
 */
async function fetchNotificationsFromServer() {
    if (!currentUsername) return;
			try {
				const response = await fetch(
			`${API_BASE_URL}/api/notifications/list?username=${encodeURIComponent(currentUsername)}`,
			{
				headers: {
					'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
				}
			}
		);
        if (!response.ok) throw new Error(`Statut HTTP ${response.status}`);
        const data = await response.json();
        if (!Array.isArray(data.notifications)) throw new Error("Format de réponse invalide (champ 'notifications' manquant)");

        loadedNotificationsArray = data.notifications.map(n => ({
            id: n.id,
            realId: n.id,
            type: n.type || 'article',
            title: n.title || '',
            message: n.message || '',
            link: n.link || null,
            unread: !n.read,
            date: n.createdAt || new Date().toISOString()
        }));
        notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
        saveNotificationsToStorage(); // On garde aussi une copie locale en secours
    } catch (e) {
        console.warn("Notifications : endpoint serveur indisponible, utilisation du cache local en attendant.", e);
        loadNotificationsFromStorage();
    }
    renderNotificationBadge();
    renderVerticalDropdownMenu();
}

/**
 * Prévient le serveur qu'une notification a été lue, pour que l'état "lu"
 * soit valable sur tous les appareils/sessions de ce compte — pas juste
 * dans ce navigateur. Nécessite POST /api/notifications/{id}/read côté
 * backend. Si l'appel échoue, l'état reste marqué localement quand même
 * (l'utilisateur ne revoit pas la notif dans CETTE session), mais sans
 * garantie de synchronisation tant que le backend n'est pas en place.
 */
async function markNotificationReadOnServer(realId) {
    if (!currentUsername || !realId) return;

    try {
        const response = await fetch(
            `${API_BASE_URL}/api/notifications/${realId}/read?username=${encodeURIComponent(currentUsername)}`,
            {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
                }
            }
        );

        if (!response.ok) {
            console.warn(
                `Erreur serveur lors du marquage de la notification ${realId} : HTTP ${response.status}`
            );
            return;
        }

        const data = await response.json();
        console.log('Notification marquée comme lue :', data);

    } catch (e) {
        console.warn(
            `Impossible de synchroniser la lecture de la notification ${realId} avec le serveur :`,
            e
        );
    }
}

async function markAllNotificationsReadOnServer() {
    if (!currentUsername) return;
    try {
        await fetch(
			`${API_BASE_URL}/api/notifications/read-all?username=${encodeURIComponent(currentUsername)}`,
			{
				method: 'POST',
				headers: {
					'Authorization': `Bearer ${localStorage.getItem('token') || ''}`
				}
			}
		);
    } catch (e) {
        console.warn("Impossible de synchroniser le marquage global comme lu avec le serveur :", e);
    }
}

const activityIconColors = ['icon-blue', 'icon-purple', 'icon-pink', 'icon-orange-activity', 'icon-green-activity'];
const ACTIVITIES_DAYS_PER_PAGE = 3; // Nombre de jours affichés par page de pagination
let currentActivityPage = 1; // Page actuellement affichée dans la liste d'activités

let allRawActivities = []; // Stocke toutes les activités brutes pour le filtrage et le chargement progressif

let activityColorIndex = 0;

let userPoints = {
    total: 0,
    bibleVerses: 0,
    bibleChapters: 0,
    prayerMinutes: 0 // Dérivé des points totaux pour l'instant
};

const params = new URLSearchParams(window.location.search);

const googleToken = params.get('token');
const googleUser = params.get('user');


if (googleToken) {

    localStorage.setItem('token', googleToken);

    console.log(
        "Token Google enregistré :",
        googleToken
    );
}


if (googleUser) {

    localStorage.setItem(
        'user_name',
        googleUser
    );
}



/* =========================
DEBUG GLOBAL
========================= */
function debugState(label = "STATE") {
    if (!DEBUG) return;

    console.group(`🧪 ${label}`);
    console.log("currentUsername:", currentUsername);
    console.log("userPoints:", userPoints); // Mise à jour pour le nouvel objet de points
    console.log("bonusTimer:", bonusTimer);
    console.log("notificationCount:", notificationCount);
    console.log("loadedNotificationsArray:", loadedNotificationsArray);
    console.log("localStorage user_name:", localStorage.getItem('user_name'));
    console.log("localStorage user_role:", localStorage.getItem('user_role'));
    console.log("localStorage token:", localStorage.getItem('token'));
    console.log("notif badge DOM:", document.getElementById('notif-badge'));
    console.log("loyalty DOM:", document.getElementById('display-points'));
    console.groupEnd();
}

function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.innerText = value;
}

/**
 * ==========================================
 * CACHE LOCAL (stale-while-revalidate)
 * Affiche instantanément la dernière donnée connue
 * pendant que la version fraîche est récupérée en fond.
 * ==========================================
 */
function getCache(key) {
    try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : null;
    } catch (e) {
        return null;
    }
}

function setCache(key, value) {
    try {
        localStorage.setItem(key, JSON.stringify(value));
    } catch (e) {
        // Quota dépassé ou stockage indisponible : on ignore silencieusement
    }
}

/**
 * ==========================================
 * MODE SOMBRE
 * ==========================================
 */
function toggleTheme() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}

    // Le cercle de progression utilise une couleur inline générée en JS : on le rafraîchit
    renderUserStats();
}

/**
 * ==========================================
 * NAVIGATION - onglet actif de la barre du bas
 * Compare le chemin réel de chaque lien à l'URL courante
 * plutôt que de coder l'état "actif" en dur.
 * ==========================================
 */
function setActiveBottomNav() {
    const items = document.querySelectorAll('.bottom-item');
    const currentPath = window.location.pathname;
    let matched = false;

    items.forEach(item => {
        item.classList.remove('active');
        item.removeAttribute('aria-current');

        const href = item.getAttribute('href');
        if (!href) return;
        try {
            const linkPath = new URL(href, window.location.href).pathname;
            if (linkPath === currentPath) {
                item.classList.add('active');
                item.setAttribute('aria-current', 'page');
                matched = true;
            }
        } catch (e) {}
    });

    // Cette page est l'espace personnel : si aucun lien ne correspond
    // (cas normal, car "Profil" ouvre une modale et n'a pas de href),
    // on met en avant l'onglet Profil pour refléter la page courante.
    if (!matched) {
        const profileItem = document.querySelector('.bottom-item[data-page="profile"]');
        if (profileItem) {
            profileItem.classList.add('active');
            profileItem.setAttribute('aria-current', 'page');
        }
    }
}

/**
 * ==========================================
 * STREAK DE LECTURE (jours consécutifs)
 * ==========================================
 */
function computeReadingStreak(historyItems) {
    if (!Array.isArray(historyItems) || historyItems.length === 0) return 0;

    const dayKeys = new Set(
        historyItems
            .filter(item => item.created_at)
            .map(item => {
                const d = new Date(item.created_at);
                return `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
            })
    );

    const oneDay = 24 * 60 * 60 * 1000;
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // La série doit inclure aujourd'hui ou hier pour être considérée "active"
    const todayKey = `${today.getFullYear()}-${today.getMonth()}-${today.getDate()}`;
    const yesterday = new Date(today.getTime() - oneDay);
    const yesterdayKey = `${yesterday.getFullYear()}-${yesterday.getMonth()}-${yesterday.getDate()}`;

    let cursor;
    if (dayKeys.has(todayKey)) {
        cursor = new Date(today);
    } else if (dayKeys.has(yesterdayKey)) {
        cursor = new Date(yesterday);
    } else {
        return 0;
    }

    let streak = 0;
    while (dayKeys.has(`${cursor.getFullYear()}-${cursor.getMonth()}-${cursor.getDate()}`)) {
        streak++;
        cursor = new Date(cursor.getTime() - oneDay);
    }
    return streak;
}

function renderStreak(count) {
    const badge = document.getElementById('streakBadge');
    const text = document.getElementById('streakText');
    if (!badge || !text) return;

    if (count > 0) {
        text.innerText = `${count} jour${count > 1 ? 's' : ''} de suite`;
        badge.classList.add('show');
    } else {
        badge.classList.remove('show');
    }
}

/**
 * ==========================================
 * SYSTÈME DE NOTIFICATIONS TOAST
 * (remplace les alert() natifs pour une UX plus douce)
 * ==========================================
 */
function showToast(message, type = 'info', duration = 4000) {
    const container = document.getElementById('toastContainer');
    if (!container) { console.log(message); return; }

    const icons = { success: 'check-circle', error: 'alert-circle', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.setAttribute('role', 'status');
    toast.innerHTML = `
        <div class="toast-icon"><i data-feather="${icons[type] || 'info'}"></i></div>
        <span>${message}</span>
        <button class="toast-close" aria-label="Fermer la notification">
            <i data-feather="x"></i>
        </button>
    `;
    container.appendChild(toast);
    feather.replace();

    const remove = () => {
        toast.classList.add('hide');
        setTimeout(() => toast.remove(), 250);
    };

    toast.querySelector('.toast-close').addEventListener('click', remove);
    setTimeout(remove, duration);
}

/**
 * ==========================================
 * RECHERCHE (modale) — recherche instantanée
 * dans les sections principales de l'application
 * ==========================================
 */
const searchIndex = [
    { title: "Accueil", desc: "Retour à la page d'accueil", icon: "home", link: "/famapkII/" },
    { title: "Lire la Bible", desc: "Enseignements et lectures bibliques", icon: "book-open", link: "/famapkII/bible.html" },
    { title: "Chat communautaire", desc: "Discussions chrétiennes en direct", icon: "message-circle", link: "/famapkII/chat.html" },
    { title: "Mon profil", desc: "Voir mes points et ma progression", icon: "user", action: "openProfileModal()" },
    { title: "Mes trophées", desc: "Consulter mes badges débloqués", icon: "award", anchor: "trophies" },
    { title: "Bonus quotidien", desc: "Réclamer mon bonus de fidélité", icon: "gift", anchor: "loyalty" },
    { title: "Sondage quotidien", desc: "Répondre au sondage du jour (+5 pts)", icon: "check-square", action: "startDailyPoll()" },
    { title: "Quiz biblique", desc: "Tester mes connaissances (+10 pts)", icon: "help-circle", action: "startBibleQuiz()" },
    { title: "Vidéo bonus", desc: "Regarder une vidéo inspirante (+2 pts)", icon: "monitor", action: "watchVideoAd()" },
    { title: "Chat avec l'IA", desc: "Obtenir des conseils personnalisés", icon: "message-square", action: "openAIChatModal()" }
];

function handleSearchInput(query) {
    const resultsEl = document.getElementById('searchResults');
    if (!resultsEl) return;

    const q = query.trim().toLowerCase();
    if (!q) {
        resultsEl.innerHTML = '';
        return;
    }

    const matches = searchIndex.filter(item =>
        item.title.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q)
    );

    if (matches.length === 0) {
        resultsEl.innerHTML = `<div class="search-empty">Aucun résultat pour « ${query} »</div>`;
        return;
    }

    resultsEl.innerHTML = matches.map(item => {
        const hrefAttr = item.anchor ? `href="#${item.anchor}"` : (item.link ? `href="${item.link}"` : `href="javascript:void(0)"`);
        const clickAttr = item.action
            ? `onclick="${item.action}; closeModal('searchModal');"`
            : `onclick="closeModal('searchModal');"`;
        return `
        <a class="search-result-item" ${hrefAttr} ${clickAttr}>
            <div class="search-result-icon">
				<i data-feather="${item.icon || 'search'}"></i>
			</div>
            <div class="search-result-text">
                <strong>${item.title}</strong>
                <span>${item.desc}</span>
            </div>
        </a>
    `;
    }).join('');
    feather.replace();
}

function openSearchModal() {
    const modal = document.getElementById('searchModal');
    if (!modal) return;
    modal.classList.add('show');
    const input = document.getElementById('searchInput');
    input.value = '';
    document.getElementById('searchResults').innerHTML = '';
    setTimeout(() => input.focus(), 50);
}

function openProfileModal() {
    const modal = document.getElementById('profileModal');
    if (!modal) return;

    const name = currentUsername || 'Invité';
    setText('profileModalName', name);
    setText('profileModalPoints', `${userPoints.total.toFixed(2)} points de fidélité`);
    setText('profileModalChapters', `${userPoints.bibleChapters} chapitres lus`);

    const level = calculateLevel(userPoints.total);
    setText('profileModalLevel', currentUsername ? `Niveau ${level}` : 'Connectez-vous pour voir votre progression');

    const avatarEl = document.getElementById('profileModalAvatar');
    const headerAvatar = document.getElementById('profile-avatar-initials');
    if (avatarEl && headerAvatar) avatarEl.innerText = headerAvatar.innerText;

    modal.classList.add('show');
}

function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.classList.remove('show');

    if (id === 'videoModal') {
        clearInterval(ytPollInterval);
        if (ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
            try { ytPlayer.pauseVideo(); } catch (e) { /* lecteur pas encore prêt */ }
        }
    } else if (id === 'aiChatModal') {
        // Optionnel : Réinitialiser le chat ou décharger des ressources
    }
}

function closeModalOnOverlay(event, id) {
    if (event.target && event.target.id === id) closeModal(id);
}

document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
        closeModal('searchModal');
        closeModal('profileModal');
        closeModal('logoutConfirmModal');
        closeModal('aiChatModal'); // Ferme la modale du chat IA
        const dropdown = document.getElementById('notifDropdown');
        if (dropdown) {
            dropdown.classList.remove('show');
            const trigger = document.getElementById('notif-btn');
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }
    }
});

/**
 * Génère et affiche les initiales de l'utilisateur dans l'avatar du header.
 * Si l'utilisateur n'est pas connecté, affiche des points d'interrogation.
 */
/**
 * =========================================================
 * AVATAR DU PROFIL
 * =========================================================
 *
 * Affiche la photo Google si elle existe.
 * Sinon, affiche les initiales.
 * Si aucun utilisateur n'est connecté : ??
 */
/**
 * Affiche la photo Google si elle existe.
 * Sinon, affiche les initiales de l'utilisateur.
 */
function renderProfileAvatar(username, photoUrl = null) {
    const avatarElement = document.getElementById('profile-avatar-initials');

    if (!avatarElement) return;

    // =========================================================
    // PHOTO DE PROFIL
    // =========================================================

    if (photoUrl && typeof photoUrl === 'string' && photoUrl.trim() !== '') {

        avatarElement.innerHTML = '';

        const img = document.createElement('img');

        img.src = photoUrl;
        img.alt = username || 'Photo de profil';

        img.className = 'profile-avatar-image';

        img.onerror = function () {
            // Si Google refuse l'image ou si l'URL est expirée,
            // on revient automatiquement aux initiales.
            this.remove();

            renderProfileAvatar(username, null);
        };

        avatarElement.appendChild(img);

        avatarElement.classList.add('has-profile-photo');

        return;
    }

    // =========================================================
    // AUCUNE PHOTO → INITIALES
    // =========================================================

    avatarElement.classList.remove('has-profile-photo');

    if (username && username !== 'Invité') {

        const parts = username.trim().split(/\s+/);

        let initials = '??';

        if (parts.length > 1) {

            initials = (
                parts[0].charAt(0) +
                parts[1].charAt(0)
            ).toUpperCase();

        } else if (username.length >= 2) {

            initials = username
                .substring(0, 2)
                .toUpperCase();

        } else if (username.length === 1) {

            initials = username.toUpperCase();
        }

        avatarElement.innerText = initials;

    } else {

        avatarElement.innerText = '??';
    }
}


/**
 * =========================================================
 * RÉCUPÉRATION DU PROFIL DEPUIS LE BACKEND
 * =========================================================
 *
 * Récupère :
 * - username
 * - nom
 * - prénom
 * - email
 * - photo Google
 *
 * La photo est ensuite utilisée par l'avatar.
 */
async function loadUserProfilePhoto() {

    const token = localStorage.getItem('token');

    if (!token) {
        return;
    }

    try {

        const response = await fetch(
            `${API_BASE_URL}/api/mobile/user/me`,
            {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Accept': 'application/json'
                }
            }
        );

        if (!response.ok) {

            console.warn(
                `Impossible de récupérer le profil : HTTP ${response.status}`
            );

            return;
        }

        const data = await response.json();

        if (
            !data ||
            data.status !== 'success' ||
            !data.userData
        ) {

            console.warn(
                'Réponse profil utilisateur invalide :',
                data
            );

            return;
        }

        const userData = data.userData;

        // =================================================
        // Synchronisation du nom
        // =================================================

        if (userData.username) {

            currentUsername = userData.username;

            localStorage.setItem(
                'user_name',
                userData.username
            );
        }

        // =================================================
        // Sauvegarde de la photo localement
        // =================================================

        if (userData.photo) {

            localStorage.setItem(
                'user_photo',
                userData.photo
            );

        } else {

            localStorage.removeItem('user_photo');
        }

        // =================================================
        // Affichage de l'avatar
        // =================================================

        renderProfileAvatar(
            currentUsername,
            userData.photo || null
        );

        // =================================================
        // Mise à jour du message de bienvenue
        // =================================================

        const welcomeTitle =
            document.getElementById('welcome-user-title');

        if (welcomeTitle) {

            welcomeTitle.innerText =
                `Bonjour ${currentUsername || 'Invité'} 🙏`;
        }

        console.log(
            '✅ Profil utilisateur chargé :',
            {
                username: currentUsername,
                photo: userData.photo
            }
        );

    } catch (error) {

        console.warn(
            'Impossible de récupérer le profil utilisateur :',
            error
        );

        // =================================================
        // FALLBACK : utiliser éventuellement la photo déjà
        // présente dans le localStorage
        // =================================================

        const cachedPhoto =
            localStorage.getItem('user_photo');

        if (currentUsername) {

            renderProfileAvatar(
                currentUsername,
                cachedPhoto || null
            );
        }
    }
		}

		document.addEventListener("DOMContentLoaded", async () => {
			feather.replace();
			

			currentUsername = localStorage.getItem('user_name');

		// Affichage immédiat depuis le cache
		const cachedPhoto = localStorage.getItem('user_photo');

		renderProfileAvatar(
			currentUsername,
			cachedPhoto || null
		);

		if (currentUsername) {
			await updateLoginStreak();
		}

		setActiveBottomNav();

		const welcomeTitle =
			document.getElementById('welcome-user-title');

		if (welcomeTitle) {
			welcomeTitle.innerText =
				`Bonjour ${currentUsername || 'Invité'} 🙏`;
		}

		// =========================================================
		// Récupération de la photo fraîche depuis le serveur
		// =========================================================

		if (currentUsername) {

			loadUserProfilePhoto();
		}

    // Récupère la vidéo bonus définie par l'admin (visible même en mode invité,
    // mais les points ne sont attribués qu'aux utilisateurs connectés)
    fetchVideoBonusSettings().then(() => updateEarnCardsState());
    // Récupère le dernier lien de mise à jour publié (repli si une notif SSE arrive sans URL)
    fetchAppUpdateSettings();

    if (currentUsername) {
        // Affiche d'abord instantanément ce qu'on a en cache local (pas
        // d'écran vide le temps du chargement), PUIS récupère la vraie
        // liste côté serveur (avec son état "lu" fiable, peu importe si
        // l'utilisateur était déconnecté quand les notifs sont arrivées).
        loadNotificationsFromStorage();
        renderNotificationBadge();
        renderVerticalDropdownMenu();
        fetchNotificationsFromServer();

        loadLoyaltyData();
        loadActivities(); // Charger la première page d'activités
        initRealtimeNotifications();
        updateEarnCardsState(); // Affiche l'état des activités du jour (fait/verrouillé) et l'objectif quotidien
       
    } else {
        console.warn("Mode invité : Certaines fonctionnalités sont désactivées.");
        // Explicitly set guest states
        setText('display-points', '0.00 Points');
        document.getElementById('loyalty-action-container').innerHTML = `
            <button class="loyalty-action-btn" disabled>
                <i data-feather="lock"></i> Connectez-vous pour le bonus
            </button>
        `;
        const activityDisplayArea = document.getElementById('activity-display-area');
        if (activityDisplayArea) {
            activityDisplayArea.innerHTML = `
                <div style="padding: 20px; text-align: center; color: var(--muted); font-size: 0.9rem;">
                    Connectez-vous pour voir vos activités récentes.
                </div>
            `;
        }
        renderUserStats(); // Cela affichera les stats (prière, leçons, versets) avec les valeurs par défaut (0 ou '...')
        feather.replace(); // Assurez-vous que les nouvelles icônes sont rendues
    }
    debugState("DÉMARRAGE");

    // Écouteur pour le bouton flottant du chat IA
    const openAIChatFab = document.getElementById('openAIChatFab');
    if (openAIChatFab) {
        openAIChatFab.addEventListener('click', openAIChatModal);
    }

    // Met en pause le compte à rebours du bonus quand l'onglet est masqué
    // (économie CPU/batterie sur mobile), et le reprend au retour.
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            if (window.loyaltyCountdownInterval) {
                clearInterval(window.loyaltyCountdownInterval);
                window.loyaltyCountdownInterval = null;
            }
        } else if (window.loyaltyUpdateTimerFn && !window.loyaltyCountdownInterval) {
            window.loyaltyUpdateTimerFn();
            window.loyaltyCountdownInterval = setInterval(window.loyaltyUpdateTimerFn, 1000);
        }
    });
});

/**
 * ==========================================
 * CHAT IA MODALE
 * ==========================================
 */

function openAIChatModal() {
    const modal = document.getElementById('aiChatModal');
    if (!modal) return;
    modal.classList.add('show');
    const input = document.getElementById('aiChatInput');
    if (input) {
        input.value = '';
        setTimeout(() => input.focus(), 50); // Focus sur l'input après l'ouverture
    }
    scrollToBottom('chatMessages'); // Assure que le chat est défilé vers le bas
}

// Attach event listener for Enter key in the AI chat input
document.addEventListener('DOMContentLoaded', () => {
    const aiChatInput = document.getElementById('aiChatInput');
    if (aiChatInput) {
        aiChatInput.addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                sendMessageToAI();
            }
        });
    }
});


/**
 * Ajoute un message au conteneur du chat.
 * @param {string} sender 'user' ou 'ai'
 * @param {string} message Le contenu du message.
 */
function displayMessage(sender, message) {
    const chatMessages = document.getElementById('chatMessages');
    if (!chatMessages) return;

    const messageElement = document.createElement('div');
    if (sender === 'user') {
        messageElement.className = 'user-message';
        messageElement.innerText = message;
    } else {
        messageElement.className = 'ai-message';
        messageElement.innerHTML = `
            <div class="ai-message-icon"><i data-feather="feather"></i></div>
            <div class="ai-message-content">${message}</div>
        `;
    }
    chatMessages.appendChild(messageElement);
    feather.replace(); // Pour les nouvelles icônes dans les messages IA
    scrollToBottom('chatMessages');
}

/**
 * Fait défiler le conteneur du chat jusqu'en bas.
 * @param {string} containerId L'ID du conteneur à faire défiler.
 */
function scrollToBottom(containerId) {
    const container = document.getElementById(containerId);
    if (container) {
        container.scrollTop = container.scrollHeight;
    }
}

/**
 * Envoie un message à l'IA et affiche sa réponse via l'API Symfony.
 */
async function sendMessageToAI() {
    const input = document.getElementById('aiChatInput');
    const userText = input.value.trim();

    if (userText === '') return;

    displayMessage('user', userText);
    input.value = '';

    // Indicateur de "l'IA écrit..."
    const loadingMessageId = 'ai-typing-indicator';
    const loadingMessageElement = document.createElement('div');

    loadingMessageElement.id = loadingMessageId;
    loadingMessageElement.className = 'ai-message';

    loadingMessageElement.innerHTML = `
        <div class="ai-message-icon">
            <i data-feather="feather"></i>
        </div>
        <div class="ai-message-content">
            L'IA analyse votre parcours...
        </div>
    `;

    document.getElementById('chatMessages').appendChild(loadingMessageElement);

    feather.replace();
    scrollToBottom('chatMessages');

    try {

        const response = await fetch(`${API_BASE_URL}/api/coach/advice`, {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + localStorage.getItem('token'),
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                message: userText
            })
        });

        /*
         * IMPORTANT :
         * On lit le body UNE SEULE FOIS.
         */
        const rawText = await response.text();

        let data = null;

        try {
            data = JSON.parse(rawText);
        } catch (jsonError) {

            console.error(
                "Réponse brute du serveur :",
                rawText
            );

            throw new Error(
                "Le serveur n'a pas renvoyé de JSON valide."
            );
        }

        // Supprime l'indicateur de chargement
        const chatMessages = document.getElementById('chatMessages');
        const existingLoading =
            chatMessages.querySelector(`#${loadingMessageId}`);

        if (existingLoading) {
            existingLoading.remove();
        }

        let aiResponse =
            "Je n'ai pas pu récupérer votre conseil pour le moment.";

        if (response.ok && data.success) {

            aiResponse =
                data.advice ||
                "Aucun conseil n'a été généré.";

        } else if (data.error) {

            aiResponse = data.error;

        } else if (!response.ok) {

            aiResponse =
                `Erreur du serveur (${response.status}).`;
        }

        displayMessage('ai', aiResponse);
        scrollToBottom('chatMessages');

    } catch (error) {

        console.error(
            "Erreur de connexion avec l'API du coach :",
            error
        );

        // Nettoyage de l'indicateur
        const chatMessages =
            document.getElementById('chatMessages');

        const existingLoading =
            chatMessages.querySelector(`#${loadingMessageId}`);

        if (existingLoading) {
            existingLoading.remove();
        }

        let displayError;

        if (error.message.includes("JSON valide")) {
            displayError = error.message;
        } else {
            displayError =
                "Erreur de connexion avec le serveur. Veuillez réessayer plus tard.";
        }

        displayMessage('ai', displayError);
        scrollToBottom('chatMessages');
    }
}

/**
 * Fonction pour obtenir la prochaine classe de couleur d'icône d'activité
 */
function getNextActivityIconColorClass() {
    const colorClass = activityIconColors[activityColorIndex];
    activityColorIndex = (activityColorIndex + 1) % activityIconColors.length;
    return colorClass;
}

/**
 * Observe les éléments d'activité pour appliquer une animation quand ils entrent dans la vue.
 */
function observeActivityElements() {
    const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target); // Cesse d'observer une fois l'animation appliquée
            }
        });
    }, { threshold: 0.1 }); // Se déclenche quand 10% de l'élément est visible

    document.querySelectorAll('#activity-display-area .activity-item').forEach(item => {
        observer.observe(item);
    });
}

/**
 * Formatte une date pour l'affichage et le regroupement, ex: "aujourd'hui", "hier", ou "15 juillet 2024"
 * @param {string | Date} dateInput
 * @returns {string} Date formatée
 */
function formatDateForDisplay(dateInput) {
    const date = new Date(dateInput);
    date.setHours(0, 0, 0, 0); // Normaliser à minuit pour comparaison

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const yesterday = new Date(today);
    yesterday.setDate(today.getDate() - 1);

    const diff = today.getTime() - date.getTime();
    const oneDay = 24 * 60 * 60 * 1000;

    if (diff < oneDay && date.getTime() === today.getTime()) {
        return "Aujourd'hui";
    } else if (diff < (2 * oneDay) && date.getTime() === yesterday.getTime()) {
        return "Hier";
    } else {
        return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
    }
}

/**
 * Met à jour le petit indicateur de connexion temps réel affiché sur la cloche
 * de notifications (vert = connecté, orange pulsant = reconnexion en cours).
 */
function updateSseStatus(state) {
    const dot = document.getElementById('sseStatus');
    if (!dot) return;
    dot.classList.remove('connected', 'reconnecting');
    if (state === 'connected') {
        dot.classList.add('connected');
        dot.title = 'Connecté en direct';
    } else {
        dot.classList.add('reconnecting');
        dot.title = 'Reconnexion en cours...';
    }
}

/**
 * ==========================================
 * NOTIFICATIONS EN TEMPS RÉEL (SSE)
 * ==========================================
 */
function initRealtimeNotifications() {
    console.log("Démarrage du flux SSE sur :", `${API_BASE_URL}/api/notifications/stream`);
    
    const eventSource = new EventSource(`${API_BASE_URL}/api/notifications/stream?username=${encodeURIComponent(currentUsername)}`);
    let wasConnected = false;

    eventSource.onopen = function() {
        updateSseStatus('connected');
        if (!wasConnected) {
            wasConnected = true;
        } else {
            showToast("Connexion en direct rétablie.", "success", 2500);
        }
    };

    eventSource.onmessage = function(event) {
        if (!event.data || event.data.trim() === "" || event.data.includes("ping")) {
            return; 
        }

        try {
            const data = JSON.parse(event.data);
            console.log("Flux SSE reçu avec succès :", data);

            if (!data || !data.message) return;

            if (typeof loadedNotificationsArray !== 'undefined') {
                const dejavu = loadedNotificationsArray.some(n => n.realId === data.id);
                if (dejavu) return; 
            }

            let iconType = 'article'; 
            let iconName = 'book-open';
            let directLink = '/famapkII/index.html';

            if (
                data.type === 'app_update' ||
                data.message.toLowerCase().includes('application') ||
                data.message.toLowerCase().includes('apk')
            ) {
                // Nouvelle version de l'application : ouvrira une popup (téléchargement + QR code)
                // au clic, au lieu de naviguer vers un lien classique.
                iconType = 'app_update';
                iconName = 'smartphone';
                directLink = '#';
                if (data.url) currentAppUpdateUrl = data.url;
            } else if (data.type === 'new_badge' || data.message.includes('badge') || data.message.includes('Trophée')) {
                iconType = 'badge';
                iconName = 'award';
                directLink = '#';
            } else if (data.type === 'chat' || data.message.includes('Chat') || data.message.includes('message')) {
                iconType = 'chat';
                iconName = 'message-square';
                directLink = '../../chat.html';
            }

            loadedNotificationsArray.unshift({
                id: Date.now(), 
                realId: data.id, 
                type: iconType,
                icon: iconName,
                message: data.message,
                time: 'À l\'instant',
                unread: true,
                link: directLink,
                apkUrl: iconType === 'app_update' ? (data.url || currentAppUpdateUrl || null) : null
            });

            notificationCount = loadedNotificationsArray.filter(n => n.unread).length;
            saveNotificationsToStorage();
            renderNotificationBadge();
            renderVerticalDropdownMenu();

            const activityList = document.getElementById('activity-display-area');
            if (activityList) {
                const newItem = document.createElement('div');
                newItem.className = `activity-item is-visible`; // Ajoute is-visible pour l'animation
                newItem.style.border = '2px solid var(--secondary)';
                newItem.innerHTML = `
                    <div class="activity-icon ${getNextActivityIconColorClass()}">
                        <i data-feather="${iconName}"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-title" style="color:var(--secondary);">Nouveau !</div>
                        <div class="activity-text">${data.message}</div>
                    </div>
                `;
                activityList.insertBefore(newItem, activityList.firstChild);
                feather.replace();
            }

            if (window.Notification && Notification.permission === "granted") {
                new Notification("Apokalypsy", { body: data.message });
            }

        } catch (error) {
            console.error("Erreur lors de l'analyse JSON du flux SSE :", error);
        }
    };

    eventSource.onerror = function(err) {
        console.log("Le tuyau SSE s'est déconnecté ou cherche à joindre le serveur. En attente...");
        updateSseStatus('reconnecting');
    };

    // État initial : en cours de connexion
    updateSseStatus('reconnecting');

    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('notifDropdown');
        const trigger = document.getElementById('notif-btn');
        if (dropdown && !dropdown.contains(event.target) && !trigger.contains(event.target)) {
            dropdown.classList.remove('show');
        }
    });
}

function toggleNotifMenu(event) {
    event.stopPropagation();
    const dropdown = document.getElementById('notifDropdown');
    const trigger = document.getElementById('notif-btn');
    if (dropdown) {
        const isOpen = dropdown.classList.toggle('show');
        if (trigger) trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }
}

function renderNotificationBadge() {
    const badge = document.getElementById('notif-badge');
    if (!badge) return;

    if (notificationCount > 0) {
        badge.innerText = notificationCount;
        badge.style.display = 'flex';
        badge.classList.add('pulse-animation');
        setTimeout(() => badge.classList.remove('pulse-animation'), 500);
    } else {
        badge.innerText = '0';
        badge.style.display = 'none';
    }
}

function renderVerticalDropdownMenu() {
    const container = document.getElementById('notifVerticalList');
    if (!container) return;

    if (loadedNotificationsArray.length === 0) {
        container.innerHTML = `
            <div style="padding: 24px 20px; text-align: center; color: var(--muted); font-size: 0.82rem;">
                <div class="notif-empty-icon"><i data-feather="bell-off"></i></div>
                Aucune nouvelle notification reçue.
            </div>
        `;
        feather.replace();
        return;
    }

    container.innerHTML = loadedNotificationsArray.map(notif => {
        const isAppUpdate = notif.type === 'app_update';
        // Pour une mise à jour d'app : pas de navigation, on ouvre la popup
        // (téléchargement + QR code) avec le lien embarqué dans la notif.
        const href = isAppUpdate ? 'javascript:void(0)' : notif.link;
        const safeUrl = isAppUpdate && notif.apkUrl ? `'${notif.apkUrl.replace(/'/g, "\\'")}'` : 'null';
        const clickHandler = isAppUpdate
            ? `markOneAsRead(${notif.id}); openAppUpdateModal(${safeUrl})`
            : `markOneAsRead(${notif.id})`;

        return `
        <a href="${href}" class="notif-item ${notif.unread ? 'unread' : ''}" onclick="${clickHandler}">
            <div class="notif-item-icon ${notif.type}">
                <i data-feather="${notif.icon || 'bell'}"></i>
            </div>
            <div class="notif-details">
                <span class="notif-message">${notif.message}</span>
                <span class="notif-time">${notif.time}</span>
            </div>
        </a>
    `;
    }).join('');

    feather.replace();
}

function markOneAsRead(id) {
    const notif = loadedNotificationsArray.find(n => n.id === id);
    if (notif && notif.unread) {
        notif.unread = false;
        if (notificationCount > 0) notificationCount--;
        saveNotificationsToStorage();
        renderNotificationBadge();
        renderVerticalDropdownMenu();
        markNotificationReadOnServer(notif.realId || notif.id);
    }
}

function markAllAsRead(event) {
    event.stopPropagation();
    loadedNotificationsArray.forEach(n => n.unread = false);
    notificationCount = 0;
    saveNotificationsToStorage();
    renderNotificationBadge();
    renderVerticalDropdownMenu();
    markAllNotificationsReadOnServer();
}

if (window.Notification && Notification.permission !== "denied" && Notification.permission !== "granted") {
    Notification.requestPermission();
}

function requestEspaceLogout(){
    // Nom volontairement unique (pas "logout") : functions.js, chargé sur
    // cette même page, déclare AUSSI une fonction globale "logout()" (pour
    // la page d'accueil, avec sa propre logique liée au sélecteur de
    // langue). En JavaScript, deux fonctions globales du même nom se
    // écrasent l'une l'autre — celle chargée en dernier gagne. C'est ce qui
    // provoquait le crash "Cannot read properties of null (reading 'value')" :
    // la fonction logout() de functions.js s'exécutait à la place de la
    // nôtre. On utilise donc un nom garanti unique sur cette page.
    const modal = document.getElementById('logoutConfirmModal');
    if (modal) {
        modal.classList.add('show');
    } else {
        // Filet de sécurité si jamais la modale n'existe pas sur une page.
        performEspaceLogout();
    }
}

function performEspaceLogout(){
    localStorage.removeItem('user_name');
    localStorage.removeItem('user_role');
    localStorage.removeItem('token');

    // Détection automatique du chemin de base pour GitHub Pages ou Localhost
    const isGitHubPages = window.location.hostname.includes("github.io");
    const basePath = isGitHubPages ? "/famapkII" : "";

    window.location.href = basePath + "/index.html";
}

/* =========================
   GAINS DE POINTS SUPPLÉMENTAIRES (Cointiply-like)
========================= */

async function awardPoints(points, reason) {
    if (!currentUsername) {
        showToast("Veuillez vous connecter pour gagner des points.", "error");
        return false;
    }
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${API_BASE_URL}/api/points/add`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
                username: currentUsername,
                points: points,
                reason: reason
            })
        });

        const result = await response.json();
        if (result.success) {
            userPoints.total = parseFloat(userPoints.total) + points; // Mise à jour locale immédiate
            renderUserStats();
            showToast(`🎉 Vous avez gagné ${points} points !`, "success");
            return true;
        } else {
            showToast(`Erreur : ${result.message}`, "error");
            return false;
        }
    } catch (error) {
        console.error("Erreur lors de l'attribution des points :", error);
        showToast("Impossible de se connecter au serveur de points.", "error");
        return false;
    }
}

/**
 * ==========================================
