                                    Vos dernières activités
                                </span>
                            </div>

                        </div>

                        <span
                            class="mark-all-read"
                            role="button"
                            tabindex="0"
                            onclick="markAllAsRead(event)"
                        >
                            Tout lire
                        </span>

                    </div>


                    <div class="notif-tabs">
                        <span class="notif-tab active">
                            Tout
                        </span>
                    </div>


                    <div
                        class="notif-list"
                        id="notifVerticalList"
                    ></div>

                </div>

            </div>


            <!-- PROFIL -->
            <button
                class="profile-avatar"
                id="profile-avatar-initials"
                aria-label="Ouvrir mon profil"
                title="Mon profil"
                onclick="openProfileModal()"
            >
                ??
            </button>

        </div>

    </div>

</header>



