/* =========================================================
 * QUIZ BIBLIQUE LOCAL
 * Source : data/bible_content.js
 *
 * window.fullBibleContent
 * ├── mg
 * ├── fr
 * └── en
 * ========================================================= */

const BIBLE_QUIZ_QUESTIONS_PER_GAME = 5;

let bibleQuizState = {
    language: 'fr',
    questions: [],
    currentIndex: 0,
    correctCount: 0,
    totalPoints: 0,
    answering: false
};


/* =========================================================
 * HISTORIQUE DES QUESTIONS
 * ========================================================= */

function getBibleQuizHistoryKey() {

    return `bible_quiz_history_${
        currentUsername || 'guest'
    }_${bibleQuizState.language}`;

}


function getBibleQuizHistory() {

    try {

        const value =
            localStorage.getItem(
                getBibleQuizHistoryKey()
            );

        return value
            ? JSON.parse(value)
            : [];

    } catch (error) {

        console.warn(
            'Impossible de lire l’historique du quiz.',
            error
        );

        return [];
    }
}


function saveBibleQuizHistory(history) {

    try {

        /*
         * On conserve seulement les 500 derniers passages.
         */
        const cleanHistory =
            history.slice(-500);

        localStorage.setItem(
            getBibleQuizHistoryKey(),
            JSON.stringify(cleanHistory)
        );

    } catch (error) {

        console.warn(
            'Impossible de sauvegarder l’historique du quiz.',
            error
        );
    }
}


/* =========================================================
 * MÉLANGER UN TABLEAU
 * ========================================================= */

function shuffleArray(array) {

    const copy = [...array];

    for (
        let i = copy.length - 1;
        i > 0;
        i--
    ) {

        const j =
            Math.floor(
                Math.random() * (i + 1)
            );

        [
            copy[i],
            copy[j]
        ] = [
            copy[j],
            copy[i]
        ];
    }

    return copy;
}


/* =========================================================
 * EXTRAIRE LES VERSETS
 * ========================================================= */

function getBibleVersePool(language) {

    if (
        !window.fullBibleContent ||
        !window.fullBibleContent[language]
    ) {

        console.error(
            '❌ Bible introuvable pour la langue :',
            language
        );

        return [];
    }

    const bible =
        window.fullBibleContent[language];

    const pool = [];

    if (!Array.isArray(bible.books)) {
        return pool;
    }

    bible.books.forEach(book => {

        if (!Array.isArray(book.chapters)) {
            return;
        }

        book.chapters.forEach(chapter => {

            if (!Array.isArray(chapter.verses)) {
                return;
            }

            chapter.verses.forEach(
                (verseText, verseIndex) => {

                    if (
                        typeof verseText !== 'string' ||
                        !verseText.trim()
                    ) {
                        return;
                    }

                    pool.push({

                        id:
                            `${language}_${book.number}_` +
                            `${chapter.chapter}_` +
                            `${verseIndex + 1}`,

                        book:
                            book.name,

                        bookNumber:
                            book.number,

                        chapter:
                            chapter.chapter,

                        verse:
                            verseIndex + 1,

                        text:
                            verseText.trim()

                    });

                }
            );

        });

    });

    return pool;
}


/* =========================================================
 * CRÉER UNE QUESTION
 *
 * Pour commencer, on utilise une question extrêmement
 * fiable puisqu'elle est directement déduite de la Bible :
 *
 * "Dans quel livre trouve-t-on ce passage ?"
 *
 * Cela permet de générer automatiquement des milliers
 * de questions lorsque bible_content.js sera complet.
 * ========================================================= */

function createBibleQuestion(verse, pool, language) {

    const otherBooks = [
        ...new Set(
            pool
                .map(item => item.book)
                .filter(
                    book =>
                        book !== verse.book
                )
        )
    ];

    if (otherBooks.length < 3) {
        return null;
    }

    const distractors =
        shuffleArray(otherBooks)
            .slice(0, 3);

    const options =
        shuffleArray([
            verse.book,
            ...distractors
        ]);

    const correctIndex =
        options.indexOf(
            verse.book
        );

    const questions = {

        fr: {
            text:
                `Dans quel livre de la Bible ` +
                `trouve-t-on ce passage ?\n\n` +
                `« ${verse.text} »`
        },

        mg: {
            text:
                `Ao amin'ny boky inona ao amin'ny Baiboly ` +
                `no ahitana ity andininy ity ?\n\n` +
                `« ${verse.text} »`
        },

        en: {
            text:
                `In which book of the Bible ` +
                `can this passage be found?\n\n` +
                `“${verse.text}”`
        }

    };

    return {

        id:
            `bible_${verse.id}`,

        type:
            'book_identification',

        language,

        question:
            questions[language]?.text ||
            questions.fr.text,

        options,

        correctIndex,

        book:
            verse.book,

        chapter:
            verse.chapter,

        verse:
            verse.verse,

        sourceId:
            verse.id,

        points:
            0.25

    };
}


/* =========================================================
 * GÉNÉRER 5 QUESTIONS UNIQUES
 * ========================================================= */

function generateBibleQuizQuestions(language) {

    const pool =
        getBibleVersePool(language);

    if (pool.length < 1) {

        throw new Error(
            `Aucun verset disponible en ${
                language
            }.`
        );
    }

    const history =
        getBibleQuizHistory();

    const usedIds =
        new Set(history);

    /*
     * On essaie d'abord de choisir des versets
     * qui n'ont jamais été utilisés.
     */
    let available =
        pool.filter(
            verse =>
                !usedIds.has(verse.id)
        );

    /*
     * Si la petite Bible actuelle est épuisée,
     * on recommence à utiliser les anciens versets.
     *
     * Cela garantit que le quiz reste disponible
     * 24h/24 et 7j/7.
     */
    if (available.length < BIBLE_QUIZ_QUESTIONS_PER_GAME) {

        available =
            shuffleArray(pool);
    } else {

        available =
            shuffleArray(available);
    }

    const questions = [];

    for (
        const verse of available
    ) {

        if (
            questions.length >=
            BIBLE_QUIZ_QUESTIONS_PER_GAME
        ) {
            break;
        }

        const question =
            createBibleQuestion(
                verse,
                pool,
                language
            );

        if (!question) {
            continue;
        }

        questions.push(question);

    }

    if (
        questions.length <
        BIBLE_QUIZ_QUESTIONS_PER_GAME
    ) {

        throw new Error(
            'Pas assez de données bibliques pour générer ' +
            '5 questions. Ajoutez davantage de livres ' +
            'dans bible_content.js.'
        );
    }

    /*
     * Enregistrer les passages utilisés.
     */
    saveBibleQuizHistory([
        ...history,
        ...questions.map(
            question =>
                question.sourceId
        )
    ]);

    return questions;
}


/* =========================================================
 * CHANGER LA LANGUE
 * ========================================================= */

function changeBibleQuizLanguage(language) {

    if (
        !['fr', 'mg', 'en'].includes(language)
    ) {
        language = 'fr';
    }

    bibleQuizState.language =
        language;

    /*
     * Si le quiz est déjà ouvert,
     * on le reconstruit immédiatement.
     */
    try {

        startBibleQuiz();

    } catch (error) {

        console.error(
            'Erreur changement langue :',
            error
        );

    }
}


/* =========================================================
 * DÉMARRER LE QUIZ BIBLIQUE
 * ========================================================= */
function startBibleQuiz() {

    if (!currentUsername) {

        showToast(
            "Veuillez vous connecter pour participer.",
            "error"
        );

        return;
    }

    try {

        const language =
            document.getElementById(
                'quizLanguage'
            )?.value ||
            bibleQuizState.language ||
            'fr';

        bibleQuizState = {

            language,

            questions:
                generateBibleQuizQuestions(
                    language
                ),

            currentIndex: 0,

            correctCount: 0,

            totalPoints: 0,

            answering: false

        };

        renderBibleQuizQuestion();

        const modal =
            document.getElementById(
                'quizModal'
            );

        if (modal) {

            modal.classList.add(
                'show'
            );
        }

        if (
            typeof feather !== 'undefined'
        ) {

            feather.replace();
        }

    } catch (error) {

        console.error(
            '❌ Erreur démarrage quiz :',
            error
        );

        showToast(
            error.message ||
            "Impossible de démarrer le quiz biblique.",
            "error"
        );
    }
}


/* =========================================================
 * AFFICHER LA QUESTION
 * ========================================================= */

function renderBibleQuizQuestion() {

    const question =
        bibleQuizState.questions[
            bibleQuizState.currentIndex
        ];

    if (!question) {
        return;
    }

    const total =
        bibleQuizState.questions.length;

    const current =
        bibleQuizState.currentIndex + 1;

    setText(
        'quizQuestionText',
        question.question
    );

    setText(
        'quizStepLabel',
        `Question ${current}/${total}`
    );

    setText(
        'quizPointsLabel',
        `⭐ ${bibleQuizState.totalPoints.toFixed(2)} pt`
    );

    const progress =
        document.getElementById(
            'quizProgressFill'
        );

    if (progress) {

        progress.style.width =
            `${(current / total) * 100}%`;
    }

    const list =
        document.getElementById(
            'quizOptionsList'
        );

    if (!list) {
        return;
    }

    list.innerHTML = '';

    question.options.forEach(
        (option, index) => {

            const button =
                document.createElement(
                    'button'
                );

            button.type = 'button';

            button.className =
                'poll-option-btn quiz-option-btn';

            button.textContent =
                option;

            button.addEventListener(
                'click',
                () =>
                    submitBibleQuizAnswer(
                        index
                    )
            );

            list.appendChild(
                button
            );

        }
    );
}

/* =========================================================
 * RÉPONDRE AU QUIZ BIBLIQUE
 * ========================================================= */

async function submitBibleQuizAnswer(index) {

    if (
        bibleQuizState.answering
    ) {
        return;
    }

    const question =
        bibleQuizState.questions[
            bibleQuizState.currentIndex
        ];

    if (!question) {
        return;
    }

    bibleQuizState.answering =
        true;

    const buttons =
        document.querySelectorAll(
            '#quizOptionsList .quiz-option-btn'
        );

    buttons.forEach(
        (button, i) => {

            button.disabled = true;

            if (i === index) {

                button.classList.add(
                    'selected'
                );
            }

        }
    );

    const isCorrect =
        index === question.correctIndex;

    if (!isCorrect) {

        showToast(
            bibleQuizState.language === 'mg'
                ? "❌ Diso ny valiny. Avereno indray!"
                : bibleQuizState.language === 'en'
                    ? "❌ Wrong answer. Try again!"
                    : "❌ Mauvaise réponse. Recommencez !",
            "error"
        );

        setTimeout(() => {

            bibleQuizState.questions = [];

            bibleQuizState.currentIndex = 0;

            bibleQuizState.correctCount = 0;

            bibleQuizState.totalPoints = 0;

            bibleQuizState.answering = false;

            closeModal(
                'quizModal'
            );

        }, 1000);

        return;
    }

    /*
     * Bonne réponse
     */
    bibleQuizState.correctCount++;

    bibleQuizState.totalPoints +=
        question.points;

    showToast(
        bibleQuizState.language === 'mg'
            ? "✅ Marina! Tsara ny valiny."
            : bibleQuizState.language === 'en'
                ? "✅ Correct answer!"
                : "✅ Bonne réponse !",
        "success"
    );

    /*
     * Les 5 questions sont terminées.
     */
    if (
        bibleQuizState.currentIndex >=
        bibleQuizState.questions.length - 1
    ) {

        await completeBibleQuiz();

        return;
    }

    /*
     * Question suivante
     */
    setTimeout(() => {

        bibleQuizState.currentIndex++;

        bibleQuizState.answering =
            false;

        renderBibleQuizQuestion();

    }, 650);
}

/* =========================================================
 * FIN DU QUIZ
 * ========================================================= */

async function completeBibleQuiz() {

    const total =
        bibleQuizState.totalPoints;

    const correct =
        bibleQuizState.correctCount;

    /*
     * Pour le moment, affichage local.
     *
     * L'étape suivante consiste à connecter cette
     * validation au serveur afin que les points soient
     * attribués de manière sécurisée.
     */

    showToast(
        bibleQuizState.language === 'mg'
            ? `🎉 Vita! ${correct}/5 valiny marina. +${total.toFixed(2)} isa!`
            : bibleQuizState.language === 'en'
                ? `🎉 Completed! ${correct}/5 correct answers. +${total.toFixed(2)} points!`
                : `🎉 Bravo ! ${correct}/5 bonnes réponses. +${total.toFixed(2)} points !`,
        "success"
    );

    /*
     * Affichage du résultat
     */
    const resultBox =
        document.getElementById(
            'quizResultBox'
        );

    if (resultBox) {

        resultBox.style.display =
            'block';

        resultBox.innerHTML = `
            <div style="text-align:center;">
                <div style="font-size:2.5rem;">🏆</div>

                <strong>
                    ${correct}/5
                </strong>

                <div>
                    +${total.toFixed(2)} points
                </div>
            </div>
        `;
    }

    bibleQuizState.answering =
        false;

    setTimeout(() => {

        closeModal(
            'quizModal'
        );

        if (resultBox) {

            resultBox.style.display =
                'none';
        }

    }, 1800);
}

/* ---------- SONDAGE QUOTIDIEN DYNAMIQUE ---------- */
let currentPoll = null; // Stocke le sondage actuel

/* =========================================================
 * SONDAGE BIBLIQUE — 5 QUESTIONS
 * =========================================================
 *
 * Fonctionnement :
 * 1. Le serveur fournit les questions.
 * 2. L'utilisateur répond aux questions 1 → 5.
 * 3. Une mauvaise réponse annule la tentative.
 * 4. L'utilisateur recommence depuis la question 1.
 * 5. Les points ne sont attribués qu'après 5 bonnes réponses.
 * 6. Aucun blocage quotidien.
 * ========================================================= */

let pollQuizState = {
    questions: [],
    currentIndex: 0,
    totalPoints: 0,
    answering: false
};


/* =========================================================
 * DÉMARRER LE SONDAGE
 * ========================================================= */

async function startDailyPoll() {

    if (!currentUsername) {
        showToast(
            "Veuillez vous connecter pour participer.",
            "error"
        );
        return;
    }

    // Réinitialisation complète de la tentative
    pollQuizState = {
        questions: [],
        currentIndex: 0,
        totalPoints: 0,
        answering: false
    };

    try {

        console.log("📖 Chargement du sondage biblique...");

        const response = await fetch(
            DAILY_POLL_API_URL,
            {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                },
                cache: 'no-store'
            }
        );

        const contentType =
            response.headers.get('content-type') || '';

        if (!contentType.includes('application/json')) {

            const text = await response.text();

            console.error(
                "❌ Réponse non JSON :",
                text
            );

            throw new Error(
                `Réponse serveur invalide (HTTP ${response.status})`
            );
        }

        const data = await response.json();

        console.log(
            "📖 Sondage reçu :",
            data
        );

        if (
            !response.ok ||
            !data.success ||
            !Array.isArray(data.polls) ||
            data.polls.length === 0
        ) {

            throw new Error(
                data.message ||
                "Aucun sondage biblique disponible."
            );
        }

        /*
         * Le serveur doit fournir les 5 questions.
         */
        pollQuizState.questions = data.polls.slice(0, 5);

        if (pollQuizState.questions.length < 5) {

            throw new Error(
                "Le serveur n'a pas fourni les 5 questions nécessaires."
            );
        }

        /*
         * Affichage de la première question
         */
        renderPollQuestion();

        const modal =
            document.getElementById('pollModal');

        if (modal) {
            modal.classList.add('show');
        }

    } catch (error) {

        console.error(
            "❌ Erreur lors du chargement du sondage :",
            error
        );

        showToast(
            error.message ||
            "Impossible de charger le sondage biblique.",
            "error"
        );
    }
}


/* =========================================================
 * AFFICHER LA QUESTION ACTUELLE
 * ========================================================= */

function renderPollQuestion() {

    const question =
        pollQuizState.questions[
            pollQuizState.currentIndex
        ];

    if (!question) {
        console.error(
            "❌ Question introuvable."
        );
        return;
    }

    console.log(
        "📖 Question actuelle :",
        question
    );

    /*
     * Question
     */
    setText(
        'pollQuestionText',
        question.question || ''
    );

    /*
     * Progression
     */
    const step =
        pollQuizState.currentIndex + 1;

    const total =
        pollQuizState.questions.length;

    const stepLabel =
        document.getElementById('pollStepLabel');

    if (stepLabel) {

        stepLabel.textContent =
            `Question ${step} / ${total}`;
    }

    /*
     * Difficulté
     */
    const difficultyLabel =
        document.getElementById('pollDifficultyLabel');

    if (difficultyLabel) {

        const difficulty =
            question.difficulty || 'easy';

        const difficultyNames = {
            easy: 'Facile',
            medium: 'Moyen',
            hard: 'Difficile'
        };

        difficultyLabel.textContent =
            difficultyNames[difficulty] ||
            difficulty;
    }

    /*
     * Points
     */
    const pointsLabel =
        document.getElementById('pollPointsLabel');

    if (pointsLabel) {

        const points =
            parseFloat(question.points || 0);

        pointsLabel.textContent =
            `+${points.toFixed(2)} point${points > 1 ? 's' : ''}`;
    }

    /*
     * Options
     */
    const list =
        document.getElementById('pollOptionsList');

    if (!list) {

        console.error(
            "❌ #pollOptionsList introuvable."
        );

        return;
    }

    list.innerHTML = '';

    if (
        !Array.isArray(question.options) ||
        question.options.length === 0
    ) {

        list.innerHTML =
            '<p class="poll-error">Aucune réponse disponible.</p>';

        return;
    }

    question.options.forEach((option, index) => {

        const button =
            document.createElement('button');

        button.type = 'button';

        button.className =
            'poll-option-btn';

        button.textContent =
            option;

        button.addEventListener(
            'click',
            () => submitPollAnswer(index)
        );

        list.appendChild(button);
    });
}


/* =========================================================
 * RÉPONDRE À UNE QUESTION
 * ========================================================= */

async function submitPollAnswer(index) {

    if (pollQuizState.answering) {
        return;
    }

    const question =
        pollQuizState.questions[
            pollQuizState.currentIndex
        ];

    if (!question) {

        showToast(
            "Question introuvable.",
            "error"
        );

        return;
    }

    if (
        !Array.isArray(question.options) ||
        !question.options[index]
    ) {

        showToast(
            "Réponse invalide.",
            "error"
        );

        return;
    }

    pollQuizState.answering = true;

    const buttons =
        document.querySelectorAll(
            '#pollOptionsList .poll-option-btn'
        );

    buttons.forEach((button, i) => {

        button.disabled = true;

        if (i === index) {
            button.classList.add('selected');
        }
    });

    const selectedAnswer =
        question.options[index];

    console.log(
        "📖 Réponse sélectionnée :",
        {
            question_id: question.id,
            question: question.question,
            answer: selectedAnswer
        }
    );

    try {

        const token =
            localStorage.getItem('token');

        const response =
            await fetch(
                `${API_BASE_URL}/api/poll/answer`,
                {
                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',

                        ...(token
                            ? {
                                'Authorization':
                                    `Bearer ${token}`
                            }
                            : {})
                    },

                    body: JSON.stringify({

                        username:
                            currentUsername,

                        poll_id:
                            question.id,

                        answer:
                            selectedAnswer
                    })
                }
            );

        const contentType =
            response.headers.get('content-type') || '';

        let result;

        if (
            contentType.includes(
                'application/json'
            )
        ) {

            result =
                await response.json();

        } else {

            const text =
                await response.text();

            console.error(
                "❌ Réponse non JSON :",
                text
            );

            throw new Error(
                `Réponse serveur invalide (HTTP ${response.status})`
            );
        }

        console.log(
            "📖 Réponse /api/poll/answer :",
            result
        );

        /*
         * =====================================================
         * MAUVAISE RÉPONSE
         * =====================================================
         */

        if (
            result.success === true &&
			result.correct === false
        ) {

            showToast(
                result.message ||
                "❌ Mauvaise réponse ! Vous devez recommencer.",
                "error"
            );

            /*
             * Petite pause pour laisser voir
             * la réponse sélectionnée.
             */
            setTimeout(() => {

                pollQuizState.questions =
                    [];

                pollQuizState.currentIndex =
                    0;

                pollQuizState.totalPoints =
                    0;

                pollQuizState.answering =
                    false;

                closeModal('pollModal');

                showToast(
                    "🔄 Nouvelle tentative ! Recommencez depuis la question 1.",
                    "info"
                );

            }, 1200);

            return;
        }

        /*
         * =====================================================
         * ERREUR SERVEUR
         * =====================================================
         */

        if (!response.ok) {

            throw new Error(
                result?.message ||
                `Erreur HTTP ${response.status}`
            );
        }

        /*
         * =====================================================
         * BONNE RÉPONSE
         * =====================================================
         */

        if (
            result.success === true &&
			result.correct === true
        ) {

            const earned =
                parseFloat(
                    result.question_points ||
                    question.points ||
                    0
                );

            pollQuizState.totalPoints +=
                earned;

            /*
             * Les 5 questions sont terminées
             */
            if (
                pollQuizState.currentIndex >=
                pollQuizState.questions.length - 1
            ) {

                const total =
                    parseFloat(
                        result.points_added ||
                        pollQuizState.totalPoints
                    );

                /*
                 * Mise à jour du solde utilisateur
                 */
                if (
                    typeof result.new_balance !==
                    'undefined'
                ) {

                    userPoints.total =
                        parseFloat(
                            result.new_balance
                        );

                } else {

                    userPoints.total =
                        parseFloat(
                            userPoints.total || 0
                        ) + total;
                }

                renderUserStats();

                /*
                 * PAS DE :
                 *
                 * markActionDoneToday('poll')
                 *
                 * car le sondage peut être recommencé
                 * chaque jour et après chaque échec.
                 */

                showToast(
                    `🎉 Bravo ! Vous avez réussi les 5 questions et gagné ${total.toFixed(2)} point(s) !`,
                    "success"
                );

                console.log(
                    `🏆 Sondage terminé : +${total} point(s)`
                );

                setTimeout(() => {

                    closeModal(
                        'pollModal'
                    );

                }, 1500);

                pollQuizState.answering =
                    false;

                return;
            }

            /*
             * Passer à la question suivante
             */
            pollQuizState.currentIndex++;

            showToast(
                `✅ Bonne réponse ! +${earned.toFixed(2)} point`,
                "success"
            );

            setTimeout(() => {

                pollQuizState.answering =
                    false;

                renderPollQuestion();

            }, 700);

            return;
        }

        /*
         * =====================================================
         * CAS INATTENDU
         * =====================================================
         */

        throw new Error(
            result?.message ||
            "Réponse inattendue du serveur."
        );

    } catch (error) {

        console.error(
            "❌ Erreur sondage :",
            error
        );

        showToast(
            error.message ||
            "Impossible d'enregistrer votre réponse.",
            "error"
        );

        /*
         * Réactiver les boutons
         */
        buttons.forEach(button => {
            button.disabled = false;
        });

        pollQuizState.answering =
            false;
    }
}


/* ---------- VIDÉO BONUS (vraie vidéo YouTube définie par l'admin) ---------- */
let ytPlayer = null;              // Instance du lecteur YouTube IFrame API
let ytPollInterval = null;        // Intervalle qui comptabilise les secondes réellement regardées
let watchedSeconds = 0;           // Secondes de lecture réelle accumulées pour la vidéo en cours
let videoRewarded = false;        // Empêche de recevoir 2x les points sur la même vidéo/jour
let currentVideoId = null;        // ID YouTube de la vidéo actuellement chargée
let currentVideoUrl = null;       // URL brute renvoyée par le serveur (cache)

/**
 * Extrait l'identifiant YouTube (11 caractères) depuis n'importe quel
 * format d'URL courant : watch?v=, youtu.be/, embed/, shorts/.
 */
function extractYouTubeId(url) {
    if (!url) return null;
    const match = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
    return match ? match[1] : null;
}

/**
 * Charge dynamiquement le script officiel de l'API YouTube IFrame
 * (une seule fois) et résout la promesse quand il est prêt à l'emploi.
 */
function loadYouTubeAPI() {
    return new Promise((resolve) => {
        if (window.YT && window.YT.Player) { resolve(); return; }
        const existingCallback = window.onYouTubeIframeAPIReady;
        window.onYouTubeIframeAPIReady = () => {
            if (typeof existingCallback === 'function') existingCallback();
            resolve();
        };
        if (!document.getElementById('youtube-iframe-api-script')) {
            const tag = document.createElement('script');
            tag.id = 'youtube-iframe-api-script';
            tag.src = 'https://www.youtube.com/iframe_api';
            document.head.appendChild(tag);
        }
    });
}

/**
 * Récupère l'URL de la vidéo bonus configurée par l'admin.
 * Essaie d'abord le serveur (source de vérité, partagée entre tous les
 * utilisateurs), puis retombe sur le cache local si le serveur ne répond pas.
 */
async function fetchVideoBonusSettings() {
    try {
        const response = await fetch(`${API_BASE_URL}/api/settings/video-bonus`);
        if (response.ok) {
            const data = await response.json();
            if (data && data.url) {
                currentVideoUrl = data.url;
                setCache('video_bonus_url_cache', data.url);
                return currentVideoUrl;
            }
        }
    } catch (e) {
        console.warn("Vidéo bonus : serveur injoignable, utilisation du cache local.", e);
    }
    currentVideoUrl = getCache('video_bonus_url_cache');
    return currentVideoUrl;
}

/**
 * MISE À JOUR DE L'APPLICATION (APK)
 * ==========================================
 * Récupère le lien de téléchargement actuellement publié par l'admin.
 * Sert de repli si une notification SSE arrive sans URL embarquée.
 */
let currentAppUpdateUrl = null;

async function fetchAppUpdateSettings() {
    try {
        const response = await fetch(`${API_BASE_URL}/api/settings/app-update`);
        if (response.ok) {
            const data = await response.json();
            if (data && data.url) {
                currentAppUpdateUrl = data.url;
                setCache('app_update_url_cache', data.url);
                return currentAppUpdateUrl;
            }
        }
    } catch (e) {
        console.warn("Mise à jour APK : serveur injoignable, utilisation du cache local.", e);
    }
    currentAppUpdateUrl = getCache('app_update_url_cache');
    return currentAppUpdateUrl;
}

/**
 * Ouvre la popup de mise à jour : branche le bouton de téléchargement et le
 * QR code sur le lien fourni (celui de la notification, ou à défaut le
 * dernier lien connu récupéré depuis le serveur).
 */
function openAppUpdateModal(url) {
    const targetUrl = url || currentAppUpdateUrl;
    if (!targetUrl) {
        showToast("Le lien de la nouvelle version n'est pas disponible pour le moment.", "error");
        return;
    }

    const downloadBtn = document.getElementById('appUpdateDownloadBtn');
    const qrImg = document.getElementById('appUpdateQrImg');
    if (downloadBtn) downloadBtn.href = targetUrl;
    if (qrImg) qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(targetUrl)}`;

    const modal = document.getElementById('appUpdateModal');
    if (modal) modal.classList.add('show');
    feather.replace();
}

async function watchVideoAd() {
    if (!currentUsername) { showToast("Veuillez vous connecter pour participer.", "error"); return; }

    const url = currentVideoUrl || await fetchVideoBonusSettings();
    const videoId = extractYouTubeId(url);

    document.getElementById('videoModal').classList.add('show');
    document.getElementById('videoProgressFill').style.width = '0%';

    const unavailableMsg = document.getElementById('videoUnavailableMsg');
    const playerEl = document.getElementById('youtubePlayer');

    if (!videoId) {
        unavailableMsg.style.display = 'flex';
        playerEl.style.display = 'none';
        setText('videoStatusText', "Aucune vidéo bonus n'est disponible pour le moment.");
        return;
    }
    unavailableMsg.style.display = 'none';
    playerEl.style.display = 'block';

    currentVideoId = videoId;
    watchedSeconds = 0;
    videoRewarded = isActionDoneToday('video_' + videoId);

    setText('videoStatusText', videoRewarded
        ? "Vous avez déjà reçu vos points pour cette vidéo aujourd'hui. Vous pouvez la regarder à nouveau, sans bonus."
        : `Regardez au moins ${VIDEO_WATCH_TARGET_SECONDS} secondes pour gagner ${VIDEO_BONUS_POINTS} points.`);

    await loadYouTubeAPI();

    if (ytPlayer && typeof ytPlayer.loadVideoById === 'function') {
        ytPlayer.loadVideoById(videoId);
    } else {
        ytPlayer = new YT.Player('youtubePlayer', {
            videoId: videoId,
            playerVars: { rel: 0, modestbranding: 1 },
            events: { onStateChange: onYtStateChange }
        });
    }
}

function onYtStateChange(event) {
    clearInterval(ytPollInterval);
    if (event.data === YT.PlayerState.PLAYING) {
        // On ne compte que le temps de lecture réel : une pause ou un
        // buffering arrête le décompte, une reprise le relance.
        ytPollInterval = setInterval(trackWatchProgress, 1000);
    }
}

function trackWatchProgress() {
    if (videoRewarded) { clearInterval(ytPollInterval); return; }

    watchedSeconds += 1;
    const pct = Math.min(100, (watchedSeconds / VIDEO_WATCH_TARGET_SECONDS) * 100);
    document.getElementById('videoProgressFill').style.width = `${pct}%`;

    if (watchedSeconds >= VIDEO_WATCH_TARGET_SECONDS) {
        clearInterval(ytPollInterval);
        completeVideoPlayback();
    } else {
        setText('videoStatusText', `${VIDEO_WATCH_TARGET_SECONDS - watchedSeconds}s de lecture restantes pour gagner vos points...`);
    }
}

async function completeVideoPlayback() {
    videoRewarded = true; // Verrouillage optimiste pour éviter un double-clic/double-appel
    const ok = await awardPoints(VIDEO_BONUS_POINTS, "Visionnage vidéo bonus (1 min)");

    if (ok) {
        markActionDoneToday('video_' + currentVideoId);
        setText('videoStatusText', `🎉 Bravo ! Vous avez gagné ${VIDEO_BONUS_POINTS} points de fidélité.`);
        updateEarnCardsState();
    } else {
        videoRewarded = false; // L'appel serveur a échoué : on autorise un nouvel essai
    }
}

/* ---------- PARTAGE ---------- */
function shareApp() {
    if (!currentUsername) { showToast("Veuillez vous connecter pour participer.", "error"); return; }
    if (isActionDoneToday('share')) { showToast("Vous avez déjà gagné des points de partage aujourd'hui. Revenez demain !", "info"); return; }

    if (navigator.share) {
        navigator.share({
            title: 'Apokalypsy',
            text: 'Découvrez Apokalypsy, votre guide spirituel interactif !',
            url: window.location.origin,
        }).then(async () => {
            const ok = await awardPoints(15, "Partage de l'application");
            if (ok) {
                markActionDoneToday('share');
                updateEarnCardsState();
            }
        }).catch((error) => {
            console.error('Erreur de partage:', error);
            showToast("Le partage a été annulé ou a échoué.", "error");
        });
    } else {
        // Fallback pour les navigateurs ne supportant pas Web Share API
        navigator.clipboard?.writeText(window.location.origin).catch(() => {});
        showToast("Partage non supporté : le lien a été copié dans le presse-papiers.", "info");
    }
}

/**
 * Met à jour l'apparence des 4 cartes "Gagner plus de points" (verrouillée/disponible)
 * et l'objectif quotidien affiché dans le héro.
 */
function updateEarnCardsState() {
    if (!currentUsername) return;

    const configs = [
        { action: 'poll', cardId: 'earn-card-poll', bonusId: 'earn-bonus-poll', doneLabel: '✓ Fait', done: isActionDoneToday('poll') },
        { action: 'quiz', cardId: 'earn-card-quiz', bonusId: 'earn-bonus-quiz', doneLabel: '✓ Fait', done: false },
        { action: 'share', cardId: 'earn-card-share', bonusId: 'earn-bonus-share', doneLabel: '✓ Fait', done: isActionDoneToday('share') }
    ];

    let doneCount = 0;
    configs.forEach(cfg => {
        const card = document.getElementById(cfg.cardId);
        const bonus = document.getElementById(cfg.bonusId);
        if (!card || !bonus) return;
        if (cfg.done) {
            card.classList.add('done');
            bonus.innerText = cfg.doneLabel;
            doneCount++;
        } else {
            card.classList.remove('done');
        }
    });

    // Carte vidéo : une vidéo unique définie par l'admin, +3 pts après 1 min regardée
    const videoCard = document.getElementById('earn-card-video');
    const videoBonus = document.getElementById('earn-bonus-video');
    const videoNote = document.getElementById('earn-note-video');
    if (videoCard && videoBonus && videoNote) {
        const videoId = extractYouTubeId(currentVideoUrl || getCache('video_bonus_url_cache'));
        const videoDoneToday = videoId ? isActionDoneToday('video_' + videoId) : false;

        if (!videoId) {
            videoNote.innerText = "Aucune vidéo disponible pour le moment";
            videoCard.classList.remove('done');
            videoBonus.innerText = '+3 pts';
        } else if (videoDoneToday) {
            videoCard.classList.add('done');
            videoBonus.innerText = '✓ Fait';
            videoNote.innerText = "Revenez demain pour un nouveau bonus";
            doneCount++;
        } else {
            videoCard.classList.remove('done');
            videoBonus.innerText = '+3 pts';
            videoNote.innerText = "Regardez 1 min pour gagner des points";
        }
    }

    // Objectif quotidien affiché dans le héro
    const wrap = document.getElementById('dailyGoalWrap');
    const label = document.getElementById('dailyGoalLabel');
    const fill = document.getElementById('dailyGoalFill');
    const totalActions = 4;
    if (wrap && label && fill) {
        wrap.style.display = 'flex';
        label.innerText = `${doneCount}/${totalActions} activités aujourd'hui`;
        fill.style.width = `${(doneCount / totalActions) * 100}%`;
        if (doneCount >= totalActions) {
            label.innerText = `🎉 Objectif du jour atteint !`;
        }
    }
}

async function updateLoginStreak() {

    if (!currentUsername) {
        console.warn("⚠️ Aucun utilisateur pour calculer le streak.");
        return;
    }

    const token = localStorage.getItem('token');

    try {

        const response = await fetch(
            `${API_BASE_URL}/api/reward/daily-login`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token
                        ? {
                            'Authorization': `Bearer ${token}`
                        }
                        : {})
                },
                body: JSON.stringify({
                    username: currentUsername
                })
            }
        );

        const data = await response.json();

        console.log("🔥 Login streak :", data);

        /*
         * Même si l'utilisateur s'est déjà connecté aujourd'hui,
         * le serveur renvoie quand même son streak actuel.
         */
        if (
            data.success ||
            data.alreadyLoggedToday
        ) {

            const streak = Number(data.streak || 0);

            /*
             * Badge principal :
             * 🔥 1 jour de suite
             * 🔥 2 jours de suite
             * 🔥 3 jours de suite...
             */
            const streakText =
                document.getElementById('streakText');

            if (streakText) {

                streakText.innerText =
                    streak <= 1
                        ? `${streak} jour de suite`
                        : `${streak} jours de suite`;
            }

            

            /*
             * Affichage du badge
             */
            const streakBadge =
                document.getElementById('streakBadge');

            if (streakBadge) {
                streakBadge.style.display = 'flex';
            }

        } else {

            console.warn(
                "⚠️ Impossible de récupérer le streak :",
                data.message
            );
        }

    } catch (error) {

        console.error(
            "❌ Erreur lors de la mise à jour du streak :",
            error
        );
    }
}

/**
 * ==========================================
 * GESTION DE LA FIDÉLITÉ (MISE À JOUR)
 * ==========================================
 */
async function loadLoyaltyData() {
    if (!currentUsername) return;

    const cacheKey = `cache_loyalty_${currentUsername}`;
    const cached = getCache(cacheKey);

    // Affichage immédiat depuis le cache
    if (cached) {
        userPoints.total = Number(cached.total || 0);
        renderLoyaltyActionButton(cached.history || []);
        renderUserStats();
    }

    const token = localStorage.getItem('token');

    /*
     * IMPORTANT
     * L'endpoint /api/points/history utilise le username.
     * On n'envoie donc le Bearer token que lorsqu'il existe réellement.
     */
    const headers = {
        'Accept': 'application/json'
    };

    if (token && token.trim() !== '') {
        headers['Authorization'] = `Bearer ${token}`;
    }

    const urlHistory =
        `${API_BASE_URL}/api/points/history?username=${encodeURIComponent(currentUsername)}`;

    try {
        const response = await fetch(urlHistory, {
            method: 'GET',
            headers: headers,
            cache: 'no-store'
        });

        /*
         * Si le token est expiré/invalide :
         * on ne casse PAS l'affichage de l'espace personnel.
         *
         * Le backend de /points/history peut récupérer les points
         * à partir du username.
         */
        if (response.status === 401) {

            console.warn(
                "⚠️ Token invalide ou expiré pour /api/points/history."
            );

            /*
             * On supprime uniquement le token invalide.
             * Le compte utilisateur et les données locales restent conservés.
             */
            localStorage.removeItem('token');

            /*
             * On conserve le cache si disponible.
             */
            if (cached) {
                userPoints.total = Number(cached.total || 0);
                renderLoyaltyActionButton(cached.history || []);
                renderUserStats();
            }

            return;
        }

        if (!response.ok) {
            throw new Error(`Erreur HTTP ${response.status}`);
        }

        const contentType =
            response.headers.get('content-type') || '';

        if (!contentType.includes('application/json')) {
            throw new Error(
                `Réponse serveur inattendue : ${contentType}`
            );
        }

        const data = await response.json();

        console.log("💎 Données fidélité :", data);

        if (data && data.success) {

            userPoints.total =
                Number(data.total_points || 0);

            const history =
                Array.isArray(data.history)
                    ? data.history
                    : [];

            renderLoyaltyActionButton(history);
            renderUserStats();

            // Sauvegarde du cache
            setCache(cacheKey, {
                total: userPoints.total,
                history: history
            });

        } else {

            console.warn(
                "⚠️ Réponse fidélité inattendue :",
                data
            );

            if (!cached) {
                userPoints.total = 0;
                renderLoyaltyActionButton([]);
                renderUserStats();
            }
        }

    } catch (error) {

        console.error(
            "❌ Erreur lors du chargement de la fidélité :",
            error
        );

        /*
         * Ne jamais remettre les points à zéro
         * simplement parce que l'API est momentanément indisponible.
         */
        if (!cached) {
            renderLoyaltyActionButton([]);
            renderUserStats();
        }
    }
}

function renderLoyaltyActionButton(history) {
    const container = document.getElementById('loyalty-action-container');
    if (!container) return;

    // Nettoyer l'ancien intervalle s'il existe pour éviter les fuites de mémoire
    if (window.loyaltyCountdownInterval) {
        clearInterval(window.loyaltyCountdownInterval);
        window.loyaltyCountdownInterval = null; // S'assurer qu'il est réinitialisé
    }

    const now = new Date();
    let dernierBonusDate = null;

    // Trouver la dernière action de bonus quotidienne
    const dailyBonuses = Array.isArray(history) 
        ? history.filter(item => item.actionType === 'DAILY_VERSE')
        : [];

    if (dailyBonuses.length > 0) {
        // Trier par date pour trouver le plus récent
        dailyBonuses.sort((a, b) => {
            const [datePartA, timePartA] = a.date.split(' ');
            const [dayA, monthA, yearA] = datePartA.split('/');
            const [hoursA, minutesA] = timePartA.split(':');
            const dateA = new Date(yearA, monthA - 1, dayA, hoursA, minutesA);

            const [datePartB, timePartB] = b.date.split(' ');
            const [dayB, monthB, yearB] = datePartB.split('/');
            const [hoursB, minutesB] = timePartB.split(':');
            const dateB = new Date(yearB, monthB - 1, dayB, hoursB, minutesB);

            return dateB.getTime() - dateA.getTime(); // Du plus récent au plus ancien
        });
        
        // Le plus récent est le premier
        const mostRecentBonus = dailyBonuses[0];
        const [datePart, timePart] = mostRecentBonus.date.split(' ');
        const [day, month, year] = datePart.split('/');
        const [hours, minutes] = timePart.split(':');
        dernierBonusDate = new Date(year, month - 1, day, hours, minutes);
    }

    const dateProchainBonus = dernierBonusDate ? new Date(dernierBonusDate.getTime() + (24 * 60 * 60 * 1000)) : null;

    if (dateProchainBonus && now < dateProchainBonus) {
        // Création du conteneur pour le rebours
        container.innerHTML = `
            <button class="loyalty-action-btn" style="background: #e2e8f0; color: #94a3b8; cursor: not-allowed; display: flex; flex-direction: column; gap: 4px; padding: 10px 16px;" disabled>
                <span><i data-feather="check-circle"></i> Bonus quotidien réclamé</span>
                <small id="loyalty-countdown-timer" style="font-size: 0.75rem; color: #64748b; font-weight: bold;"></small>
            </button>
        `;
        feather.replace();

        // Fonction de mise à jour du chrono
        function updateTimer() {
            const maintenant = new Date();
            const reste = dateProchainBonus - maintenant;

            const timerEl = document.getElementById('loyalty-countdown-timer');
            if (!timerEl) return;

            if (reste <= 0) {
                timerEl.innerText = "Bonus disponible ! Recharger la page.";
                clearInterval(window.loyaltyCountdownInterval);
                window.loyaltyCountdownInterval = null;
                // Recharger les données pour afficher le bouton de réclamation
                loadLoyaltyData(); 
                return;
            }

            const h = Math.floor(reste / (1000 * 60 * 60));
            const m = Math.floor((reste % (1000 * 60 * 60)) / (1000 * 60));
            const s = Math.floor((reste % (1000 * 60)) / 1000);

            const format = (num) => num < 10 ? '0' + num : num;
            timerEl.innerText = `Disponible dans : ${format(h)}h ${format(m)}m ${format(s)}s`;
        }

        // Lancer le compteur immédiatement et toutes les secondes
        window.loyaltyUpdateTimerFn = updateTimer;
        updateTimer();
        window.loyaltyCountdownInterval = setInterval(updateTimer, 1000);

    } else {
        // Pas de bonus à venir ou déjà disponible : Bouton actif
        window.loyaltyUpdateTimerFn = null;
        container.innerHTML = `
            <button class="loyalty-action-btn" onclick="claimDailyLoginReward()">
                <i data-feather="gift"></i> Réclamer mon bonus (+0.50)
            </button>
        `;
        feather.replace();
    }
}

async function claimDailyLoginReward() {
    const container = document.getElementById('loyalty-action-container');
    if (!container) return;
    
    const token = localStorage.getItem('token');
    
    // Sécurité Frontend si le token n'existe pas dans le localStorage
    

    container.innerHTML = `
        <button class="loyalty-action-btn" disabled>
            <i data-feather="loader" class="animate-spin"></i> Traitement...
        </button>
    `;
    feather.replace();

    try {
        const response = await fetch(`${API_BASE_URL}/api/reward/daily-login`, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ username: currentUsername })
        });

        if (response.status === 401) {
            showToast("Session non autorisée. Veuillez vous reconnecter.", "error");
            loadLoyaltyData(); // Recharge les données qui incluront un appel à renderUserStats
            return;
        }

        const data = await response.json();
        showToast(data.message || (data.success ? "Opération réussie !" : "Une erreur est survenue."), data.success ? "success" : "error");
        
        loadLoyaltyData(); // Recharge les données qui incluront un appel à renderUserStats

    } catch (error) {
        console.error("Erreur lors de la réclamation du bonus :", error);
        showToast("Impossible de joindre le serveur de fidélité.", "error");
        loadLoyaltyData(); // Recharge les données qui incluront un appel à renderUserStats
    }
}

/**
 * Construit le rendu de la liste d'activités à partir des données brutes
 * (utilisé à la fois pour l'affichage depuis le cache et depuis le réseau).
 */
/**
 * Construit le rendu de la liste d'activités à partir des données brutes,
 * en les groupant par jour et en gérant le chargement progressif.
 * @param {Array} allData Toutes les activités brutes de l'API.
 */
 
 /**
 * Sécurise le texte avant de l'insérer dans du HTML.
 * Évite qu'un contenu provenant de l'API puisse casser l'affichage.
 */
function escapeActivityHtml(value) {
    if (value === null || value === undefined) {
        return '';
    }

    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}


/**
 * ==========================================
 * OUTILS - ACTIVITÉS RÉCENTES
 * ==========================================
 */

/**
 * Formate une date en temps relatif.
 * Exemple :
 *   À l'instant
 *   Il y a 5 min
 *   Il y a 2 h
 *   Hier
 *   Il y a 3 jours
 */
function formatActivityRelativeTime(dateInput) {
    if (!dateInput) return 'Date inconnue';

    const date = new Date(dateInput);

    if (isNaN(date.getTime())) {
        console.warn('Date activité invalide :', dateInput);
        return 'Date inconnue';
    }

    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffSeconds = Math.floor(diffMs / 1000);

    if (diffSeconds < 10) {
        return "À l'instant";
    }

    if (diffSeconds < 60) {
        return `Il y a ${diffSeconds}s`;
    }

    const diffMinutes = Math.floor(diffSeconds / 60);

    if (diffMinutes < 60) {
        return `Il y a ${diffMinutes} min`;
    }

    const diffHours = Math.floor(diffMinutes / 60);

    if (diffHours < 24) {
        return `Il y a ${diffHours} h`;
    }

    const diffDays = Math.floor(diffHours / 24);

    if (diffDays === 1) {
        return 'Hier';
    }

    if (diffDays < 7) {
        return `Il y a ${diffDays} jours`;
    }

    return date.toLocaleDateString('fr-FR', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
    });
}


/**
 * Échappe le HTML pour éviter d'injecter directement
 * des données provenant de l'API dans le DOM.
 */
function escapeActivityHtml(value) {
    if (value === null || value === undefined) {
        return '';
    }

    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}


/**
 * Ouvre/ferme l'historique complet.
 */


function toggleFullActivityHistory() {

    const history =
        document.getElementById('full-activity-history');

    const button =
        document.getElementById('activity-toggle-btn');

    const buttonText =
        document.getElementById('activity-toggle-text');

    if (!history) {
        console.warn(
            'Conteneur #full-activity-history introuvable.'
        );
        return;
    }

    const isHidden =
        history.style.display === 'none' ||
        history.style.display === '';

    if (isHidden) {

        history.style.display = 'block';

        if (buttonText) {
            buttonText.textContent =
                'Masquer l’historique';
        }

        if (button) {
            button.classList.add('is-open');
        }

    } else {

        history.style.display = 'none';

        if (buttonText) {
            buttonText.textContent =
                'Voir toute mon activité';
        }

        if (button) {
            button.classList.remove('is-open');
        }
    }

    if (
        typeof feather !== 'undefined' &&
        typeof feather.replace === 'function'
    ) {
        feather.replace();
    }
}






/**
 * Rend l'historique complet dans le conteneur prévu.
 */
function renderFullActivityHistory(activities) {

    const container =
        document.getElementById('full-activity-history');

    if (!container) {
        console.warn(
            'Conteneur #full-activity-history introuvable.'
        );
        return;
    }

    if (!Array.isArray(activities) || activities.length === 0) {
        container.innerHTML = `
            <div class="activity-empty-state">
                <div class="activity-empty-icon">
                    <i data-feather="book-open"></i>
                </div>

                <p>Aucune activité enregistrée.</p>

                <span>
                    Vos activités apparaîtront ici au fur et à mesure.
                </span>
            </div>
        `;

        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        return;
    }

    const sortedActivities = [...activities].sort((a, b) => {
        const dateA = new Date(a.created_at);
        const dateB = new Date(b.created_at);

        return dateB.getTime() - dateA.getTime();
    });

    let html = '';

    sortedActivities.forEach((item) => {

        const book = escapeActivityHtml(item.book || 'Bible');
        const chapter = escapeActivityHtml(item.chapter || '');
        const verses = Array.isArray(item.verses)
            ? item.verses.map(escapeActivityHtml).join(', ')
            : '';

        const relativeTime =
            formatActivityRelativeTime(item.created_at);

        html += `
            <div class="activity-full-item">

                <div class="activity-icon icon-blue">
                    <i data-feather="book-open"></i>
                </div>

                <div class="activity-content">

                    <div class="activity-title">
                        Lecture Biblique
                    </div>

                    <div class="activity-text">
                        Vous avez terminé
                        ${book}
                        chapitre ${chapter}
                        ${verses ? ` — versets ${verses}` : ''}
                    </div>

                    <div class="activity-time">
                        ${escapeActivityHtml(relativeTime)}
                    </div>

                </div>

            </div>
        `;
    });

    container.innerHTML = html;

    if (typeof feather !== 'undefined') {
        feather.replace();
    }
}



function renderActivities(allData) {

    const activityDisplayArea =
        document.getElementById('activity-display-area');

    const activityListSkeleton =
        document.getElementById('activity-list-skeleton');

    const paginationBar =
        document.getElementById('activity-pagination');

    const toggleBtn =
        document.getElementById('activity-toggle-btn');

    const totalCount =
        document.getElementById('activity-total-count');

    if (!activityDisplayArea) {
        console.error(
            '❌ #activity-display-area introuvable'
        );
        return;
    }

    if (activityListSkeleton) {
        activityListSkeleton.style.display = 'none';
    }

    /*
     * Vérification des données
     */
    if (!Array.isArray(allData) || allData.length === 0) {

        activityDisplayArea.innerHTML = `
            <div class="activity-empty-state">

                <div class="activity-empty-icon">
                    <i data-feather="book-open"></i>
                </div>

                <p>Aucune activité récente pour le moment.</p>

                <span>
                    Commencez à lire la Bible pour voir
                    votre progression ici !
                </span>

            </div>
        `;

        if (toggleBtn) {
            toggleBtn.style.display = 'none';
        }

        if (paginationBar) {
            paginationBar.style.display = 'none';
        }

        if (totalCount) {
            totalCount.textContent = '0';
        }

        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        return;
    }

    /*
     * Nombre total
     */
    if (totalCount) {
        totalCount.textContent = allData.length;
    }

    /*
     * Copie + tri par date
     */
    const sortedActivities = [...allData].sort((a, b) => {

        const dateA = new Date(a.created_at || 0).getTime();
        const dateB = new Date(b.created_at || 0).getTime();

        return dateB - dateA;
    });

    /*
     * Seulement les 3 dernières activités
     */
    const recentActivities =
        sortedActivities.slice(0, 3);

    let htmlContent = '';

    activityColorIndex = 0;

    recentActivities.forEach((item, index) => {

        /*
         * Sécurisation des valeurs
         */
        const book =
            item.book !== undefined && item.book !== null
                ? String(item.book)
                : 'Bible';

        const chapter =
            item.chapter !== undefined && item.chapter !== null
                ? String(item.chapter)
                : '';

        /*
         * Les versets peuvent être :
         * - un tableau
         * - une chaîne
         * - null
         */
        let verses = '';

        if (Array.isArray(item.verses)) {

            verses = item.verses.join(', ');

        } else if (
            item.verses !== undefined &&
            item.verses !== null
        ) {

            verses = String(item.verses);
        }

        /*
         * Couleur de l'icône
         */
        let iconClass = 'icon-blue';

        try {

            iconClass =
                getNextActivityIconColorClass();

        } catch (e) {

            console.warn(
                'Couleur activité indisponible :',
                e
            );
        }

        /*
         * Date relative
         */
        let relativeTime = '';

        try {

            relativeTime =
                formatActivityRelativeTime(
                    item.created_at
                );

        } catch (e) {

            console.warn(
                'Date activité invalide :',
                e
            );
        }

        /*
         * Construction de l'activité
         */
        htmlContent += `

            <div class="activity-item is-visible">

                <div class="activity-icon ${iconClass}">
                    <i data-feather="book-open"></i>
                </div>

                <div class="activity-content">

                    <div class="activity-title">
                        Lecture Biblique
                    </div>

                    <div class="activity-text">

                        Vous avez terminé
                        <strong>
                            ${escapeActivityHtml(book)}
                        </strong>

                        chapitre
                        <strong>
                            ${escapeActivityHtml(chapter)}
                        </strong>

                        ${
                            verses
                                ? `
                                    <span>
                                        · versets
                                        ${escapeActivityHtml(verses)}
                                    </span>
                                  `
                                : ''
                        }

                    </div>

                    ${
                        relativeTime
                            ? `
                                <div class="activity-time">
                                    ${escapeActivityHtml(relativeTime)}
                                </div>
                              `
                            : ''
                    }

                </div>

            </div>
        `;
    });

    /*
     * Insérer les 3 activités
     */
    activityDisplayArea.innerHTML = htmlContent;

    /*
     * Bouton historique complet
     */
    if (toggleBtn) {

        if (allData.length > 3) {

            toggleBtn.style.display = 'flex';

        } else {

            toggleBtn.style.display = 'none';

        }
    }

    /*
     * Préparer l'historique complet
     */
    try {

        renderFullActivityHistory(
            sortedActivities
        );

    } catch (error) {

        console.error(
            '❌ Erreur historique complet :',
            error
        );
    }

    /*
     * Pas de pagination visible
     * dans la vue compacte.
     */
    if (paginationBar) {
        paginationBar.style.display = 'none';
    }

    /*
     * Remplacement des icônes Feather
     */
    if (typeof feather !== 'undefined') {
        feather.replace();
    }

    /*
     * Animation
     */
    try {

        observeActivityElements();

    } catch (error) {

        console.warn(
            'Animation des activités indisponible :',
            error
        );
    }
}





/**
 * Construit et affiche la barre de pagination des activités
 * (flèches précédent/suivant + numéros de page, avec ellipses si nécessaire).
 * @param {number} totalPages Nombre total de pages disponibles.
 * @param {number} totalDays Nombre total de jours distincts d'activité.
 */
function renderActivityPagination(totalPages, totalDays) {
    const paginationBar = document.getElementById('activity-pagination');
    if (!paginationBar) return;

    if (totalPages <= 1) {
        paginationBar.style.display = 'none';
        paginationBar.innerHTML = '';
        return;
    }

    paginationBar.style.display = 'flex';

    // Calcule la liste des numéros de page à afficher, avec ellipses au-delà de 6 pages
    const pages = [];
    if (totalPages <= 6) {
        for (let p = 1; p <= totalPages; p++) pages.push(p);
    } else {
        pages.push(1);
        if (currentActivityPage > 3) pages.push('…');
        const rangeStart = Math.max(2, currentActivityPage - 1);
        const rangeEnd = Math.min(totalPages - 1, currentActivityPage + 1);
        for (let p = rangeStart; p <= rangeEnd; p++) pages.push(p);
        if (currentActivityPage < totalPages - 2) pages.push('…');
        pages.push(totalPages);
    }

    const numbersHtml = pages.map(p => {
        if (p === '…') {
            return `<span class="activity-page-ellipsis">…</span>`;
        }
        const isActive = p === currentActivityPage;
        return `<button type="button" class="activity-page-btn${isActive ? ' active' : ''}" ${isActive ? 'aria-current="page"' : ''} onclick="goToActivityPage(${p})">${p}</button>`;
    }).join('');

    paginationBar.innerHTML = `
        <button type="button" class="activity-page-nav" id="activity-prev-btn" onclick="goToActivityPage(currentActivityPage - 1)" aria-label="Page précédente" ${currentActivityPage === 1 ? 'disabled' : ''}>
            <i data-feather="chevron-left"></i>
        </button>
        <div class="activity-page-numbers">${numbersHtml}</div>
        <button type="button" class="activity-page-nav" id="activity-next-btn" onclick="goToActivityPage(currentActivityPage + 1)" aria-label="Page suivante" ${currentActivityPage === totalPages ? 'disabled' : ''}>
            <i data-feather="chevron-right"></i>
        </button>
        <span class="activity-page-meta">${totalDays} jour${totalDays > 1 ? 's' : ''} au total</span>
    `;
    feather.replace();
}

/**
 * Navigue vers une page donnée de la liste d'activités.
 * @param {number} page Le numéro de page cible.
 */
function goToActivityPage(page) {
    if (page === currentActivityPage) return;
    currentActivityPage = page;
    renderActivities(allRawActivities);

    // Ramène doucement l'utilisateur en haut de la liste, pour éviter
    // qu'il ait à remonter manuellement après avoir changé de page.
    const section = document.getElementById('recent-activities-card');
    if (section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

/**
 * Charge les activités de l'utilisateur et affiche la première page.
 */
async function loadActivities() {
    const username = localStorage.getItem('user_name');
    const activityDisplayArea = document.getElementById('activity-display-area');
    const activityListSkeleton = document.getElementById('activity-list-skeleton');
    const paginationBar = document.getElementById('activity-pagination');

    if (!username) {
        activityDisplayArea.innerHTML = `
            <div style="padding: 20px; text-align: center; color: var(--muted); font-size: 0.9rem;">
                Connectez-vous pour voir vos activités récentes.
            </div>
        `;
        if (activityListSkeleton) activityListSkeleton.style.display = 'none';
        if (paginationBar) paginationBar.style.display = 'none';
        // Réinitialisation des stats en mode invité
        userPoints.bibleVerses = 0;
        userPoints.bibleChapters = 0;
        renderUserStats();
        feather.replace();
        return;
    }

    // Affiche le squelette pendant le chargement, réinitialise la pagination
    activityListSkeleton.style.display = 'flex';
    activityDisplayArea.innerHTML = ''; // Nettoyer le contenu précédent
    currentActivityPage = 1;

    const cacheKey = `cache_activities_${username}`;
    const cached = getCache(cacheKey);
    if (cached) {
        allRawActivities = cached;
        renderActivities(allRawActivities);
        activityListSkeleton.style.display = 'none';
    }

    try {
        const response = await fetch(`${API_BASE_URL}/api/bible/history?username=${username}`);
        if (!response.ok) {
            throw new Error(`Erreur HTTP: ${response.status}`);
        }
        const data = await response.json();

        allRawActivities = data;
        setCache(cacheKey, data);

        renderActivities(allRawActivities);
        updateUserStatsFromActivities(data); // Met à jour les stats après le chargement des activités

    } catch (error) {
        console.error("Erreur lors du chargement des activités bibliques :", error);
        if (!cached) { // Si pas de cache, affiche un message d'erreur
            activityDisplayArea.innerHTML = `
                <div style="padding: 20px; text-align: center; color: var(--danger); font-size: 0.9rem;">
                    Erreur lors du chargement des activités. Veuillez réessayer plus tard.
                </div>
            `;
            // Réinitialise les compteurs en cas d'erreur
            userPoints.bibleVerses = 0;
            userPoints.bibleChapters = 0;
            renderUserStats();
        } else {
            showToast("Impossible de rafraîchir vos activités récentes.", "error");
        }
    } finally {
        activityListSkeleton.style.display = 'none';
        feather.replace();
    }
}

/**
 * Met à jour les statistiques de l'utilisateur (versets, chapitres) à partir des activités.
 * @param {Array} activities La liste complète des activités.
 */
function updateUserStatsFromActivities(activities) {
    let totalVersesRead = 0;
    const uniqueChapters = new Set();

    if (Array.isArray(activities)) {
        activities.forEach(item => {
            if (item.verses) {
                totalVersesRead += item.verses.length;
            }
            if (item.book && item.chapter) {
                uniqueChapters.add(`${item.book}-${item.chapter}`);
            }
        });
    }

    userPoints.bibleVerses = totalVersesRead;
    userPoints.bibleChapters = uniqueChapters.size;

    
    renderUserStats();
}

// Fonctions utilitaires, conservées pour être appelées par renderUserStats
function calculateLevel(points) {
    return Math.floor(points / 100) + 1;
}

function calculateProgress(points) {
    return Math.floor(points % 100);
}

// Nouvelle fonction de rendu unifiée pour toutes les statistiques utilisateur
function renderUserStats() {
    const { total, bibleVerses, bibleChapters, prayerMinutes } = userPoints;

    const safeTotal = Math.max(0, Number(total) || 0);

    /*
     * =========================
     * NIVEAU + PROGRESSION XP
     * =========================
     */

    const level = calculateLevel(safeTotal);
    const progress = calculateProgress(safeTotal);

    const currentXP = Math.floor(safeTotal % 100);
    const nextLevelXP = 100;
    const remainingXP = nextLevelXP - currentXP;

    // Solde principal
    setText(
        'display-points',
        `${safeTotal.toFixed(2)} Points`
    );

    // Badge Niveau
    const levelBtn = document.querySelector('.progress-btn');

    if (levelBtn) {
        levelBtn.innerHTML = `
            <span class="level-badge-icon">
				<i data-feather="zap"></i>
			</span>
            <span>Niveau ${level}</span>
        `;

        levelBtn.setAttribute(
            'aria-label',
            `Niveau ${level}, ${currentXP} points sur 100`
        );
    }

    /*
     * =========================
     * CERCLE DE PROGRESSION
     * =========================
     */

    const circleText = document.querySelector('.circle-text');

    if (circleText) {
        circleText.innerHTML = `
            <strong>${currentXP}</strong>
            <small>/ 100 XP</small>
        `;
    }

    const circleSub = document.querySelector('.circle-sub');

    if (circleSub) {
        circleSub.textContent =
            remainingXP === 100
                ? 'Commencez votre progression'
                : `${remainingXP} XP avant le niveau ${level + 1}`;
    }

    const progressCircle =
        document.querySelector('.progress-circle');

    if (progressCircle) {

        const percentage =
            Math.min(100, Math.max(0, progress));

        progressCircle.style.background =
            `conic-gradient(
                #ef4444 0%,
                #f97316 ${percentage}%,
                #e2e8f0 ${percentage}%,
                #e2e8f0 100%
            )`;

        progressCircle.setAttribute(
            'aria-label',
            `Progression du niveau ${level} : ${currentXP} sur 100 XP`
        );
    }

    /*
     * =========================
     * STATISTIQUES
     * =========================
     */

    setText('stats-versets', bibleVerses);
    setText('stats-lecons', bibleChapters);

    setText(
        'stats-priere',
        `${Math.floor(safeTotal * 2)}m`
    );

    /*
     * =========================
     * TROPHÃ‰ES
     * =========================
     */

    generateTrophies(safeTotal);

    if (typeof feather !== 'undefined') {
        feather.replace();
    }
}
function generateTrophies(points) {
    const trophyGrid = document.querySelector('.trophy-grid');
    if (!trophyGrid) return;
	updateTrophyProgress(points);
    trophyGrid.setAttribute('aria-busy', 'false');

    const trophies = [
        { name: "Pionnier", desc: "Premier pas sur l'app", req: 0, icon: "🌱" }, // Toujours débloqué
        { name: "Chercheur", desc: "Atteindre 50 pts", req: 50, icon: "🕯️" },
        { name: "Explorateur", desc: "Atteindre 120 pts", req: 120, icon: "🧭" },
        { name: "Disciple", desc: "Atteindre 220 pts", req: 220, icon: "📖" },
        { name: "Semeur", desc: "Atteindre 350 pts", req: 350, icon: "🌾" },
        { name: "Serviteur", desc: "Atteindre 500 pts", req: 500, icon: "🤲" },
        { name: "Intercesseur", desc: "Atteindre 700 pts", req: 700, icon: "🙏" },
        { name: "Berger", desc: "Atteindre 950 pts", req: 950, icon: "🐑" },
        { name: "Baptisé dans la Parole", desc: "Atteindre 1 250 pts", req: 1250, icon: "🌊" },
        { name: "Veilleur", desc: "Atteindre 1 600 pts", req: 1600, icon: "🕊️" },
        { name: "Bâtisseur", desc: "Atteindre 2 000 pts", req: 2000, icon: "⛪" },
        { name: "Porteur de Lumière", desc: "Atteindre 2 500 pts", req: 2500, icon: "🪔" },
        { name: "Messager", desc: "Atteindre 3 100 pts", req: 3100, icon: "📜" },
        { name: "Héraut", desc: "Atteindre 3 800 pts", req: 3800, icon: "📣" },
        { name: "Cœur Ardent", desc: "Atteindre 4 600 pts", req: 4600, icon: "🔥" },
        { name: "Guerrier de la Foi", desc: "Atteindre 5 500 pts", req: 5500, icon: "🛡️" },
        { name: "Ancre d'Espérance", desc: "Atteindre 6 500 pts", req: 6500, icon: "⚓" },
        { name: "Lion de Juda", desc: "Atteindre 7 600 pts", req: 7600, icon: "🦁" },
        { name: "Sage", desc: "Atteindre 8 800 pts", req: 8800, icon: "⚖️" },
        { name: "Porteur de Croix", desc: "Atteindre 10 200 pts", req: 10200, icon: "✝️" },
        { name: "Vigne Fructueuse", desc: "Atteindre 11 800 pts", req: 11800, icon: "🍇" },
        { name: "Pain de Vie", desc: "Atteindre 13 600 pts", req: 13600, icon: "🍞" },
        { name: "Étoile du Matin", desc: "Atteindre 15 600 pts", req: 15600, icon: "🌟" },
        { name: "Alliance Éternelle", desc: "Atteindre 17 800 pts", req: 17800, icon: "🌈" },
        { name: "Pêcheur d'Hommes", desc: "Atteindre 20 200 pts", req: 20200, icon: "🐟" },
        { name: "Gardien des Clés", desc: "Atteindre 23 000 pts", req: 23000, icon: "🗝️" },
        { name: "Arbre de Vie", desc: "Atteindre 26 000 pts", req: 26000, icon: "🌳" },
        { name: "Aigle Renouvelé", desc: "Atteindre 29 500 pts", req: 29500, icon: "🦅" },
        { name: "Sommet de Sion", desc: "Atteindre 33 500 pts", req: 33500, icon: "⛰️" },
        { name: "Couronné", desc: "Atteindre 38 000 pts", req: 38000, icon: "👑" }
    ];
	
	
	// ==========================================
// PROGRESSION VERS LE PROCHAIN TROPHÉE
// ==========================================

const progressFill =
    document.getElementById('trophyProgressFill');

const currentPointsElement =
    document.getElementById('trophyCurrentPoints');

const nextPointsElement =
    document.getElementById('trophyNextPoints');

const nextTextElement =
    document.getElementById('trophyNextText');

const progressPercentElement =
    document.getElementById('trophyProgressPercent');

const remainingTextElement =
    document.getElementById('trophyRemainingText');


if (progressFill) {

    // Cherche le prochain trophée non débloqué
    const nextTrophy = trophies.find(
        trophy => points < trophy.req
    );


    if (nextTrophy) {

        const nextIndex =
            trophies.indexOf(nextTrophy);


        // Trophée précédent
        const previousTrophy =
            trophies[nextIndex - 1];


        const previousReq =
            previousTrophy
                ? previousTrophy.req
                : 0;


        const nextReq =
            nextTrophy.req;


        // Calcul de la progression
        const range =
            nextReq - previousReq;


        const currentProgress =
            points - previousReq;


        let progress =
            range > 0
                ? (currentProgress / range) * 100
                : 0;


        progress =
            Math.max(
                0,
                Math.min(100, progress)
            );


        // Points restants
        const remaining =
            Math.max(
                0,
                nextReq - points
            );


        // --------------------------------------
        // Mise à jour du texte
        // --------------------------------------

        if (nextTextElement) {

            nextTextElement.textContent =
                `Prochain trophée : ${nextTrophy.name}`;
        }


        if (currentPointsElement) {

            currentPointsElement.textContent =
                Math.floor(points);
        }


        if (nextPointsElement) {

            nextPointsElement.textContent =
                nextReq;
        }


        if (progressPercentElement) {

            progressPercentElement.textContent =
                `${Math.round(progress)}%`;
        }


        if (remainingTextElement) {

            remainingTextElement.textContent =
                remaining === 1
                    ? 'Encore 1 pt'
                    : `Encore ${remaining} pts`;
        }


        // --------------------------------------
        // Animation de la barre
        // --------------------------------------

        requestAnimationFrame(() => {

            progressFill.style.width =
                `${progress}%`;

            progressFill.classList.remove(
                'progress-updated'
            );

            // Force le navigateur à recalculer
            void progressFill.offsetWidth;

            progressFill.classList.add(
                'progress-updated'
            );
        });


    } else {

        // ======================================
        // TOUS LES TROPHÉES SONT DÉBLOQUÉS
        // ======================================

        if (nextTextElement) {

            nextTextElement.textContent =
                '🏆 Tous les trophées débloqués !';
        }


        if (currentPointsElement) {

            currentPointsElement.textContent =
                Math.floor(points);
        }


        if (nextPointsElement) {

            nextPointsElement.textContent =
                Math.floor(points);
        }


        if (progressPercentElement) {

            progressPercentElement.textContent =
                '100%';
        }


        if (remainingTextElement) {

            remainingTextElement.textContent =
                'Niveau maximum atteint';
        }


        requestAnimationFrame(() => {

            progressFill.style.width =
                '100%';

            progressFill.classList.add(
                'progress-updated'
            );
        });
    }
}


