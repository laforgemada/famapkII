/* =========================
   CHAT IA - BOUTON FLOTTANT
========================= */

#chat-fab-btn{
    position:fixed !important; /* Il manquait cette règle : c'est pour ça qu'il défilait avec la page */
    bottom:100px; /* Au-dessus de la bottom-nav pour ne pas la chevaucher */
    right:20px !important;
    left:auto !important;
    width:64px;
    height:64px;
    border-radius:50%;
    border:none;
    background:linear-gradient(135deg,var(--accent),var(--pink));
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:0 15px 35px rgba(236,72,153,0.5);
    cursor:pointer;
    z-index:9998; /* Sous la navbar (9999) mais au-dessus de tout le reste */
