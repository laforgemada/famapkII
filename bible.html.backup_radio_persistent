window.changeLang = function(l, btn){
    lang = l;

    const hadActiveFilters = Object.keys(activeFilters).length > 0;
    activeFilters = {};

    // Une recherche faite dans l'ancienne langue n'a aucune chance de matcher le texte
    // traduit dans la nouvelle langue : on la réinitialise pour éviter un "Aucun résultat" déroutant.
    const searchInput = document.getElementById('search');
