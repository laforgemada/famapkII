let openBookIdx = null;
let openChapterByBook = {};

window.openBook = async function(index) {
    if (openBookIdx === index) {
        openBookIdx = null; // Retaper sur le livre déjà ouvert le referme
        render();
        return;
    }
    openBookIdx = index;
    render(); // Re-render pour afficher le livre ouvert

    // Initialise le chapitre à afficher si ce n'est pas déjà fait
    if (!openChapterByBook[index] && data[lang].books[index].chapters.length > 0) {
        openChapterByBook[index] = data[lang].books[index].chapters[0].chapter; // Ouvre le chapitre 1 par défaut
    }
}

// Les fonctions ensureChapterComplete, loadBookIfNeeded, retryLoadBook sont supprimées
// car tout le contenu de la Bible est chargé localement et n'a pas besoin de vérification/rechargement API.

function openChapter(bookIdx, chapterNum) {
    openChapterByBook[bookIdx] = chapterNum;
    render();
}

window.openVerseFilterSelector = function(index, chapterNum){
    currentBookIdx = index;
    currentChapterNum = chapterNum;
    startRange = null;
    endRange = null;
    const book = data[lang].books[index];
    document.getElementById('selectedBookName').innerText = `${book.name} ${chapterNum}`;
    document.getElementById('applyFilter').style.visibility = 'hidden';
    updateGrid();
    document.getElementById('selectorOverlay').style.display = 'flex';
}

function updateGrid(){
    const grid = document.getElementById('gridContainer');
    grid.innerHTML = "";
    const book = data[lang].books[currentBookIdx];
    const chapterObj = book.chapters && book.chapters.find(c => c.chapter === currentChapterNum);
    if (!chapterObj) return;

    chapterObj.verses.forEach((_, i) => {
        const item = document.createElement('div');
        item.className = 'grid-item';
        if(startRange !== null && endRange !== null){
            if(i >= Math.min(startRange,endRange) && i <= Math.max(startRange,endRange)){
                item.className += (i === startRange || i === endRange) ? ' selected' : ' in-range';
            }
        }else if(i === startRange){
            item.className += ' selected';
        }
        item.innerText = i + 1;
        item.onclick = () => handleSelect(i);
        grid.appendChild(item);
    });
}

window.handleSelect = function(i){
    if(startRange === null || (startRange !== null && endRange !== null)){
        startRange = i;
        endRange = null;
        document.getElementById('applyFilter').style.visibility = 'hidden';
    }else{
        endRange = i;
        document.getElementById('applyFilter').style.visibility = 'visible';
    }
    updateGrid();
}

window.closeSelector = function(){
    document.getElementById('selectorOverlay').style.display = 'none';
}

window.applyFilter = function(){
    const low = Math.min(startRange, endRange);
    const high = Math.max(startRange, endRange);
    const filterKey = `${currentBookIdx}_${currentChapterNum}`;
    activeFilters[filterKey] = { start: low, end: high };
    delete visibleVerseCounts[filterKey]; // On repart de 5 versets affichés avec ce nouveau filtre
    const bookName = data[lang].books[currentBookIdx].name;

    closeSelector();
    render();
    showToast(`${bookName} ${currentChapterNum} filtré : versets ${low + 1} à ${high + 1}`, "success");
    // Note: applyFilter est maintenant uniquement pour filtrer l'affichage,
    // la sélection pour la lecture est gérée par toggleVerseSelectionForRead
}

let isSendingBibleReads = false;

window.sendAllBibleReads = async function() {

	if (!currentUsername) {
        showToast("Veuillez vous connecter.", "error");
        return;
    }

    if (sessionVersesToValidate.length === 0) {
        showToast("Aucune lecture à enregistrer.", "error");
        return;
    }

    if (isSendingBibleReads) return; // Empêche un double-envoi si l'utilisateur clique plusieurs fois

    const validateBtn = document.getElementById('validateReadBtn');
    isSendingBibleReads = true;
    if (validateBtn) {
        validateBtn.disabled = true;
        validateBtn.style.opacity = '0.75';
        validateBtn.style.cursor = 'not-allowed';
        validateBtn.innerHTML = `⏳ Enregistrement en cours...`;
    }

    try {
        const token = localStorage.getItem('token');

        const response = await fetch(`${API_BASE_URL}/api/bible/batch-finish`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                ...(token ? { 'Authorization': `Bearer ${token}` } : {})
            },
            body: JSON.stringify({
                username: currentUsername,
                reads: sessionVersesToValidate
            })
        });

        const result = await response.json();

        console.log("📖 Batch result :", result);

        if (result.success) {
            let totalVersesRead = sessionVersesToValidate.reduce((acc, read) => acc + read.verses.length, 0);
            let pointsToAward = totalVersesRead * 0.025; // Exemple: 0.5 point par verset

            if (pointsToAward > 0) {
                await fetch(`${API_BASE_URL}/api/points/add`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        username: currentUsername,
                        points: pointsToAward,
                        reason: "Lecture de la Bible (batch)"
                    })
                });

                // Mise à jour immédiate et optimiste du badge, sans attendre un rechargement
                const previousTotal = parseFloat(localStorage.getItem('cachedPointsTotal')) || 0;
                setPointsBadgeValue(previousTotal + pointsToAward);
            }
        }

        showToast(result.message, result.success ? "success" : "error");

        sessionVersesToValidate = []; // Vider la liste après envoi
        localStorage.removeItem('sessionVersesToValidate'); // Supprimer du localStorage
        render(); // Re-rendre pour effacer les sélections visuelles

    } catch (e) {
        console.error(e);
        showToast("Erreur envoi batch", "error");
    } finally {
        isSendingBibleReads = false;
        if (validateBtn) {
            validateBtn.disabled = false;
            validateBtn.style.opacity = '';
            validateBtn.style.cursor = '';
        }
        updateValidateButtonDisplay(); // Restaure le texte normal (ou masque si tout est vidé)
    }
}

window.toggleVerseSelectionForRead = function(bookIdx, chapterNum, verseIdx, element) {
    if (!currentUsername) {
        showToast("Veuillez vous connecter pour marquer les versets.", "error");
        return;
    }

    const bookName = data[lang].books[bookIdx].name;
    const actualVerseNum = verseIdx + 1;

    let bookEntry = sessionVersesToValidate.find(b => b.book === bookName && b.chapter === chapterNum);

    if (element.classList.contains('selected-for-read')) {
        // Le verset est déjà sélectionné, le retirer
        element.classList.remove('selected-for-read');
        if (bookEntry) {
            bookEntry.verses = bookEntry.verses.filter(v => v !== actualVerseNum);
            if (bookEntry.verses.length === 0) {
                sessionVersesToValidate = sessionVersesToValidate.filter(b => !(b.book === bookName && b.chapter === chapterNum));
            }
        }
    } else {
        // Le verset n'est pas sélectionné, l'ajouter
        element.classList.add('selected-for-read');
        if (bookEntry) {
            if (!bookEntry.verses.includes(actualVerseNum)) {
                bookEntry.verses.push(actualVerseNum);
                bookEntry.verses.sort((a, b) => a - b); // Garder les versets triés
            }
        } else {
            sessionVersesToValidate.push({
                book: bookName,
                chapter: chapterNum, // Vrai numéro de chapitre, plus de valeur 1 codée en dur
                verses: [actualVerseNum]
            });
        }
    }
    
    // Sauvegarder dans localStorage
    localStorage.setItem('sessionVersesToValidate', JSON.stringify({ savedAt: Date.now(), reads: sessionVersesToValidate }));
    updateValidateButtonDisplay();
}

function updateValidateButtonDisplay() {
    const validateBtn = document.getElementById('validateReadBtn');
    if (!validateBtn) return;

    if (!currentUsername) {
        validateBtn.style.display = "none";
        return;
    }

    const totalVerses = sessionVersesToValidate.reduce((acc, book) => acc + book.verses.length, 0);

    if (totalVerses > 0) {
        const estimatedPoints = (totalVerses * 0.025).toFixed(3).replace(/0+$/, '').replace(/\.$/, '');
        validateBtn.style.display = "flex";
        validateBtn.innerHTML = `📖 Valider ${totalVerses} lecture${totalVerses > 1 ? 's' : ''} <span style="opacity:0.85;font-weight:700;">· +${estimatedPoints} pts</span>`;
    } else {
        validateBtn.style.display = "none";
    }
}



/**
 * ==========================================
 * SYSTÈME DE NOTIFICATIONS TOAST
 * (remplace les alert() natifs pour une UX plus douce)
 * ==========================================
 */
function showToast(message, type = 'info', actionLabel = null, actionCallback = null, duration = 4000) {
    const container = document.getElementById('toastContainer'); // Utiliser un conteneur centralisé si disponible, sinon créer un toast isolé
    if (!container) { 
        // Fallback pour un toast isolé si pas de container global
        const div = document.createElement("div");
        div.style.position = "fixed";
        div.style.bottom = "120px";
        div.style.left = "50%";
        div.style.transform = "translateX(-50%)";
        div.style.background = type === "success" ? "#22c55e" : (type === "error" ? "#ef4444" : "#3b82f6");
        div.style.color = "white";
        div.style.padding = "12px 18px";
        div.style.borderRadius = "12px";
        div.style.fontWeight = "800";
        div.style.zIndex = "99999";
        div.style.display = "flex";
        div.style.alignItems = "center";
        div.style.gap = "14px";
        div.style.maxWidth = "90vw";
        div.style.transition = "opacity 0.3s ease-out, transform 0.3s ease-out";
        div.style.opacity = "0";
        div.style.transform = "translateX(-50%) translateY(20px)"; // Initial position for animation

        const text = document.createElement("span");
        text.innerText = message;
        div.appendChild(text);

        if (actionLabel && actionCallback) {
            const actionBtn = document.createElement("button");
            actionBtn.innerText = actionLabel;
            actionBtn.style.background = "rgba(255,255,255,0.25)";
            actionBtn.style.border = "none";
            actionBtn.style.color = "white";
            actionBtn.style.fontWeight = "900";
            actionBtn.style.padding = "6px 12px";
            actionBtn.style.borderRadius = "8px";
            actionBtn.style.cursor = "pointer";
            actionBtn.style.flexShrink = "0";
            actionBtn.onclick = () => {
                actionCallback();
                div.remove();
            };
            div.appendChild(actionBtn);
        }

        document.body.appendChild(div);
        // Animate in
        setTimeout(() => {
            div.style.opacity = "1";
            div.style.transform = "translateX(-50%) translateY(0)";
        }, 10); // Small delay to allow CSS transition

        setTimeout(() => {
            // Animate out
            div.style.opacity = "0";
            div.style.transform = "translateX(-50%) translateY(20px)";
            setTimeout(() => div.remove(), 300); // Remove after animation
        }, duration);
        return;
    }

    // Si un toastContainer global existe (comme dans espace_personnel.html),
    // on l'utilise pour une interface unifiée.
    const icons = { success: 'check-circle', error: 'alert-circle', info: 'info' };
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.setAttribute('role', 'status');
    toast.innerHTML = `
        <div class="toast-icon"><i data-feather="${icons[type] || 'info'}"></i></div>
        <span>${message}</span>
        <button class="toast-close" aria-label="Fermer la notification">
            <i data-feather="x"></i>
        </button>
    `;
    container.appendChild(toast);
    safeFeatherReplace();

    const remove = () => {
        toast.classList.add('hide');
        setTimeout(() => toast.remove(), 250);
    };

    if (actionLabel && actionCallback) {
        const actionBtn = document.createElement("button");
        actionBtn.innerText = actionLabel;
        actionBtn.className = "toast-action-btn"; // Ajoutez une classe pour le styliser
        actionBtn.onclick = () => {
            actionCallback();
            remove(); // Ferme le toast après l'action
        };
        toast.appendChild(actionBtn);
    }


    toast.querySelector('.toast-close').addEventListener('click', remove);
    setTimeout(remove, duration);
}

/* ==========================================
 * LOGIQUE FONCTIONNELLE DU CHAT IA
 * ========================================== */

let allConversations = {}; // Stocke toutes les conversations de l'utilisateur actuel (ou par défaut)
let currentConversationId = null; // ID de la conversation actuellement affichée
let isAILoading = false; // Indique si l'IA est en train de répondre
const defaultWelcomeMessage = "Bonjour ! Je suis votre conseiller biblique IA. Comment puis-je vous aider aujourd'hui concernant la Bible ?";

function generateConversationId() {
    return 'conv-' + Date.now() + '-' + Math.random().toString(36).substr(2, 9);
}

function getFirstMessageSnippet(messages) {
    if (messages.length > 1) { // Skip the initial AI welcome message for snippet
        const userMsg = messages.find(msg => msg.sender === 'user');
        if (userMsg) {
            return userMsg.text.substring(0, 30) + (userMsg.text.length > 30 ? '...' : '');
        }
    }
    return "Nouvelle conversation"; // Default title for new empty chats
}

function loadUserConversations() {
    const storageKey = currentUsername ? `bibleAIChatConversations_${currentUsername}` : 'bibleAIChatConversations_default';
    const savedConversations = localStorage.getItem(storageKey);
    if (savedConversations) {
        allConversations = JSON.parse(savedConversations);
    } else {
        allConversations = {};
    }
    // Si aucune conversation n'existe, en créer une par défaut
    if (Object.keys(allConversations).length === 0) {
        startNewConversation(false); // Créer sans afficher le toast
    } else {
        // Restaurer la dernière conversation ouverte ou la première disponible
        const lastConversationId = localStorage.getItem(`${storageKey}_lastActive`);
        if (lastConversationId && allConversations[lastConversationId]) {
            currentConversationId = lastConversationId;
        } else {
            currentConversationId = Object.keys(allConversations)[0];
        }
    }
}

function saveUserConversations() {
    const storageKey = currentUsername ? `bibleAIChatConversations_${currentUsername}` : 'bibleAIChatConversations_default';
    localStorage.setItem(storageKey, JSON.stringify(allConversations));
    if (currentConversationId) {
        localStorage.setItem(`${storageKey}_lastActive`, currentConversationId);
    }
}

function initChat() {
    const chatInput = document.getElementById('chat-input');
    const chatSendBtn = document.getElementById('chat-send-btn');
    const chatFabBtn = document.getElementById('chat-fab-btn');
    const newChatBtn = document.getElementById('new-chat-btn');
    const deleteChatBtn = document.getElementById('delete-chat-btn');
    const toggleHistoryBtn = document.getElementById('toggle-history-btn');
    const closeHistoryBtn = document.getElementById('close-history-btn');

    // Le bouton FAB est toujours visible, mais désactivé si l'utilisateur n'est pas connecté
    if (!currentUsername) {
        chatFabBtn.disabled = true; // Désactive le bouton FAB
        chatInput.disabled = true;
        chatSendBtn.disabled = true;
        chatInput.placeholder = "Connectez-vous pour utiliser le chat IA...";
        // Désactiver les boutons de gestion de conversation si non connecté
        newChatBtn.disabled = true;
        deleteChatBtn.disabled = true;
    } else {
        chatFabBtn.disabled = false; // Active le bouton FAB
        chatInput.disabled = false;
        chatSendBtn.disabled = false;
        chatInput.placeholder = "Demandez un conseil biblique...";
        // Activer les boutons de gestion de conversation
        newChatBtn.disabled = false;
        deleteChatBtn.disabled = false;
    }

    chatSendBtn.addEventListener('click', sendMessage);
    chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && !chatInput.disabled) {
            sendMessage();
        }
    });

    newChatBtn.addEventListener('click', () => startNewConversation(true));
    deleteChatBtn.addEventListener('click', () => deleteConversation(currentConversationId));
    toggleHistoryBtn.addEventListener('click', toggleHistorySidebar);
    closeHistoryBtn.addEventListener('click', toggleHistorySidebar);

    loadUserConversations();
    renderChatMessages(); // Affiche la conversation actuelle
    renderConversationList(); // Affiche la liste des conversations
    saveUserConversations(); // Sauvegarde l'état initial (avec ou sans nouvelle conversation)
}

function openChat() {
    document.getElementById('chat-overlay').style.display = 'flex';
    safeFeatherReplace();
    // Scroll au dernier message après un court délai pour s'assurer que le rendu est complet
    setTimeout(() => {
        const chatMessagesContainer = document.getElementById('chat-messages');
        chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
    }, 100);
}

window.closeChat = function() {
    document.getElementById('chat-overlay').style.display = 'none';
    const historySidebar = document.getElementById('chat-history-sidebar');
    if (historySidebar.classList.contains('active')) {
        historySidebar.classList.remove('active'); // Fermer la sidebar si ouverte
    }
}

window.toggleHistorySidebar = function() {
    document.getElementById('chat-history-sidebar').classList.toggle('active');
    safeFeatherReplace(); // Re-rendre les icônes après affichage
}

window.startNewConversation = function(showToastMessage = true) {
    const newId = generateConversationId();
    allConversations[newId] = {
        id: newId,
        title: "Nouvelle conversation", // Titre par défaut
        messages: [{ sender: 'ai', text: defaultWelcomeMessage, timestamp: Date.now() }]
    };
    currentConversationId = newId;
    saveUserConversations();
    renderConversationList();
    renderChatMessages();
    if (showToastMessage) showToast("Nouvelle conversation créée !", "success");
    document.getElementById('chat-history-sidebar').classList.remove('active'); // Fermer la sidebar
}

window.deleteConversation = function(conversationIdToDelete) {
    if (!conversationIdToDelete) return;

    if (Object.keys(allConversations).length === 1 && currentConversationId === conversationIdToDelete) {
        showToast("Vous ne pouvez pas supprimer la dernière conversation. Créez-en une nouvelle d'abord.", "error");
        return;
    }

    // Suppression instantanée (plus de confirm() bloquant), avec possibilité d'annuler via le toast.
    const deletedConversation = allConversations[conversationIdToDelete];
    const wasCurrentConversation = conversationIdToDelete === currentConversationId;
    const previousConversationId = currentConversationId;

    delete allConversations[conversationIdToDelete];

    if (wasCurrentConversation) {
        const remainingConversationIds = Object.keys(allConversations);
        currentConversationId = remainingConversationIds.length > 0 ? remainingConversationIds[0] : null;
        if (!currentConversationId) {
            startNewConversation(false);
        }
    }

    saveUserConversations();
    renderConversationList();
    renderChatMessages();

    showToast("Conversation supprimée", "success", "Annuler", () => {
        allConversations[conversationIdToDelete] = deletedConversation;
        currentConversationId = previousConversationId;
        saveUserConversations();
        renderConversationList();
        renderChatMessages();
    });
}

window.switchConversation = function(conversationId) {
    if (conversationId === currentConversationId) return; // Déjà sur cette conversation
    currentConversationId = conversationId;
    saveUserConversations();
    renderChatMessages();
    document.getElementById('chat-history-sidebar').classList.remove('active'); // Fermer la sidebar
}

function renderConversationList() {
    const conversationListContainer = document.getElementById('conversation-list');
    if (!conversationListContainer) return;

    conversationListContainer.innerHTML = '';
    const sortedConversationIds = Object.keys(allConversations).sort((a, b) => {
        const dateA = allConversations[a].messages.length > 0 ? allConversations[a].messages[allConversations[a].messages.length - 1].timestamp : 0;
        const dateB = allConversations[b].messages.length > 0 ? allConversations[b].messages[allConversations[b].messages.length - 1].timestamp : 0;
        return dateB - dateA; // Plus récent en premier
    });

    sortedConversationIds.forEach(convId => {
        const conversation = allConversations[convId];
        const item = document.createElement('li');
        item.className = `conversation-item ${convId === currentConversationId ? 'active' : ''}`;
        item.innerHTML = `
            <span class="conversation-item-title">${escapeHTML(conversation.title || getFirstMessageSnippet(conversation.messages))}</span>
            <button class="conversation-item-delete" data-conv-id="${convId}" title="Supprimer">
                <i data-feather="trash-2"></i>
            </button>
        `;
        item.addEventListener('click', (e) => {
            if (!e.target.closest('.conversation-item-delete')) {
                switchConversation(convId);
            }
        });
        item.querySelector('.conversation-item-delete').addEventListener('click', (e) => {
            e.stopPropagation(); // Empêche l'activation de la conversation
            deleteConversation(convId);
        });
        conversationListContainer.appendChild(item);
    });
    safeFeatherReplace();
}

// Permet de renvoyer un message dont l'appel API a échoué, sans avoir à le retaper
window.retryFailedMessage = function(text) {
    if (!text || isAILoading) return;
    const chatInput = document.getElementById('chat-input');
    chatInput.value = text;
    sendMessage();
}

async function sendMessage() {
    const chatInput = document.getElementById('chat-input');
    const messageText = chatInput.value.trim();

    if (messageText === "" || isAILoading || !currentConversationId) return;

    const currentConversation = allConversations[currentConversationId];
    if (!currentConversation) return; // Devrait toujours exister

    // Ajouter le message de l'utilisateur
    currentConversation.messages.push({ sender: 'user', text: messageText, timestamp: Date.now() });
    
    // Si c'est le premier message après le message d'accueil de l'IA, mettre à jour le titre
    if (currentConversation.messages.length === 2 && currentConversation.title === "Nouvelle conversation") {
        currentConversation.title = getFirstMessageSnippet(currentConversation.messages);
        renderConversationList(); // Mettre à jour la liste des conversations
    }

    renderChatMessages();
    chatInput.value = ''; // Vider le champ de saisie
    showChatLoading(true); // Afficher le spinner de chargement
    
    saveUserConversations(); // Sauvegarder l'état actuel

    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${API_BASE_URL}/api/chat/bible-advice`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                ...(token ? { 'Authorization': `Bearer ${token}` } : {})
            },
            body: JSON.stringify({
                username: currentUsername,
                conversation_id: currentConversationId, // Envoyer l'ID de conversation au backend
                message: messageText
            })
        });

        const result = await response.json();

        if (response.ok && result.response) {
            currentConversation.messages.push({ sender: 'ai', text: result.response, timestamp: Date.now() });
        } else {
            currentConversation.messages.push({ sender: 'ai', text: "Désolé, je n'ai pas pu obtenir de réponse. Veuillez réessayer.", timestamp: Date.now(), failed: true, retryText: messageText });
        }
    } catch (error) {
        console.error("Erreur API Chat IA:", error);
        currentConversation.messages.push({ sender: 'ai', text: "Une erreur est survenue lors de la communication avec l'IA.", timestamp: Date.now(), failed: true, retryText: messageText });
    } finally {
        showChatLoading(false); // Masquer le spinner
        renderChatMessages(); // Re-rendre pour afficher la réponse
        saveUserConversations(); // Sauvegarder après la réponse de l'IA
        renderConversationList(); // Mettre à jour la liste si l'ordre a changé (par date)
    }
}

function renderChatMessages() {
    const chatMessagesContainer = document.getElementById('chat-messages');
    const currentChatTitle = document.getElementById('current-chat-title');

    if (!currentConversationId || !allConversations[currentConversationId]) {
        chatMessagesContainer.innerHTML = `<div style="text-align:center; padding:50px 10px; color:var(--text-muted); font-weight:700;">Aucune conversation sélectionnée.</div>`;
        currentChatTitle.innerText = "Aucun chat";
        return;
    }

    const currentConversation = allConversations[currentConversationId];
    chatMessagesContainer.innerHTML = ''; // Vider les messages existants
    currentChatTitle.innerText = currentConversation.title || "Nouvelle conversation";

    currentConversation.messages.forEach(msg => {
        const messageRow = document.createElement('div');
        messageRow.className = `chat-message-row ${msg.sender}-row`;

        const avatar = document.createElement('div');
        avatar.className = `chat-message-avatar ${msg.sender}-avatar`;
        avatar.innerText = msg.sender === 'user' ? (currentUsername ? currentUsername.substring(0, 2).toUpperCase() : 'ME') : 'AI';

        const messageBubble = document.createElement('div');
        messageBubble.className = `chat-message-bubble ${msg.sender}`;
        messageBubble.innerText = msg.text;

        if (msg.failed && msg.retryText) {
            const retryBtn = document.createElement('button');
            retryBtn.type = 'button';
            retryBtn.className = 'chat-retry-btn';
            retryBtn.innerText = '🔄 Réessayer';
            retryBtn.onclick = () => retryFailedMessage(msg.retryText);
            messageBubble.appendChild(retryBtn);
        }

        // L'ordre des éléments dépend de l'expéditeur pour un bon alignement avec flexbox
        if (msg.sender === 'user') {
            messageRow.appendChild(messageBubble);
            messageRow.appendChild(avatar);
        } else {
            messageRow.appendChild(avatar);
            messageRow.appendChild(messageBubble);
        }
        
        chatMessagesContainer.appendChild(messageRow);
    });

    // Scroller vers le bas pour voir le dernier message
    chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
}

function showChatLoading(show) {
    const aiTypingIndicator = document.getElementById('ai-typing-indicator');
    const chatInput = document.getElementById('chat-input');
    const chatSendBtn = document.getElementById('chat-send-btn');
    const chatMessagesContainer = document.getElementById('chat-messages');
    
    isAILoading = show; // Mettre à jour l'état de chargement
    aiTypingIndicator.style.display = show ? 'flex' : 'none';
    chatInput.disabled = show;
    chatSendBtn.disabled = show;

    if (show) {
        chatInput.placeholder = "L'IA réfléchit...";
        // Scroller vers le bas pour que l'indicateur de saisie soit visible
        chatMessagesContainer.scrollTop = chatMessagesContainer.scrollHeight;
    } else {
        chatInput.placeholder = "Demandez un conseil biblique...";
    }
}

function renderBibleToastGroup() {
    const old = document.getElementById("bible-toast-group");
    if (old) old.remove();

    const box = document.createElement("div");
    box.id = "bible-toast-group";

    box.style.position = "fixed";
    box.style.bottom = "120px";
    box.style.left = "50%";
    box.style.transform = "translateX(-50%)";
    box.style.background = "white";
    box.style.padding = "15px";
    box.style.borderRadius = "16px";
    box.style.boxShadow = "0 10px 30px rgba(0,0,0,0.2)";
    box.style.zIndex = "9999";
    box.style.maxWidth = "300px";
    box.style.fontSize = "14px";
    box.style.fontWeight = "600";

    let html = `<div style="margin-bottom:8px;font-weight:900;">📖 Lecture enregistrée :</div>`;

    bibleReads.forEach(msg => {
        html += `<div style="margin:4px 0;">• ${msg}</div>`;
    });

    box.innerHTML = html;

    document.body.appendChild(box);

    setTimeout(() => {
        bibleReads = [];
        box.remove();
    }, 4000);
}

let currentSearchTerm = "";

function escapeHTML(str) {
    if (typeof str !== 'string') return str;
    return str.replace(/[&<>"']/g, (match) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    }[match]));
}

function escapeRegExp(str) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function highlightMatch(text, term) {
    if (!term) return text;
    const regex = new RegExp(escapeRegExp(term), 'gi');
    return text.replace(regex, (match) => `<mark class="search-highlight">${match}</mark>`);
}

function render(){
    const c = document.getElementById('container');
    const d = data[lang];
    document.getElementById('search').placeholder = d.search;

    const searchVal = currentSearchTerm.trim();
    const searchValUpper = searchVal.toUpperCase();

    let html = `<div class="title-divider">${d.at}</div>`;
    let visibleBookCount = 0;

    d.books.forEach((b, i) => {
        if (i === 39) { // Livre n°40 (index 39) = premier livre du Nouveau Testament
            html += `<div class="title-divider">${d.nt}</div>`;
        }

        const bookNameMatches = searchVal ? b.name.toUpperCase().includes(searchValUpper) : true;

        // La recherche plein texte ne porte que sur les livres déjà chargés au moins une fois
        // (impossible de chercher dans du contenu qui n'a pas encore été récupéré depuis l'API).
        let searchMatch = null; // { chapterNum }
        if (searchVal && b.chapters) {
            for (const ch of b.chapters) {
                if (ch.verses.some(v => v.toUpperCase().includes(searchValUpper))) {
                    searchMatch = { chapterNum: ch.chapter };
                    break;
                }
            }
        }

        if (searchVal && !bookNameMatches && !searchMatch) {
            return; // Ce livre ne correspond pas à la recherche : on le masque
        }

        visibleBookCount++;

        // Si une correspondance est trouvée dans la recherche, le livre et le chapitre correspondants sont ouverts.
        if (searchVal && searchMatch) {
            openBookIdx = i;
            openChapterByBook[i] = searchMatch.chapterNum;
        }
        const isOpen = openBookIdx === i;

        html += `
        <div class="book ${isOpen ? 'open' : ''}">
            <div class="book-header" onclick="openBook(${i})">
                <div class="book-left">
                    <div class="book-icon"><i data-feather="book"></i></div>
                    <div>
                        <div class="book-name">${b.name}</div>
                        <div class="book-mini">${b.chapters ? `${b.chapters.length} chapitres` : 'Contenu non disponible'}${searchVal && searchMatch ? ` • trouvé au chapitre ${searchMatch.chapterNum}` : ''}</div>
                    </div>
                </div>
                <i data-feather="chevron-down"></i>
            </div>
            <div class="book-content">`;

        if (isOpen) {
            // Puisque les données sont chargées localement, il n'y a plus d'état de "loading" ou "error" lié à l'API.
            // On vérifie directement si les chapitres sont disponibles.
            if (b.chapters) {
                const activeChapterNum = openChapterByBook[i] || b.chapters[0].chapter;
                const chapterObj = b.chapters.find(ch => ch.chapter === activeChapterNum);

                if (chapterObj) {
                    const filterKey = `${i}_${activeChapterNum}`;
                    const filter = activeFilters[filterKey];
                    const isFiltered = filter !== undefined;

                    html += `<div class="chapter-title">${d.chapterLabel} ${activeChapterNum}</div>`; // Ajout du titre du chapitre

                    html += `<div class="chapter-tools chapter-tools-top">
                        <button class="book-filter-btn" onclick="openVerseFilterSelector(${i}, ${activeChapterNum});" title="Filtrer les versets" aria-label="Filtrer les versets de ce chapitre">
                            <i data-feather="filter"></i> Filtrer ce chapitre
                        </button>
                        ${isFiltered ? `<button class="btn-reset" onclick="resetFilter(${i}, ${activeChapterNum})">Voir tout le chapitre</button>` : ''}
                    </div>`;

                    // On ne garde que les versets à afficher selon le filtre actif...
                    const versesToDisplay = chapterObj.verses
                        .map((t, vi) => ({ t, vi }))
                        .filter(({ vi }) => !isFiltered || (vi >= filter.start && vi <= filter.end));

                    // ...puis on n'en affiche qu'une partie (5 par défaut), le
                    // reste se charge automatiquement au défilement plutôt que
                    // de tout rendre d'un coup (long pour les gros chapitres).
                    const shownCount = visibleVerseCounts[filterKey] || VERSES_PER_PAGE;
                    const versesSlice = versesToDisplay.slice(0, shownCount);
                    const remaining = versesToDisplay.length - versesSlice.length;

                    html += versesSlice.map(({ t, vi }) => {
                        const isSelected = sessionVersesToValidate.some(bookEntry =>
                            bookEntry.book === b.name && bookEntry.chapter === activeChapterNum && bookEntry.verses.includes(vi + 1)
                        ) ? 'selected-for-read' : '';
                        const displayText = searchVal ? highlightMatch(t, searchVal) : t;
                        return `<div class="verse ${isSelected}" onclick="toggleVerseSelectionForRead(${i}, ${activeChapterNum}, ${vi}, this)"><span class="num">${vi + 1}</span>${displayText}</div>`;
                    }).join('');

                    if (remaining > 0) {
                        html += `<div class="verse-load-sentinel" data-verse-key="${filterKey}">
                            <span class="verse-load-spinner"></span> Chargement des versets suivants (${remaining} restant${remaining > 1 ? 's' : ''})...
                        </div>`;
                    }
                }
            }
        }

        html += `</div></div>`;
    });

    if (searchVal && visibleBookCount === 0) {
        html += `<div class="empty-search-state">🔍 Aucun résultat pour « ${escapeHTML(searchVal)} » parmi les livres déjà consultés. Ouvrez d'autres livres pour élargir la recherche.</div>`;
    }

    c.innerHTML = html;
    safeFeatherReplace();

    // Ré-attache l'observateur de défilement à la (nouvelle) sentinelle,
    // puisque tout le HTML a été régénéré (l'ancien nœud n'existe plus).
    document.querySelectorAll('.verse-load-sentinel').forEach(el => verseLoadObserver.observe(el));
}

window.resetFilter = function(i, chapterNum){
    delete activeFilters[`${i}_${chapterNum}`];
    delete visibleVerseCounts[`${i}_${chapterNum}`];
    render();
}

let searchTimeout;
document.getElementById('search').addEventListener('input', e => {
    clearTimeout(searchTimeout);
    const query = e.target.value;
    searchTimeout = setTimeout(() => {
        currentSearchTerm = query;
        render();
    }, 300); // Délai de 300ms avant de déclencher la recherche pour réduire la charge CPU client.
});
</script>

