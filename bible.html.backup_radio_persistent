            margin-top: 5px; /* Aligner avec le haut de la bulle */
        }

        .chat-message-avatar.user-avatar {
            background: #4aadde;
            order: 2; /* Pour aligner l'avatar à droite pour l'utilisateur */
        }
        .chat-message-avatar.ai-avatar {
            background: linear-gradient(135deg, var(--secondary), var(--pink)); /* Gradient pour l'IA */
            order: 1; /* Pour aligner l'avatar à gauche pour l'IA */
        }

        .chat-message-bubble {
            max-width: 75%; /* Légèrement réduit pour laisser de la place aux avatars */
            padding: 12px 18px;
            border-radius: 20px;
            line-height: 1.5;
            font-size: 0.9rem;
            box-shadow: var(--shadow);
            animation: fadeInMessage 0.3s ease-out;
            margin-top: 5px; /* Pour l'alignement visuel */
            position: relative;
        }

        .chat-message-bubble.user {
            background: #4aadde;
            color: white;
            border-bottom-right-radius: 5px;
            order: 1; /* Pour aligner la bulle à gauche de l'avatar pour l'utilisateur */
        }

        .chat-message-bubble.ai {
            background: var(--surface);
            color: var(--text-main);
            border: 1px solid var(--bg);
            border-bottom-left-radius: 5px;
            order: 2; /* Pour aligner la bulle à droite de l'avatar pour l'IA */
        }

        .chat-retry-btn {
            display: block;
            margin-top: 8px;
            border: none;
            background: var(--danger);
            color: white;
            font-weight: 800;
            font-size: 0.78rem;
            padding: 7px 14px;
            border-radius: 10px;
            cursor: pointer;
        }
        .chat-retry-btn:hover {
            opacity: 0.9;
        }

        @keyframes fadeInMessage {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Indicateur de saisie de l'IA */
        .typing-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 20px;
            background: var(--surface);
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 600;
            box-shadow: var(--shadow);
            width: fit-content;
            margin-left: 5px; /* Aligner avec les messages de l'IA */
            animation: fadeInMessage 0.3s ease-out;
            order: 2; /* Pour s'aligner avec les bulles de l'IA */
        }
        .typing-indicator .dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            background-color: var(--secondary);
            border-radius: 50%;
            animation: bounce 1.4s infinite ease-in-out both;
        }
        .typing-indicator .dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-indicator .dot:nth-child(2) { animation-delay: -0.16s; }
        .typing-indicator .dot:nth-child(3) { animation-delay: 0s; }

        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        #chat-input-area {
            display: flex;
            padding: 15px 20px;
            border-top: 1px solid var(--bg);
            gap: 10px;
            background: var(--surface);
            align-items: center;
            position: sticky; /* Pour le garder en bas lors du défilement */
            bottom: 0;
            left: 0;
            right: 0;
        }

        #chat-input {
            flex: 1;
            border: 1px solid #e2e8f0;
            border-radius: 25px;
            padding: 12px 18px;
            font-family: inherit;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        #chat-input:focus {
            border-color: #4aadde;
            box-shadow: 0 0 0 3px rgba(22,163,74,0.1);
        }

        #chat-send-btn {
            background: linear-gradient(135deg, #4aadde, var(--secondary));
            color: white;
            border: none;
            border-radius: 50%;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(22,163,74,0.25);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        #chat-send-btn:hover {
            transform: translateY(-1px) scale(1.05);
            box-shadow: 0 8px 20px rgba(22,163,74,0.35);
        }
        #chat-send-btn i {
            width: 20px;
            height: 20px;
        }

        #chat-loading-spinner {
            display: none; /* Masqué par défaut */
            width: 30px;
            height: 30px;
            border: 4px solid rgba(0,0,0,.1);
            border-top-color: var(--secondary);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Responsive adjustments for chat */
        @media (max-width: 480px) {
            #chat-fab-btn {
                width: 66px;
                height: 66px;
                bottom: 195px;
                right: 15px !important;
                left: auto !important;
                box-shadow: 0 10px 25px rgba(236,72,153,0.5);
            }
            #chat-card {
                max-height: 90vh;
                border-radius: 30px 30px 0 0;
            }
            #chat-header {
                padding: 15px 15px; /* Plus compact sur mobile */
            }
            #chat-header .chat-controls-left,
            #chat-header .chat-controls-right {
                gap: 8px; /* Espacement réduit sur mobile */
            }
            #chat-header .chat-current-title {
                font-size: 0.95rem; /* Taille de titre plus petite sur mobile */
            }
            .chat-icon-btn,
            .chat-close-btn {
                width: 36px; /* Boutons plus petits sur mobile */
                height: 36px;
            }
            .chat-icon-btn i,
            .chat-close-btn i {
                width: 16px; /* Icônes plus petites sur mobile */
                height: 16px;
            }
            #chat-history-sidebar .sidebar-header {
                padding: 15px 15px;
            }
            .conversation-item {
                padding: 10px 15px;
                font-size: 0.85rem;
            }
            #chat-messages {
                padding: 15px;
            }
            #chat-input-area {
                padding: 10px 15px;
            }
            #chat-input {
                padding: 10px 15px;
            }
            #chat-send-btn {
                width: 40px;
                height: 40px;
            }
        }
		
		/* =========================
