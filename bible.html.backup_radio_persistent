    margin-bottom:14px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    margin-top:24px;
}

.hero-btn{
    border:none;
    border-radius:18px;
    padding:14px 18px;
    font-weight:800;
    display:flex;
