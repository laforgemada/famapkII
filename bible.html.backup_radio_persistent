<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>Apokalypsy Bible | Premium</title>

    <script>
        // Appliqué immédiatement (avant le CSS/rendu) pour éviter le flash de thème clair
        (function() {
            try {
                const saved = localStorage.getItem('theme');
                const theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {}
        })();
    </script>

    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"></noscript>
    <script src="https://unpkg.com/feather-icons"></script>

    <link rel="stylesheet" href="css/espace_personnel.css">
    <style>
        :root{
            --primary:#16a34a;
            --primary-2:#22c55e;
            --secondary:#7c3aed;
            --accent:#f59e0b;
            --pink:#ec4899;
            --success:#16a34a;
            --danger:#ef4444;

            --bg:#f4f6f8;
            --surface:#ffffff;
            --surface-2:#f1f4f8;
            --text-main:#0f172a;
            --text-muted:#64748b;
            --muted:#64748b;
            --border:#e7ebf1;
            --glass:rgba(255,255,255,0.82);

            --hero-gradient:
                linear-gradient(135deg, #143a2e 0%, #0f2e3d 55%, #1c1440 100%);

            --hero:
                linear-gradient(135deg, #143a2e 0%, #0f2e3d 55%, #1c1440 100%);

            --gradient:
                linear-gradient(135deg, #16a34a 0%, #15803d 100%);

            --card-gradient:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,1),
                    rgba(255,255,255,0.95)
                );

            --shadow:
                0 8px 20px rgba(15,23,42,0.06);

            --shadow-big:
                0 15px 40px rgba(22,163,74,0.12);

            --radius-lg:26px;
            --radius-md:16px;
            --radius-pill:100px;
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);

            --verse-font-size: 0.95rem; /* Réglable via les boutons A-/A+ */
        }

        /* =========================
        MODE SOMBRE
        ========================= */
        html[data-theme="dark"] {
            --bg:#0a0a0d;
            --surface:#16171d;
            --surface-2:#1d1e26;
            --text-main:#f5f5f7;
            --text-muted:#9a9ba7;
            --muted:#9a9ba7;
            --border:rgba(255,255,255,0.08);
            --glass:rgba(10,10,13,0.82);

            --card-gradient:
                linear-gradient(
                    135deg,
                    rgba(22,23,29,1),
                    rgba(22,23,29,0.95)
                );

            --shadow:
                0 8px 20px rgba(0,0,0,0.4);

            --shadow-big:
                0 15px 40px rgba(0,0,0,0.5);
        }

        html[data-theme="dark"] body {
            background: var(--bg);
            color: var(--text-main);
        }

        html[data-theme="dark"] .book {
            border-color: var(--border);
        }

        html[data-theme="dark"] .book-header:hover {
            background: rgba(255,255,255,0.04);
        }

        html[data-theme="dark"] .verse{
            background: var(--surface-2);
        }

        html[data-theme="dark"] .verse:hover {
            background: #20222b;
        }

        html[data-theme="dark"] .verse.selected-for-read {
            background: rgba(34,197,94,0.16);
            border: 1px solid rgba(34,197,94,0.4);
        }

        html[data-theme="dark"] .selector-card{
            background: var(--surface);
        }
        html[data-theme="dark"] .selector-close-btn{
            background: var(--surface-2);
        }
        html[data-theme="dark"] .selector-close-btn:hover,
        html[data-theme="dark"] .chat-icon-btn:hover,
        html[data-theme="dark"] .chat-close-btn:hover {
            background: rgba(255,255,255,0.08);
        }

        html[data-theme="dark"] .grid-item {
            background: var(--surface-2);
            border-color: var(--border);
        }
        html[data-theme="dark"] .grid-item:hover {
            background: #20222b;
            border-color: rgba(255,255,255,0.2);
        }
        html[data-theme="dark"] .grid-item.in-range {
            background: rgba(34,197,94,0.16);
            border-color: rgba(34,197,94,0.4);
            color:#4ade80;
        }
        html[data-theme="dark"] .grid-item.selected{
            box-shadow:0 5px 15px rgba(22,163,74,0.35);
        }

        html[data-theme="dark"] #chat-input {
            background: var(--surface-2);
            color: var(--text-main);
            border-color: rgba(255,255,255,0.12);
        }

        html[data-theme="dark"] .chapter-select-wrap {
            border-color: var(--border);
            background: var(--surface-2);
        }

        html[data-theme="dark"] .book-icon,
        html[data-theme="dark"] .num,
        html[data-theme="dark"] .book-filter-btn,
        html[data-theme="dark"] .btn-reset,
        html[data-theme="dark"] .grid-item.selected{
            color:#c5e1ce;
        }

        html[data-theme="dark"] .top-nav{
            background:rgba(6,7,10,0.92);
        }

        html[data-theme="dark"] .bottom-bar{
            background:rgba(12,12,15,0.96);
            border:1px solid var(--border);
        }

        html[data-theme="dark"] .notif-dropdown{
            background: var(--surface);
            border:1px solid var(--border);
        }

        html[data-theme="dark"] .theme-toggle .feather-moon { display:none; }
        html[data-theme="dark"] .theme-toggle .feather-sun { display:inline-flex; }
        .theme-toggle .feather-sun { display:none; }

        *, *::before, *::after {
            box-sizing:border-box;
            margin:0;
            padding:0;
            -webkit-tap-highlight-color:transparent;
        }

        body{
            font-family:'Plus Jakarta Sans',sans-serif;
            background:var(--bg);
            color:var(--text-main);
            padding-top:90px; /* Légèrement réduit pour un look plus compact */
            padding-bottom:120px;
            line-height:1.6; /* Améliore la lisibilité */
            font-size:15px; /* Légèrement plus grand pour la lisibilité */
            transition: background 0.25s ease, color 0.25s ease;
        }

        /* =====================================
        HEADER PREMIUM (UNIFIÉ)
        ===================================== */
        .top-nav{
            position:fixed;
            top:0;
            width:100%;
            z-index:1000;
            background:rgba(15,23,42,0.92);
            backdrop-filter:blur(18px);
            border-bottom:1px solid rgba(255,255,255,0.08);
            padding-top:var(--safe-top);
        }

        .nav-content{
            display:flex;
            justify-content:space-between;
            align-items:center;
            padding:12px 18px; /* Légèrement ajusté */
        }

        .logo-box{
            display:flex;
            align-items:center;
            gap:10px; /* Espacement un peu réduit */
        }

        .logo-icon{
            width:48px; /* Légèrement plus grand */
            height:48px; /* Légèrement plus grand */
            border-radius:18px; /* Légèrement plus arrondi */
            background:var(--hero);
            display:flex;
            align-items:center;
            justify-content:center;
            color:white;
            box-shadow:0 12px 25px rgba(22,163,74,0.35); /* Ombre cohérente avec la marque */
        }

        .logo-icon img{ /* Style pour l'image du logo */
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 50%; /* Pour correspondre au style circulaire */
        }

        .logo-text{
            color:white;
        }

        .logo-title{
            font-weight:900;
            letter-spacing:0.8px; /* Espacement plus subtil */
            font-size:1rem; /* Légèrement plus grand */
        }

        .logo-sub{
            font-size:0.75rem; /* Légèrement plus grand */
            color:rgba(255,255,255,0.7); /* Plus opaque */
        }

        .nav-right{
            display:flex;
            align-items:center;
            gap:12px; /* Espacement un peu plus grand */
        }

        .nav-btn{
            width:44px; /* Légèrement plus grand */
            height:44px; /* Légèrement plus grand */
            border-radius:15px; /* Légèrement plus arrondi */
            border:none;
            background:rgba(255,255,255,0.1); /* Plus de contraste */
            color:white;
            display:flex;
            align-items:center;
            justify-content:center;
            position:relative;
            cursor:pointer;
            transition:background 0.2s ease, transform 0.2s ease; /* Transition pour un effet premium */
        }
        .nav-btn:hover {
            background:rgba(255,255,255,0.15); /* Effet au survol */
            transform: translateY(-1px);
        }

        .nav-btn i{
            width:19px; /* Légèrement plus grand */
            height:19px; /* Légèrement plus grand */
        }

        .points-badge{
            display:flex;
            align-items:center;
            gap:6px;
            background:rgba(245,158,11,0.16);
            border:1px solid rgba(245,158,11,0.35);
            color:#f59e0b;
            font-weight:900;
            font-size:0.78rem;
            padding:7px 12px;
            border-radius:100px;
        }
        .points-badge i{
            width:14px;
            height:14px;
        }

        .notif-badge{
            position:absolute;
            top:-3px; /* Ajusté */
            right:-3px; /* Ajusté */
            background:var(--danger);
            color:white;
            font-size:0.65rem; /* Légèrement plus grand */
            font-weight:800;
            min-width:20px; /* Légèrement plus grand */
            height:20px; /* Légèrement plus grand */
            border-radius:50%;
            display:none;
            align-items:center;
            justify-content:center;
            border: 2px solid var(--bg); /* Utilise la couleur de fond */
            box-shadow: 0 0 0 2px rgba(15,23,42,0.1); /* Petite ombre pour la profondeur */
        }

        /* =====================================
        DROPDOWN NOTIFICATIONS
        ===================================== */
        .notif-wrapper {
            position: relative;
            display: inline-block;
        }

        .notif-dropdown {
            position: absolute;
            top: 58px; /* Ajusté */
            right: 0;
            width: 350px; /* Légèrement plus large */
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(22px); /* Blur plus intense */
            border: 1px solid rgba(255, 255, 255, 0.15); /* Bordure plus visible */
            border-radius: 28px; /* Plus arrondi */
            box-shadow: 0 25px 50px rgba(0,0,0,0.4); /* Ombre plus prononcée */
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 10000;
        }

        .notif-dropdown.show {
            display: flex;
            animation: fadeInNotif 0.2s ease-out;
        }

        @keyframes fadeInNotif {
            from { opacity: 0; transform: translateY(-15px); } /* Animation légèrement modifiée */
            to { opacity: 1; transform: translateY(0); }
        }

        .notif-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 22px 12px; /* Padding ajusté */
        }

        .notif-header h3 {
            margin: 0;
            color: white;
            font-size: 1.1rem; /* Plus grand */
            font-weight: 800;
        }

        .notif-header .mark-all-read {
            color: var(--accent);
            font-size: 0.8rem; /* Plus grand */
            font-weight: 700;
            cursor: pointer;
            transition: color 0.2s ease;
        }
        .notif-header .mark-all-read:hover {
            color: #4aadde; /* Effet au survol */
        }

        .notif-tabs {
            display: flex;
            gap: 10px; /* Espacement ajusté */
            padding: 0 22px 14px; /* Padding ajusté */
            border-bottom: 1px solid rgba(255, 255, 255, 0.1); /* Bordure plus visible */
        }

        .notif-tab {
            font-size: 0.8rem; /* Plus grand */
            font-weight: 700; /* Moins gras */
            color: var(--muted);
            cursor: pointer;
            padding: 6px 14px; /* Padding ajusté */
            border-radius: 999px;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .notif-tab.active {
            background: rgba(255, 255, 255, 0.18); /* Plus opaque */
            color: white;
            font-weight: 800; /* Plus gras pour l'actif */
        }
        .notif-tab:hover:not(.active) {
            background: rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.9);
        }

        .notif-list {
            max-height: 360px; /* Légèrement plus grand */
            overflow-y: auto;
            -webkit-overflow-scrolling: touch; /* Améliore le défilement sur mobile */
        }

        .notif-list::-webkit-scrollbar { /* Style pour la scrollbar */
            width: 8px;
        }
        .notif-list::-webkit-scrollbar-thumb {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }
        .notif-list::-webkit-scrollbar-track {
            background-color: rgba(0, 0, 0, 0.1);
        }

        .notif-item {
            display: flex;
            align-items: center;
            gap: 16px; /* Espacement plus grand */
            padding: 16px 22px; /* Padding ajusté */
            border-bottom: 1px solid rgba(255, 255, 255, 0.06); /* Bordure plus subtile */
            cursor: pointer;
            transition: background 0.2s ease;
            text-decoration: none;
            position: relative;
        }

        .notif-item:hover {
            background: rgba(255, 255, 255, 0.08); /* Effet au survol plus prononcé */
        }

        .notif-item.unread::after {
            content: '';
            position: absolute;
            right: 22px; /* Ajusté */
            width: 9px; /* Légèrement plus grand */
            height: 9px; /* Légèrement plus grand */
            background: #3b82f6;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.2); /* Bordure subtile */
        }

        .notif-item-icon {
            width: 46px; /* Légèrement plus grand */
            height: 46px; /* Légèrement plus grand */
            border-radius: 16px; /* Plus carré mais arrondi */
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notif-item-icon.article { background: rgba(59, 130, 246, 0.2); color: #3b82f6; } /* Plus opaque */
        .notif-item-icon.badge { background: rgba(245, 158, 11, 0.2); color: #f59e0b; } /* Plus opaque */
        .notif-item-icon.chat { background: rgba(34, 197, 94, 0.2); color: #22c55e; } /* Plus opaque */

        .notif-details {
            display: flex;
            flex-direction: column;
            gap: 3px; /* Espacement ajusté */
            padding-right: 15px;
        }

        .notif-message {
            color: rgba(255, 255, 255, 0.95); /* Plus opaque */
            font-size: 0.85rem; /* Plus grand */
            line-height: 1.4;
            font-weight: 500;
        }

        .notif-message strong {
            color: white;
            font-weight: 700;
        }

        .notif-time {
            color: rgba(255, 255, 255, 0.6); /* Plus doux */
            font-size: 0.75rem; /* Plus grand */
            font-weight: 600;
        }

        .pulse-animation {
            animation: pulseNotif 0.6s ease-in-out 2; /* Animation plus longue */
        }

        @keyframes pulseNotif {
            0% { transform: scale(1); box-shadow: 0 0 0 rgba(239, 68, 68, 0); } /* Effet d'ombre doux */
            50% { transform: scale(1.15); box-shadow: 0 0 15px rgba(239, 68, 68, 0.6); } /* Effet d'ombre plus prononcé */
            100% { transform: scale(1); box-shadow: 0 0 0 rgba(239, 68, 68, 0); }
        }

        /* =========================
           SEARCH & INTERFACE BIBLE
        ========================= */
        .search-container{
            padding: 0 20px; /* Padding ajusté */
            margin: 25px 0 15px; /* Marge ajustée */
            position: relative;
            z-index: 10;
        }

        .search-box{
            background:var(--surface);
            border-radius:28px; /* Plus arrondi */
            padding:15px 20px; /* Padding ajusté */
            display:flex;
            align-items:center;
            gap:14px; /* Espacement plus grand */
            box-shadow:var(--shadow);
            border:1px solid transparent; /* Ajout d'une bordure transparente */
            transition:border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .search-box:focus-within { /* Effet au focus */
            border-color: #4aadde;
            box-shadow: 0 0 0 3px rgba(22,163,74,0.1);
        }

        .search-box i{
            color:#4aadde;
            width:20px; /* Plus grand */
            height:20px; /* Plus grand */
            flex-shrink: 0;
        }

        .search-bar{
            flex:1;
            border:none;
            outline:none;
            background:none;
            font-family:inherit;
            font-size:0.95rem; /* Plus grand */
            color:var(--text-main);
            padding:0; /* Supprime le padding par défaut */
        }
        .search-bar::placeholder {
            color: var(--text-muted);
            opacity: 0.8;
        }

        .search-highlight {
            background: rgba(245,158,11,0.35);
            color: var(--text-main);
            border-radius: 4px;
            padding: 0 2px;
            font-weight: 800;
        }

        .empty-search-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.95rem;
        }

        .guest-banner {
            margin: 0 20px 15px;
            background: linear-gradient(135deg, var(--accent), var(--pink));
            border-radius: 20px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            box-shadow: 0 12px 30px rgba(236,72,153,0.3);
        }
        .guest-banner-icon {
            font-size: 1.1rem;
            flex-shrink: 0;
        }
        .guest-banner-text {
            flex: 1;
            font-size: 0.82rem;
            font-weight: 700;
            line-height: 1.4;
        }
        .guest-banner-btn {
            flex-shrink: 0;
            background: white;
            color: #4aadde;
            text-decoration: none;
            font-weight: 900;
            font-size: 0.78rem;
            padding: 9px 14px;
            border-radius: 12px;
            white-space: nowrap;
        }

        .lang-zone{
            padding:0 20px 12px; /* Réduit : plus de gros bloc vertical dédié */
        }

        .lang-zone-inline{
            display:flex;
            align-items:center;
            gap:10px;
            justify-content:space-between;
        }

        .lang-zone-icon{
            font-size:1rem;
            flex-shrink:0;
        }

        .font-size-control{
            display:flex;
            gap:6px;
            flex-shrink:0;
        }
        .font-size-control button{
            border:none;
            background:var(--surface);
            color:var(--text-muted);
            font-weight:900;
            font-size:0.78rem;
            padding:7px 11px;
            border-radius:100px;
            box-shadow:var(--shadow);
            cursor:pointer;
        }
        .font-size-control button:hover{
            background:var(--bg);
            color:var(--text-main);
        }

        .section-title{
            font-size:1.05rem; /* Légèrement plus grand */
            font-weight:900;
            color:#4aadde;
            margin-bottom:18px; /* Marge ajustée */
            letter-spacing:0.5px;
        }

        .menu{
            display:flex;
            gap:8px; /* Espacement resserré pour la version compacte */
            overflow-x:auto;
            scrollbar-width:none;
            padding-bottom:2px;
        }
        .menu::-webkit-scrollbar {
            display: none; /* Cache la scrollbar */
        }

        .menu button{
            border:none;
            padding:7px 14px; /* Plus compact qu'avant */
            border-radius:100px;
            background:var(--surface);
            color:var(--text-muted);
            font-weight:700; /* Moins gras par défaut */
            font-family:inherit;
            cursor:pointer;
            white-space:nowrap;
            box-shadow:var(--shadow);
            transition:0.3s ease; /* Transition plus douce */
            font-size:0.78rem;
        }
        .menu button:hover:not(.active) {
            background:var(--bg); /* Effet au survol */
            color:var(--text-main);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .menu button.active{
            background:#4aadde;
            color:white;
            box-shadow:0 8px 20px rgba(22,163,74,0.25); /* Ombre plus prononcée pour l'actif */
            transform: translateY(-1px);
        }

        .title-divider{
            margin:35px 20px 15px; /* Marge ajustée */
            font-size:0.8rem; /* Légèrement plus grand */
            font-weight:900;
            color:red;
            text-transform:uppercase;
            letter-spacing:1.2px; /* Espacement de lettre plus prononcé */
        }

        .book{
            margin:16px 20px; /* Marge ajustée */
            background:var(--card-gradient);
            border-radius:32px; /* Plus arrondi */
            overflow:hidden;
            box-shadow:var(--shadow-big); /* Ombre plus prononcée par défaut */
            border:1px solid rgba(255,255,255,0.85); /* Bordure plus subtile */
            backdrop-filter:blur(12px); /* Blur plus intense */
            transition:transform 0.3s ease, box-shadow 0.3s ease; /* Transitions plus douces */
        }

        .book:hover{
            transform:translateY(-5px); /* Effet de soulèvement plus prononcé */
            box-shadow:var(--shadow-big); /* Maintient l'ombre existante ou l'améliore */
        }

        .book-header{
            padding:24px; /* Padding ajusté */
            display:flex;
            justify-content:space-between;
            align-items:center;
            cursor:pointer;
            transition:background 0.2s ease;
        }
        .book-header:hover {
            background:rgba(0,0,0,0.02); /* Très léger fond au survol de l'en-tête */
        }


        .book-left{
            display:flex;
            align-items:center;
            gap:16px; /* Espacement plus grand */
        }

        .book-icon{
            width:52px; /* Légèrement plus grand */
            height:52px; /* Légèrement plus grand */
            border-radius:20px; /* Plus arrondi */
            background:#4aadde; /* Utilise les variables CSS */
            display:flex;
            align-items:center;
            justify-content:center;
            color:white;
            box-shadow:0 8px 18px rgba(22,163,74,0.25); /* Ombre cohérente */
        }

        .book-icon i{
            width:24px; /* Plus grand */
            height:24px; /* Plus grand */
        }

        .book-name{
            font-weight:800;
            font-size:1.05rem; /* Légèrement plus grand */
        }

        .book-mini{
            color:var(--text-muted);
            font-size:0.8rem; /* Plus grand */
            margin-top:5px; /* Marge ajustée */
            font-weight:600;
        }

        .book-content{
            max-height:0;
            overflow:hidden;
            transition:max-height 0.5s ease-out, padding 0.5s ease-out; /* Transition pour le padding aussi */
        }

