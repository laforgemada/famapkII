<script type="module">
import { fullBibleContent } from './data/bible_content.js';

const API_BASE_URL = 'https://apokalypsy.com'; // Garde cette URL si elle est utilisée pour d'autres appels API (notifications, points, chat AI)

// Enveloppe sécurisée : si le CDN feather-icons échoue à charger (réseau lent/bloqué),
// on évite qu'une ReferenceError ne casse tout le reste du script.
function safeFeatherReplace() {
    if (typeof feather !== 'undefined' && feather.replace) {
        try {
            feather.replace();
        } catch (e) {
            console.warn('feather.replace a échoué :', e);
        }
    }
}

// Réglage de la taille du texte des versets (accessibilité / confort de lecture),
// avec préférence sauvegardée pour les prochaines visites.
const VERSE_FONT_SIZES = [0.8, 0.87, 0.95, 1.05, 1.15, 1.25, 1.35]; // en rem

function applyVerseFontSize(sizeRem) {
    document.documentElement.style.setProperty('--verse-font-size', `${sizeRem}rem`);
    localStorage.setItem('verseFontSize', String(sizeRem));
}

window.adjustVerseFontSize = function(direction) {
    const current = parseFloat(localStorage.getItem('verseFontSize')) || 0.95;
    let index = VERSE_FONT_SIZES.indexOf(current);
    if (index === -1) index = VERSE_FONT_SIZES.indexOf(0.95);

    const newIndex = Math.min(Math.max(index + direction, 0), VERSE_FONT_SIZES.length - 1);
    applyVerseFontSize(VERSE_FONT_SIZES[newIndex]);

    if (newIndex === index) {
        showToast(direction < 0 ? "Taille minimale atteinte." : "Taille maximale atteinte.", "error");
    }
}



/**
 * ==========================================
 * MODE SOMBRE
 * ==========================================
 */
window.toggleTheme = function() {
    const html = document.documentElement;
    const current = html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
}

let currentUsername = null;
let bibleReads = [];
let sessionVersesToValidate = []; // Renommage de pendingBibleReads
if (typeof notificationCount === 'undefined') { var notificationCount = 0; }
if (typeof loadedNotificationsArray === 'undefined') { var loadedNotificationsArray = []; }

/* DATA BIBLE */
// ==========================================
// CONTENU BIBLIQUE COMPLET — chargé localement depuis data/bible_content.js
// La structure `data` garde la même forme qu'avant pour ne pas casser le reste du code.
const data = fullBibleContent; // Chargement direct des données de la Bible


let lang = "mg";
let currentBookIdx = null;
let currentChapterNum = null;
let startRange = null;
let endRange = null;
let activeFilters = {};
// Nombre de versets actuellement affichés par chapitre ouvert (clé identique
// à activeFilters : "${bookIndex}_${chapterNum}"). Par défaut on n'affiche
// que les 5 premiers versets, le reste se charge au défilement.
let visibleVerseCounts = {};
const VERSES_PER_PAGE = 5;

// Un seul observateur réutilisé à chaque rendu : quand la "sentinelle" en
// bas de la liste de versets devient visible à l'écran, on révèle 5
// versets de plus et on relance le rendu.
const verseLoadObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            const key = entry.target.dataset.verseKey;
            visibleVerseCounts[key] = (visibleVerseCounts[key] || VERSES_PER_PAGE) + VERSES_PER_PAGE;
            render();
        }
    });
}, { rootMargin: '200px' }); // Se déclenche un peu avant d'atteindre le bas, pour un défilement fluide

// Support clavier standard : Échap ferme la modale/le menu actuellement ouvert,
// dans l'ordre de priorité le plus "local" au plus "global".
document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;

    const selectorOverlay = document.getElementById('selectorOverlay');
    const chatOverlay = document.getElementById('chat-overlay');
    const notifDropdown = document.getElementById('notifDropdown');
    const historySidebar = document.getElementById('chat-history-sidebar');

    if (selectorOverlay && selectorOverlay.style.display === 'flex') {
        closeSelector();
    } else if (historySidebar && historySidebar.classList.contains('active')) {
        historySidebar.classList.remove('active');
    } else if (chatOverlay && chatOverlay.style.display === 'flex') {
        closeChat();
    } else if (notifDropdown && notifDropdown.classList.contains('show')) {
        notifDropdown.classList.remove('show');
    }
});

document.addEventListener("DOMContentLoaded", () => {
    safeFeatherReplace();

    const savedFontSize = parseFloat(localStorage.getItem('verseFontSize'));
    if (!isNaN(savedFontSize)) {
        applyVerseFontSize(savedFontSize);
    }

    currentUsername = localStorage.getItem('user_name');

    const validateBtn = document.getElementById('validateReadBtn');

    // Initialisation et mise à jour de l'affichage du bouton de validation
    updateValidateButtonDisplay();

    // Gestion du clic pour les versets déjà marqués dans une session précédente
    // (avec expiration : au-delà de 48h, on efface pour éviter les sélections "fantômes")
    const VERSE_SELECTION_MAX_AGE_MS = 48 * 60 * 60 * 1000;
    const rawSaved = JSON.parse(localStorage.getItem('sessionVersesToValidate') || 'null');
    let savedSessionVerses = [];

    if (rawSaved) {
        if (Array.isArray(rawSaved)) {
            // Ancien format (sans timestamp) : on le garde une dernière fois puis on migrera au prochain enregistrement
            savedSessionVerses = rawSaved;
        } else if (rawSaved.reads && Date.now() - rawSaved.savedAt <= VERSE_SELECTION_MAX_AGE_MS) {
            savedSessionVerses = rawSaved.reads;
        } else if (rawSaved.reads) {
            localStorage.removeItem('sessionVersesToValidate');
            showToast("Vos anciennes sélections de lecture ont expiré et ont été effacées.", "error");
        }
    }

    sessionVersesToValidate = savedSessionVerses.map(item => ({
        book: item.book,
        chapter: item.chapter,
        verses: item.verses
    }));
    updateValidateButtonDisplay();

    const userSub = document.getElementById('bible-user-sub');

    if (userSub) {
        userSub.innerText = currentUsername
            ? `Membre : ${currentUsername}`
            : 'Visiteur';
    }

    const guestBanner = document.getElementById('guest-banner');
    if (guestBanner) {
        guestBanner.style.display = currentUsername ? 'none' : 'flex';
    }

    if (currentUsername) {
        initRealtimeNotifications();
        maybeShowVerseTapHint();
        initPointsBadge();
    }

    render();
    initChat(); // Initialiser le chat au chargement de la page
    renderBibleAuthButtons(); // Initialiser les boutons d'authentification
});

/**
 * Gère l'affichage dynamique des boutons de connexion/déconnexion
 * dans l'en-tête de bible.html.
 */
function renderBibleAuthButtons() {
    const authZone = document.getElementById('bible-auth-zone');
    if (!authZone) return;

    if (currentUsername) {
        // Utilisateur connecté : afficher le bouton de déconnexion
        authZone.innerHTML = `
            <button class="nav-btn" onclick="logout()" aria-label="Se déconnecter">
                <i data-feather="log-out"></i>
            </button>
        `;
    } else {
        // Utilisateur non connecté : afficher un bouton de connexion
        authZone.innerHTML = `
            <a title="Se connecter" href="../famapkII/login/connexion.html" class="nav-btn" aria-label="Se connecter">
                <i data-feather="log-in"></i>
            </a>
        `;
    }
    safeFeatherReplace(); // Assurez-vous que les icônes feather sont rendues
}

// Badge de points dans le header : donne un retour immédiat sur la progression,
// sans avoir à aller sur la page de profil.
// NB : l'endpoint /api/points/summary est une supposition raisonnable — à adapter
// si votre API expose les points totaux d'un utilisateur sous un autre chemin.
function setPointsBadgeValue(points) {
    const badge = document.getElementById('points-badge');
    const value = document.getElementById('points-badge-value');
    if (!badge || !value) return;
    value.innerText = Math.round(points * 10) / 10;
    badge.style.display = 'flex';
    localStorage.setItem('cachedPointsTotal', String(points));
}

async function initPointsBadge() {
    // Affiche d'abord une valeur mise en cache localement (retour instantané),
    // puis tente de la rafraîchir depuis le serveur.
    const cached = parseFloat(localStorage.getItem('cachedPointsTotal'));
    if (!isNaN(cached)) {
        setPointsBadgeValue(cached);
    }

    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`${API_BASE_URL}/api/points/summary?username=${encodeURIComponent(currentUsername)}`, {
            headers: token ? { 'Authorization': `Bearer ${token}` } : {}
        });
        if (!response.ok) return;
        const result = await response.json();
        if (typeof result.total_points === 'number') {
            setPointsBadgeValue(result.total_points);
        }
    } catch (e) {
        console.warn("Impossible de récupérer le total de points (endpoint à vérifier) :", e);
    }
}

// Affiche une seule fois une astuce expliquant que toucher un verset le marque comme lu
function maybeShowVerseTapHint() {
    if (localStorage.getItem('hasSeenVerseTapHint')) return;
    setTimeout(() => {
        showToast("💡 Astuce : touchez un verset pour le marquer comme lu et gagner des points.", "success");
        localStorage.setItem('hasSeenVerseTapHint', '1');
    }, 900);
}

/* ==========================================
 * SYSTEME DE NOTIFICATIONS SSE DYNAMIQUE
 * ========================================== */
function initRealtimeNotifications() {
    // Vérifie si currentUsername est défini avant d'initialiser les notifications
    if (!currentUsername) {
        console.log("Nom d'utilisateur non défini, notifications en temps réel non initialisées.");
        return;
    }

    const baseUrl = API_BASE_URL;
    const eventSource = new EventSource(`${baseUrl}/api/notifications/stream?username=${encodeURIComponent(currentUsername)}`);

    eventSource.onmessage = function(event) {
        if (!event.data || event.data.trim() === "" || event.data.includes("ping")) return; 

        try {
            const data = JSON.parse(event.data);
            if (!data || !data.message) return;

            const dejavu = loadedNotificationsArray.some(n => n.realId === data.id);
            if (dejavu) return; 

            let iconType = 'article'; 
            let iconName = 'book-open';
            let directLink = '../';

            if (data.type === 'new_badge' || data.message.includes('badge') || data.message.includes('Trophée')) {
                iconType = 'badge'; iconName = 'award'; directLink = '#';
            } else if (data.type === 'chat' || data.message.includes('Chat') || data.message.includes('message')) {
                iconType = 'chat'; iconName = 'message-square'; directLink = './chat.html';
            }

            loadedNotificationsArray.unshift({
                id: Date.now(), realId: data.id, type: iconType, icon: iconName,
                message: data.message, time: 'À l\'instant', unread: true, link: directLink
            });

            notificationCount = loadedNotificationsArray.length;
            renderNotificationBadge();
            renderVerticalDropdownMenu();

            if (window.Notification && Notification.permission === "granted") {
                new Notification("Apokalypsy", { body: data.message });
            }
        } catch (e) {
            console.error("Erreur flux SSE:", e);
        }
    };

    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('notifDropdown');
        const trigger = document.getElementById('notif-btn');
        if (dropdown && !dropdown.contains(event.target) && !trigger.contains(event.target)) {
            dropdown.classList.remove('show');
        }
    });
}

window.toggleNotifMenu = function(event) {
    event.stopPropagation();
    const dropdown = document.getElementById('notifDropdown');
    if (dropdown) dropdown.classList.toggle('show');
}

function renderNotificationBadge() {
    const badge = document.getElementById('notif-badge');
    if (!badge) return;
    if (notificationCount > 0) {
        badge.innerText = notificationCount;
        badge.style.display = 'flex';
        badge.classList.add('pulse-animation');
        setTimeout(() => badge.classList.remove('pulse-animation'), 500);
    } else {
        badge.style.display = 'none';
    }
}

function renderVerticalDropdownMenu() {
    const container = document.getElementById('notifVerticalList');
    if (!container) return;
    if (loadedNotificationsArray.length === 0) {
        container.innerHTML = `<div style="padding:24px; text-align:center; color:var(--muted); font-size:0.82rem;">Aucune notification.</div>`;
        return;
    }
    container.innerHTML = loadedNotificationsArray.map(notif => `
        <a href="${notif.link}" class="notif-item ${notif.unread ? 'unread' : ''}" onclick="handleNotifClick(event, ${notif.id}, '${notif.type}')">
            <div class="notif-item-icon ${notif.type}">
                <i data-feather="${notif.icon}"></i>
            </div>
            <div class="notif-details">
                <span class="notif-message">${notif.message}</span>
                <span class="notif-time">${notif.time}</span>
            </div>
        </a>
    `).join('');
    safeFeatherReplace();
}

// Les notifications de "chat" doivent ouvrir le même overlay de chat que le reste
// du site (voir l'unification faite plus tôt), pas naviguer vers une page à part.
window.handleNotifClick = function(event, id, type) {
    markOneAsRead(id);
    if (type === 'chat') {
        event.preventDefault();
        document.getElementById('notifDropdown').classList.remove('show');
        openChat();
    }
}

function markOneAsRead(id) {
    const notif = loadedNotificationsArray.find(n => n.id === id);
    if (notif && notif.unread) {
        notif.unread = false;
        if (notificationCount > 0) notificationCount--;
        renderNotificationBadge();
        renderVerticalDropdownMenu();
    }
}

window.markAllAsRead = function(event) {
    event.stopPropagation();
    loadedNotificationsArray.forEach(n => n.unread = false);
    notificationCount = 0;
    renderNotificationBadge();
    renderVerticalDropdownMenu();
}

